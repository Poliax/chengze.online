  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Helvetica Neue',Arial,sans-serif; background:#f8f9ff; color:var(--ink); }
  a { text-decoration:none; color:inherit; }
  .container { max-width:1180px; margin:0 auto; padding:0 28px; }
  .topbar { background:#23272B; color:rgba(255,255,255,.78); font-size:13px; border-bottom:1px solid rgba(255,255,255,.08); }
