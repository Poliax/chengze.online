  .brand { display:flex; align-items:center; gap:10px; }
  .brand svg { width:28px; height:28px; }
  .brand-name { font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; font-size:22px; font-weight:400; line-height:1; letter-spacing:.5px; color:#fff; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; }
  .brand-name em { font-style:normal; font-weight:400; background:linear-gradient(90deg,var(--indigo),var(--purple)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }
  .main-nav { display:flex; align-items:center; gap:30px; }
  .main-nav a { font-size:14px; color:rgba(255,255,255,.78); font-weight:600; }
  .main-nav a:hover, .main-nav a.active { color:#fff; }
  .btn { display:inline-flex; align-items:center; justify-content:center; border-radius:999px; font-weight:700; }
  .btn-primary { background:linear-gradient(90deg,var(--indigo),var(--purple)); color:#fff; }
  .btn-sm { padding:9px 20px; font-size:13px; }
  .page-hero { background:linear-gradient(120deg,#eef2ff,#f5f3ff 55%,#faf5ff); padding:72px 0; }
  .page-hero h1 { font-size:38px; font-weight:800; }
  .page-hero p { margin-top:14px; color:var(--muted); font-size:15px; line-height:1.8; max-width:640px; }
  .crumbs { font-size:13px; color:var(--muted); margin-bottom:18px; }
  .section { padding:72px 0; }
  .section-head { max-width:680px; margin-bottom:42px; }
  .kicker { font-size:12px; letter-spacing:3px; color:var(--violet); text-transform:uppercase; font-weight:700; }
  .section-head h2 { font-size:28px; font-weight:800; margin-top:10px; }
  .about-grid { display:grid; grid-template-columns:1fr 1fr; gap:36px; }
  .about-grid p { color:var(--muted); line-height:1.9; font-size:14px; margin-bottom:14px; }
  .values { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:50px; }
  .value { background:#fff; border:1px solid var(--line); border-radius:var(--radius); padding:24px; }
  .value h3 { font-size:17px; margin-bottom:8px; }
  .value p { font-size:13px; color:var(--muted); line-height:1.8; }
  footer { background:#111827; color:rgba(255,255,255,.55); }
  .footer-grid { display:grid; grid-template-columns:1.6fr 1fr 1fr 1.2fr; gap:32px; padding:52px 0 40px; }
  footer h4 { color:#fff; font-size:14px; margin-bottom:14px; }
  footer ul { list-style:none; } footer li { margin-bottom:8px; font-size:13px; } footer a:hover { color:#fff; }
  .contact-line { font-size:13px; margin-bottom:8px; }
  .footer-bottom { border-top:1px solid rgba(255,255,255,.1); padding:18px 0; font-size:12px; display:flex; justify-content:space-between; flex-wrap:wrap; gap:8px; }
  @media (max-width:960px) { .about-grid { grid-template-columns:1fr; } .values { grid-template-columns:1fr; } .footer-grid { grid-template-columns:1fr 1fr; } }
  @media (max-width:640px) { .topbar-inner { flex-direction:column; height:auto; padding:8px 0; gap:4px; text-align:center; } .nav-inner { flex-direction:column; height:auto; padding:14px 0; gap:12px; } .main-nav { flex-wrap:wrap; gap:16px; } .page-hero h1 { font-size:28px; } .footer-grid { grid-template-columns:1fr; } }
</style>
