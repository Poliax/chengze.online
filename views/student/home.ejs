  .live-banner-inline { display:flex; align-items:center; gap:10px; background:#dc2626; color:#fff; border-radius:10px; padding:10px 14px; margin-bottom:14px; font-size:13px; font-weight:600; }
  .course-showcase { background:#ffffff; color:var(--text-1); border-radius:var(--radius-lg); padding:28px 30px; margin-bottom:30px; position:relative; overflow:hidden; box-shadow:0 8px 24px rgba(23,18,25,.06); border:1px solid #e5e7eb; }
