  .teacher-avatar { width:56px; height:56px; border-radius:50%; background:linear-gradient(135deg,#881538,#a3173f); color:#fff; display:flex; align-items:center; justify-content:center; font-size:20px; font-weight:700; overflow:hidden; flex-shrink:0; }
