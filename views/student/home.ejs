  .catalog-layout { display:grid; grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr); gap:16px; align-items:start; }
  .course-calendar { background:#fff; border:1px solid #d7deea; border-radius:14px; padding:16px; position:sticky; top:82px; min-width:0; max-width:100%; overflow:hidden; box-shadow:0 8px 24px rgba(23,18,25,.08); }
