  .policy-list { padding-left:18px; margin:0; }
  .policy-list li { font-size:13px; color:var(--text-2); line-height:1.8; margin-bottom:6px; }
  .detail-table-wrap { background:#fff; border:1px solid #E5E7EB; border-radius:12px; overflow:auto; max-height:640px; box-shadow:0 4px 16px rgba(23,18,25,.05); }
  .catalog-count { font-size:12px; color:var(--text-3); margin-bottom:10px; }
