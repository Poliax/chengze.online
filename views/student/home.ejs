<script>
  var VIEW_TITLES = {
    home: ['首页', '专升本在线教育平台'],
    overview: ['学习总览', '学习进度 · 我的课程 · 待上课'],
    courses: ['课程中心', '专升本备考 · 直播 + 回放'],
    practice: ['刷题模考', '题库刷题 · 模拟考试'],
    ai: ['在线答疑', '助教 + AI 智能答疑'],
    community: ['备考社区', '学习交流 · 上岸分享'],
    news: ['考情资讯', '各省政策 · 报名 · 考试 · 查分'],
    children: ['系统课列表', 'Course Packages'],
    rank: ['排行榜', '学习打卡 · 积分排名']
  };
  var _currentView = 'home';
  var _prevView = 'home';
  var _childrenByParent = <%- JSON.stringify(childrenByParent || {}) %>;
  var _coursesByParent = <%- JSON.stringify(coursesByParent || {}) %>;
  var _coursesByPackage = <%- JSON.stringify(coursesByPackage || {}) %>;
  var _packageDetails = <%- JSON.stringify(packageDetails || {}) %>;
  var _courseDetails = <%- JSON.stringify(courseDetails || {}) %>;
  var PACKAGE_ID = 0;
  var CURRENT_ORDER_ID = 0;
  var _lastParentTitle = '';
  var _calRows = [];
  var _calYear = 0;
  var _calMonth = 0;
  var _catalogRows = [];
  var _catalogPage = 1;
  var _catalogPageSize = 20;
  var _catalogFilterCid = 0;
  var _catalogPkg = null;
  function switchView(view) {
    if (_currentView) _prevView = _currentView;
    _currentView = view;
    document.querySelectorAll('.view').forEach(function(v) { v.classList.remove('active'); });
    var el = document.getElementById('view' + view.charAt(0).toUpperCase() + view.slice(1));
    if (el) el.classList.add('active');
    document.querySelectorAll('.menu-item[data-view]').forEach(function(m) {
      m.classList.toggle('on', m.getAttribute('data-view') === view);
    });
    var t = VIEW_TITLES[view] || VIEW_TITLES.home;
    var pt = document.getElementById('pageTitle');
    var ps = document.getElementById('pageSub');
    if (pt) pt.textContent = t[0];
    if (ps) ps.textContent = t[1];
  }
  function goCourseCenter() {
    if (window.backToPackages) backToPackages();
    switchView('courses');
  }
  function ensureCoursesView() {
    var cv = document.getElementById('viewCourses');
    if (cv && cv.className.indexOf('active') < 0) switchView('courses');
  }
  function showDrillUI(title) {
    var label = document.getElementById('childPkgLabel');
    var back = document.getElementById('childBackBtn');
    var main = document.getElementById('mainPkgGrid');
    var grid = document.getElementById('childrenGrid');
    if (label) label.textContent = title || '';
    if (label) label.style.display = '';
    if (back) back.style.display = '';
    if (main) main.style.display = 'none';
    if (grid) grid.style.display = '';
  }
  function showChildren(id) {
    var list = _childrenByParent[id] || [];
    var p = null;
    document.querySelectorAll('.pkg-card[data-id="' + id + '"]').forEach(function(el) { if (!p) p = el; });
    var grid = document.getElementById('childrenGrid');
    grid.innerHTML = '';
    var backBtn = document.getElementById('childBackBtn');
    if (backBtn) backBtn.onclick = backToPackages;
    if (!list.length) { grid.innerHTML = '<div class="empty">暂无二级课程包</div>'; }
    list.forEach(function(c) {
      var card = document.createElement('a');
      card.href = 'javascript:void(0)';
      card.className = 'pkg-card';
      card.onclick = (function(id){ return function(){ showPackageDetail(id); }; })(c.id);
      card.setAttribute('data-province', c.province || '');
      card.setAttribute('data-title', c.title || '');
      card.setAttribute('data-year', c.year || '');
      card.setAttribute('data-type', typeLabel(c.class_type));
      var _tagLabel = typeLabel(c.class_type);
      var parentTitle = (_packageDetails[c.id] && _packageDetails[c.id].parent_title) || '';
      var tags = parentTitle ? '<span>' + escHtml(parentTitle) + '</span>' : [c.province || '全国', (c.year || '') + '年', c.exam_type || '专升本'].map(function(t) { return '<span>' + t + '</span>'; }).join('');
      var orig = c.price;
      var sale = c.sale_price;
      var priceHtml = orig ? '<span class="now" style="text-decoration:line-through">¥' + Number(orig).toFixed(2) + '</span>' + (sale && Number(sale) < Number(orig) ? ' <span class="old">¥' + Number(sale).toFixed(2) + '</span>' : '') : (sale ? '¥' + Number(sale).toFixed(2) : '<span class="none">价格面议</span>');
      var teacherNames = (c.teachers && c.teachers.length) ? c.teachers : (c.teacher_name ? [c.teacher_name] : []);
      var teacherHtml = teacherNames.length ? '<div class="pkg-teacher">' + teacherNames.map(function(n, i){ var av = (c.teacher_avatars && c.teacher_avatars[i]) ? '<img src="' + c.teacher_avatars[i] + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">' : n.charAt(0); return '<span class="pkg-teacher-item"><span class="pkg-teacher-avatar">' + av + '</span><span>' + n + '</span></span>'; }).join('') + '</div>' : '';
      var dp = _packageDetails[c.id] || {};
      var dh = calcHours(dp.scheduleRows || []);
      var startInfo = '<div class="pkg-start"><b>课时：</b>' + dh + '+' + '</div><div class="pkg-start"><b>开课：</b>' + escHtml(dp.start_date || '待定') + (dp.end_date ? ' ~ ' + escHtml(dp.end_date) : '') + '</div>';
      card.innerHTML = '<div class="pkg-top"><div class="pkg-tags">' + tags + '</div><h3>' + escHtml(c.title || '') + '</h3></div><div class="pkg-body">' + startInfo + teacherHtml + '</div><div class="pkg-foot"><span class="go pkg-price">' + priceHtml + '</span><span>' + (c.display_student_count || 0) + ' 人报名</span></div>';
      grid.appendChild(card);
    });
    showDrillUI(p ? p.getAttribute('data-title') : '系统课列表');
    ensureCoursesView();
    if (window.applyGlobalFilter) window.applyGlobalFilter();
  }
  function escHtml(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function typeLabel(t){
    if (t === '公开课' || t === '免费课' || t === '公共课') return '公开课';
    if (['专项提升','专项提升课','专项集训','专项集训课','冲刺密训','押题密训课'].includes(t)) return '专项提升';
    return '系统学习';
  }
  function backToChildren(){
    var dv = document.getElementById('packageDetailView');
    var cdv = document.getElementById('courseDetailView');
    var grid = document.getElementById('childrenGrid');
    var backBtn = document.getElementById('childBackBtn');
    if (dv) dv.style.display = 'none';
    if (cdv) cdv.style.display = 'none';
    if (grid) grid.style.display = '';
    if (backBtn) backBtn.onclick = backToPackages;
    ensureCoursesView();
    if (window.applyGlobalFilter) window.applyGlobalFilter();
  }
  function backToPackageDetail(){
    var cd = document.getElementById('courseDetailView');
    var pd = document.getElementById('packageDetailView');
    var backBtn = document.getElementById('childBackBtn');
    var label = document.getElementById('childPkgLabel');
    if (cd) cd.style.display = 'none';
    if (pd) pd.style.display = '';
    if (backBtn) backBtn.onclick = backToChildren;
    if (label) label.textContent = _lastParentTitle || '';
    ensureCoursesView();
  }
  function tagsHtml(d){
    var t = typeLabel(d.class_type);
    return '<div class="detail-tags"><span>' + escHtml(d.province || '全国') + '</span><span>' + escHtml(d.year || '') + '年</span><span>' + escHtml(t) + '</span></div>';
  }
  function courseInfoHtml(cid){
    var d = _courseDetails[cid];
    if (!d) return '';
    var typeText = typeLabel(d.class_type);
    var priceText = d.price ? '¥' + Number(d.price).toFixed(2) + (d.sale_price && Number(d.sale_price) < Number(d.price) ? '（优惠 ¥' + Number(d.sale_price).toFixed(2) + '）' : '') : (d.sale_price ? '¥' + Number(d.sale_price).toFixed(2) : '-');
    var gridHtml = '<div class="detail-grid"><div class="detail-item"><span class="dl">招考省份</span><span class="dv">' + escHtml(d.province || '-') + '</span></div><div class="detail-item"><span class="dl">考试年份</span><span class="dv">' + escHtml(d.year || '-') + '</span></div><div class="detail-item"><span class="dl">课程类型</span><span class="dv">' + escHtml(typeText) + '</span></div><div class="detail-item"><span class="dl">授课教师</span><span class="dv">' + escHtml(d.teacher_name || '-') + '</span></div><div class="detail-item"><span class="dl">课时</span><span class="dv">' + calcHours(d.lessons) + '</span></div><div class="detail-item"><span class="dl">课程定价</span><span class="dv">' + escHtml(priceText) + '</span></div></div>';
    var materialsHtml = '';
    if (d.materials && d.materials.length) {
      materialsHtml = '<div class="detail-section"><h3>课程资料</h3>' + d.materials.map(function(m){
        return '<a class="res-file" style="text-decoration:none;color:inherit" href="' + m.url + '" target="_blank"><span class="icon">PDF</span><span class="info"><strong>' + escHtml(m.original_name) + '</strong><span>点击下载</span></span></a>';
      }).join('') + '</div>';
    }
    var policyHtml = '<div class="detail-section"><h3>退费规则</h3><ul class="policy-list"><li>订单支付成功后，如课程尚未开始且未产生学习记录，可在规定期限内申请退款，具体以订单页提示为准。</li><li>课程已经开课或已产生学习/回放记录的，原则上不予退款；如因平台原因无法正常提供服务，可协商处理。</li><li>申请退款请联系客服并提供订单号，审核通过后按原支付渠道退回。</li></ul><a href="/live/student/policy" target="_blank" rel="noopener" style="font-size:12px;color:#1c1917;font-weight:600">查看完整协议 →</a></div>';
    return '<div class="detail-section"><h3>课程内容</h3><p class="desc">' + escHtml(d.description || '课程详细内容持续更新中') + '</p></div>' + gridHtml + materialsHtml + policyHtml;
  }
  function packageSideHtml(d){
    var orig = d.price;
    var sale = d.sale_price;
    var priceHtml = orig ? '<span style="text-decoration:line-through">¥' + Number(orig).toFixed(2) + '</span>' + (sale && Number(sale) < Number(orig) ? '<span class="old" style="font-size:14px;color:#dc2626">¥' + Number(sale).toFixed(2) + '</span>' : '') : (sale ? '¥' + Number(sale).toFixed(2) : '价格面议');
    return '<aside class="detail-side"><div class="price">' + priceHtml + '</div><div class="students">' + (d.display_student_count || 0) + ' 人报名</div><div class="detail-btns"><button type="button" class="buy-btn" onclick="startBuy()">立即购买</button></div><label class="agree"><input type="checkbox" id="agreeTerms" style="margin-right:4px">我已阅读并同意<a href="/live/student/policy" target="_blank" rel="noopener" style="color:#1c1917">《用户协议》《隐私政策》《退款说明》</a></label></aside>';
  }
  function calendarHtml(){
    var year = _calYear;
    var month = _calMonth;
    var startDow = (new Date(year, month, 1).getDay() + 6) % 7;
    var daysInMonth = new Date(year, month + 1, 0).getDate();
    var byDay = {};
    (_calRows || []).forEach(function(l){
      if (!l.schedule_time) return;
      var d = new Date(String(l.schedule_time).replace(' ', 'T'));
      if (!isNaN(d.getTime()) && d.getFullYear() === year && d.getMonth() === month) {
        (byDay[d.getDate()] = byDay[d.getDate()] || []).push(l);
      }
    });
    var heads = ['一','二','三','四','五','六','日'].map(function(x){ return '<span class="cal-head">' + x + '</span>'; }).join('');
    var cells = [];
    for (var i = 0; i < startDow; i++) cells.push('<span class="cal-cell empty"></span>');
    for (var day = 1; day <= daysInMonth; day++) {
      var lessons = byDay[day] || [];
      var items = lessons.slice(0, 4).map(function(l){
        var timeText = '';
        var tm = String(l.schedule_time || '').match(/(\d{1,2}:\d{2})/);
        if (tm) timeText = tm[1];
        var stageText = l.stage || '';
        var label = (stageText && String(l.title || '').indexOf(stageText) < 0) ? stageText + ' · ' + l.title : (l.title || '');
        return '<span class="cal-lesson"><i>' + escHtml(l.course_title || '') + '</i><b>' + escHtml(label) + '</b><em>' + escHtml(timeText) + '</em></span>';
      }).join('');
      cells.push('<span class="cal-cell' + (lessons.length ? ' has' : '') + '"><b>' + day + '</b>' + items + '</span>');
    }
    var nav = '<button type="button" class="cal-nav" onclick="calPrev()">‹ 上月</button><span class="cal-title" style="margin:0">' + year + ' 年 ' + (month + 1) + ' 月</span><button type="button" class="cal-nav" onclick="calNext()">下月 ›</button>';
    return '<div class="course-calendar"><div class="cal-head-row">' + nav + '</div><div class="cal-grid-head">' + heads + '</div><div class="cal-grid">' + cells.join('') + '</div></div>';
  }
  function calPrev(){ _calMonth--; if (_calMonth < 0) { _calMonth = 11; _calYear--; } renderCalendarPanel(); }
  function calNext(){ _calMonth++; if (_calMonth > 11) { _calMonth = 0; _calYear++; } renderCalendarPanel(); }
  function renderCalendarPanel(){ var el = document.getElementById('coursePanelCalendar'); if (el) el.innerHTML = calendarHtml(); }
  function initCalendar(rows){
    _calRows = rows || [];
    var now = new Date();
    _calYear = now.getFullYear();
    _calMonth = now.getMonth();
  }
  function buildCatalogTableHtml(p){
    var subjectTabs = '<div class="subject-tabs"><button type="button" class="subject-tab' + (!_catalogFilterCid ? ' active' : '') + '" data-cid="0" onclick="filterSchedule(0)">全部</button>' + (p.courses || []).map(function(c){
      return '<button type="button" class="subject-tab' + (Number(_catalogFilterCid) === Number(c.id) ? ' active' : '') + '" data-cid="' + c.id + '" onclick="filterSchedule(' + c.id + ')">' + escHtml(c.category || c.title) + '</button>';
    }).join('') + '</div>';
    var filtered = _catalogRows.filter(function(r){ return !_catalogFilterCid || Number(r.cid) === Number(_catalogFilterCid); });
    var total = filtered.length;
    var pages = Math.max(1, Math.ceil(total / _catalogPageSize));
    if (_catalogPage > pages) _catalogPage = pages;
    if (_catalogPage < 1) _catalogPage = 1;
    var rows = filtered.slice((_catalogPage - 1) * _catalogPageSize, _catalogPage * _catalogPageSize).map(function(r){ return r.html; }).join('');
    var pager = total > _catalogPageSize ? '<div class="pager"><button onclick="catalogPage(' + (_catalogPage - 1) + ')"' + (_catalogPage <= 1 ? ' disabled' : '') + '>上一页</button><span>' + _catalogPage + ' / ' + pages + '</span><button onclick="catalogPage(' + (_catalogPage + 1) + ')"' + (_catalogPage >= pages ? ' disabled' : '') + '>下一页</button></div>' : '';
    return subjectTabs + '<div class="detail-table-wrap catalog-table-wrap"><table class="detail-table"><thead><tr><th>科目</th><th>课次</th><th>上课时间</th><th>时长</th><th>课件/讲义</th><th>课后练习</th><th>入口</th></tr></thead><tbody>' + rows + '</tbody></table></div>' + pager;
  }
  function catalogPage(n){
    if (!_catalogPkg) return;
    var prevScroll = window.scrollY || 0;
    _catalogPage = n;
    var el = document.getElementById('coursePanelCatalog');
    if (el) el.innerHTML = buildCatalogTableHtml(_catalogPkg);
    window.scrollTo(0, prevScroll);
  }
  function showEmbeddedPackageDetail(pkgId){
    var p = _packageDetails[pkgId];
    if (!p) return;
    var teachersHtml = (p.teachers && p.teachers.length) ? '<div class="teacher-list">' + p.teachers.map(function(n, i){
      var av = (p.teacher_avatars && p.teacher_avatars[i]) ? '<img src="' + p.teacher_avatars[i] + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">' : escHtml(n.charAt(0));
      var bio = (p.teacher_bios && p.teacher_bios[i]) ? p.teacher_bios[i] : '简介待补充';
      return '<div class="teacher-card"><span class="teacher-avatar">' + av + '</span><div class="teacher-info"><div class="teacher-name">' + escHtml(n) + '</div><div class="teacher-bio">' + escHtml(bio) + '</div></div></div>';
    }).join('') + '</div>' : '<div class="empty">暂无教师信息</div>';
    var rowHtmls = [];
    (p.scheduleRows || []).forEach(function(l){
      var time = l.schedule_time ? String(l.schedule_time).replace('T',' ').substring(0,16) : '-';
      var lesson = null;
      var cd = _courseDetails[l.course_id];
      if (cd && cd.lessons) {
        for (var i = 0; i < cd.lessons.length; i++) {
          if (Number(cd.lessons[i].id) === Number(l.id)) { lesson = cd.lessons[i]; break; }
        }
      }
      var isTaught = !!(lesson && (lesson.has_replay || lesson.actual_duration));
      if (lesson && lesson.schedule_time) {
        var st = new Date(String(lesson.schedule_time).replace(' ', 'T'));
        if (!isNaN(st.getTime()) && st.getTime() <= Date.now()) isTaught = true;
      }
      var canWatch = !!(lesson && (lesson.has_replay || (cd && cd.isLive)));
      var duration = lesson ? fmtDuration(lesson.has_replay ? (lesson.actual_duration || lesson.duration) : lesson.duration) : '-';
      var liveNow = !!(lesson && lesson.is_live);
      var btn = liveNow ? '正在直播' : (canWatch ? '开始学习' : '尚未开课');
      var href = canWatch ? lessonWatchUrl(l.course_id, l.id) : '#';
      var btnStyle = liveNow ? ' style="color:#dc2626;font-weight:700"' : (canWatch ? ' style="color:#1c1917;font-weight:600"' : ' style="color:#94a3b8;pointer-events:none"');
      var lessonMat = null;
      if (cd && cd.materials) {
        for (var mi = 0; mi < cd.materials.length; mi++) {
          if (Number(cd.materials[mi].lesson_id) === Number(l.id) || !cd.materials[mi].lesson_id) { lessonMat = cd.materials[mi]; break; }
        }
      }
      var matTd = (isTaught && lessonMat) ? '<td><a href="' + lessonMat.url + '" target="_blank" rel="noopener" style="color:#1c1917;font-weight:600">讲义</a></td>' : '<td style="color:#94a3b8">-</td>';
      var hasPractice = isTaught && (_allQuestions || []).some(function(q){ return Number(q.lesson_id) === Number(l.id); });
      var pracTd = hasPractice ? '<td><a href="javascript:void(0)" onclick="openLessonPractice(' + l.id + ')" style="color:#1c1917;font-weight:600">练习</a></td>' : '<td style="color:#94a3b8">-</td>';
      rowHtmls.push({ cid: l.course_id, html: '<tr data-cid="' + l.course_id + '"><td>' + escHtml(l.course_title || '-') + '</td><td>' + escHtml(l.title || '-') + '</td><td>' + escHtml(time) + '</td><td>' + duration + '</td>' + matTd + pracTd + '<td><a href="' + href + '" target="_blank" rel="noopener"' + btnStyle + '>' + btn + '</a></td></tr>' });
    });
    _catalogRows = rowHtmls;
    _catalogPage = 1;
    _catalogFilterCid = 0;
    _catalogPkg = p;
    var tableWrap = rowHtmls.length ? buildCatalogTableHtml(p) : '<div class="empty">暂无课次</div>';
    var catalogPanel = '<div class="course-panel active" id="coursePanelCatalog">' + tableWrap + '</div>';
    initCalendar(p.scheduleRows || []);
    var calendarPanel = '<div class="course-panel" id="coursePanelCalendar">' + calendarHtml() + '</div>';
    var firstCourseId = p.courses && p.courses.length ? p.courses[0].id : 0;
    var sideHtml = (!p.children || p.children.length === 0) ? packageSideHtml(p) : '';
    var detailPanel = '<div class="course-panel" id="coursePanelDetail">' + (firstCourseId ? courseInfoHtml(firstCourseId) : '<div class="empty">暂无课程信息</div>') + '</div>';
    var teacherPanel = '<div class="course-panel" id="coursePanelTeacher">' + teachersHtml + '</div>';
    var tabsHtml = '<div class="course-tabs"><button type="button" class="course-tab active" data-panel="catalog" onclick="switchCourseTab(\'catalog\',\'embeddedCourseDetail\')">课程目录</button><button type="button" class="course-tab" data-panel="calendar" onclick="switchCourseTab(\'calendar\',\'embeddedCourseDetail\')">课程日历</button><button type="button" class="course-tab" data-panel="detail" onclick="switchCourseTab(\'detail\',\'embeddedCourseDetail\')">课程简介</button><button type="button" class="course-tab" data-panel="teacher" onclick="switchCourseTab(\'teacher\',\'embeddedCourseDetail\')">教师简介</button></div>';
    var totalLessons = calcHours(p.scheduleRows || []);
    if (!totalLessons) (p.courses || []).forEach(function(c){ totalLessons += Number(c.lesson_count) || 0; });
    var metaRow = '<div class="course-meta"><span><b>开课：</b>' + escHtml(p.start_date || '待定') + '</span><span><b>下架时间：</b>' + escHtml(p.valid_until || p.end_date || '待定') + '</span><span><b>总课时：</b>' + totalLessons + '</span></div>';
    var parentHtml = p.parent_title ? '<div class="detail-parent">' + escHtml(p.parent_title) + '</div>' : '';
    document.getElementById('embeddedCourseDetail').innerHTML = '<div class="detail-layout"><div class="detail-main"><div class="detail-hd"><div class="detail-hd-left">' + tagsHtml(p) + parentHtml + '<h1>' + escHtml(p.title) + '</h1>' + metaRow + '</div>' + sideHtml + '</div><div class="course-tabs-divider"></div>' + tabsHtml + '<div class="course-panels">' + teacherPanel + catalogPanel + calendarPanel + detailPanel + '</div></div></div>';
    ensureCoursesView();
  }
  function updateEmbeddedDetail(cid){
    var html = courseInfoHtml(cid);
    var panel = document.getElementById('coursePanelDetail');
    if (panel && html) panel.innerHTML = html;
  }
  function showEmbeddedCourse(id){
    var pkgId = 0;
    for (var k in _packageDetails) {
      var p = _packageDetails[k];
      if (p.courses && p.courses.some(function(c){ return Number(c.id) === Number(id); })) { pkgId = Number(k); break; }
    }
    if (pkgId) showEmbeddedPackageDetail(pkgId);
    ensureCoursesView();
  }
  function switchCourseTab(name, cid){
    var root = document.getElementById(cid || 'courseDetailContent');
    if (!root) return;
    root.querySelectorAll('.course-tab').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-panel') === name);
    });
    root.querySelectorAll('.course-panel').forEach(function(p){
      p.classList.toggle('active', p.id === 'coursePanel' + name.charAt(0).toUpperCase() + name.slice(1));
    });
  }
  function filterSchedule(cid){
    _catalogFilterCid = Number(cid) || 0;
    _catalogPage = 1;
    var prevScroll = window.scrollY || 0;
    var el = document.getElementById('coursePanelCatalog');
    if (el && _catalogPkg) el.innerHTML = buildCatalogTableHtml(_catalogPkg);
    window.scrollTo(0, prevScroll);
    if (_catalogFilterCid) updateEmbeddedDetail(_catalogFilterCid);
  }
  function lessonWatchUrl(courseId, lessonId){
    var c = _courseDetails[courseId];
    if (!c || !c.lessons) return '#';
    for (var i = 0; i < c.lessons.length; i++) {
      if (Number(c.lessons[i].id) === Number(lessonId)) return c.lessons[i].watchUrl;
    }
    return '#';
  }
  function fmtDuration(sec){
    sec = Number(sec || 0);
    if (!sec || sec <= 0) return '-';
    if (sec < 60) return Math.round(sec) + 's';
    var m = Math.round(sec / 60);
    if (m >= 60) { var h = Math.floor(m / 60); var mm = m % 60; return mm ? h + 'h' + mm + 'min' : h + 'h'; }
    return m + 'min';
  }
  function calcHours(rows){
    var mins = 0;
    (rows || []).forEach(function(l){ mins += (Number(l.duration) || 0) / 60; });
    if (!mins) return (rows || []).length;
    return Math.max(1, Math.ceil(mins / 45));
  }
  function showPackageDetail(id){
    var d = _packageDetails[id];
    if (!d) return;
    PACKAGE_ID = d.id;
    _lastParentTitle = d.parent_title || '';
    var backBtn = document.getElementById('childBackBtn');
    if (backBtn) backBtn.onclick = backToChildren;
    var typeText = typeLabel(d.class_type);
    var tags = '<div class="detail-tags"><span>' + escHtml(d.province || '全国') + '</span><span>' + escHtml(d.year || '') + '年</span><span>' + escHtml(typeText) + '</span></div>';
    var teachers = (d.teachers && d.teachers.length) ? '<div class="detail-teachers">' + d.teachers.map(function(n, i){
      var av = (d.teacher_avatars && d.teacher_avatars[i]) ? '<img src="' + d.teacher_avatars[i] + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">' : escHtml(n.charAt(0));
      return '<span class="detail-teacher-item"><span class="detail-teacher-avatar">' + av + '</span><span>' + escHtml(n) + '</span></span>';
    }).join('') + '</div>' : '';
    var childrenHtml = '';
    if (d.children && d.children.length) {
      childrenHtml = '<div class="detail-section"><h3>系统课 <span class="count">' + d.children.length + '</span></h3><div class="detail-child-grid">' + d.children.map(function(c){
        var orig = c.price;
        var sale = c.sale_price;
        var priceHtml = orig ? '<span class="now">¥' + Number(orig).toFixed(2) + '</span>' + (sale && Number(sale) < Number(orig) ? '<span class="old">¥' + Number(sale).toFixed(2) + '</span>' : '') : (sale ? '¥' + Number(sale).toFixed(2) : '<span class="none">价格面议</span>');
        var cType = typeLabel(c.class_type);
        return '<a class="detail-child-card" href="javascript:void(0)" onclick="showPackageDetail(' + c.id + ')"><h4>' + escHtml(c.title) + '</h4><div class="meta"><span>' + (c.display_student_count || 0) + ' 人报名</span><span>' + escHtml(cType) + '</span></div><div class="price">' + priceHtml + '</div></a>';
      }).join('') + '</div></div>';
    }
    document.getElementById('packageDetailContent').innerHTML = childrenHtml;
    showEmbeddedPackageDetail(d.id);
    document.getElementById('packageDetailView').style.display = '';
    document.getElementById('childrenGrid').style.display = 'none';
    ensureCoursesView();
    if (window.applyGlobalFilter) window.applyGlobalFilter();
  }
  function openChildPkg(id, title) {
    var list = _coursesByPackage[id] || [];
    var grid = document.getElementById('childrenGrid');
    grid.innerHTML = '';
    if (!list.length) { grid.innerHTML = '<div class="empty">暂无课程</div>'; }
    list.forEach(function(c) {
      var card = document.createElement('a');
      card.href = 'javascript:void(0)';
      card.className = 'series-card';
      card.setAttribute('data-province', c.province || '');
      card.setAttribute('data-title', c.title || '');
      card.setAttribute('data-year', c.year || '');
      card.setAttribute('data-type', typeLabel(c.class_type));
      card.innerHTML = '<div class="series-body"><div class="series-hd"><span class="series-avatar">' + (c.title || '课').charAt(0) + '</span><h4>' + (c.title || '') + '</h4></div><div class="series-tags"><span>' + (c.province || '全国') + '</span><span>' + (c.year || '') + '年</span><span>' + (c.category || '系统课') + '</span></div><div class="series-meta"><span>' + (c.lesson_count || 0) + ' 课时</span><span>' + (c.teacher_name || '') + '</span></div></div><div class="series-foot"><span>' + (c.display_student_count || 0) + ' 人报名</span></div>';
      grid.appendChild(card);
    });
    showDrillUI(title || '系统课列表');
    ensureCoursesView();
    if (window.applyGlobalFilter) window.applyGlobalFilter();
  }
  function backToPackages() {
    var main = document.getElementById('mainPkgGrid');
    var grid = document.getElementById('childrenGrid');
    var dv = document.getElementById('packageDetailView');
    var cdv = document.getElementById('courseDetailView');
    var label = document.getElementById('childPkgLabel');
    var back = document.getElementById('childBackBtn');
    if (main) main.style.display = '';
    if (grid) grid.style.display = 'none';
    if (dv) dv.style.display = 'none';
    if (cdv) cdv.style.display = 'none';
    if (label) label.style.display = 'none';
    if (back) back.style.display = 'none';
    if (window.applyGlobalFilter) window.applyGlobalFilter();
  }
  function goBack() { switchView(_prevView || 'home'); }
  document.querySelectorAll('.menu-item[data-view]').forEach(function(m) {
    m.addEventListener('click', function() {
      var v = m.getAttribute('data-view');
      if (v === 'courses') { goCourseCenter(); } else { switchView(v); }
    });
  });
  var init = <%- JSON.stringify(initialView) %>;
  switchView(['home','courses','ai','community','rank'].indexOf(init) >= 0 ? init : 'home');
</script>
<script>
(function(){
  function loadSchedule(){
    var sel = document.getElementById('globalProvince') || document.getElementById('homeProvince');
    if (!sel) return;
    var bar = document.getElementById('homeSchedule');
    fetch('/api/schedule/' + sel.value).then(function(r){ return r.json(); }).then(function(data){
      bar.innerHTML = '';
      if (!data || !data.length) { bar.innerHTML = '<span class="schedule-item">日程更新中</span>'; return; }
      data.forEach(function(item){
        var el = document.createElement('span');
        el.className = 'schedule-item';
        el.innerHTML = '<b>' + (item.month||'') + '</b> ' + (item.event||'');
        bar.appendChild(el);
      });
    }).catch(function(){});
    fetch('/provinces/api/' + sel.value).then(function(r){ return r.json(); }).then(function(d){
      if (!d) return;
      var syl = document.getElementById('resSyllabus');
      if (syl) syl.innerHTML = d.outline_file ? '<div class="res-file"><div class="icon">PDF</div><div class="info"><strong>' + d.name + ' 专升本考试大纲</strong><span>点击查看或下载</span></div><a href="' + d.outline_file + '" target="_blank">查看 →</a></div>' : '<div class="res-empty">考纲持续更新中</div>';
      var pap = document.getElementById('resPapers');
      if (pap) pap.innerHTML = d.papers_file ? '<div class="res-file"><div class="icon">PDF</div><div class="info"><strong>' + d.name + ' 历年真题</strong><span>点击查看或下载</span></div><a href="' + d.papers_file + '" target="_blank">查看 →</a></div>' : '<div class="res-empty">历年真题持续更新中</div>';
    }).catch(function(){});
  }
  window.loadScheduleGlobal = loadSchedule;
  var provSel = document.getElementById('homeProvince');
  if (provSel) provSel.addEventListener('change', loadSchedule);
  loadSchedule();

  var tabs = document.querySelectorAll('#resTabs .res-tab');
  tabs.forEach(function(tab){
    tab.addEventListener('click', function(){
      tabs.forEach(function(t){ t.classList.remove('active'); });
      tab.classList.add('active');
      var key = tab.getAttribute('data-tab');
      var pane = document.getElementById('res' + key.charAt(0).toUpperCase() + key.slice(1));
      document.querySelectorAll('.res-pane').forEach(function(p){ p.classList.remove('active'); });
      if (pane) pane.classList.add('active');
    });
  });

  document.querySelectorAll('.like-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      var n = parseInt(btn.dataset.n) || 0;
      if (btn.classList.contains('liked')) { n--; btn.classList.remove('liked'); } else { n++; btn.classList.add('liked'); }
      btn.dataset.n = n;
      btn.querySelector('span').textContent = n;
    });
  });
})();
</script>
<script>
(function(){
  var bar = document.getElementById('typeFilter');
  var search = document.getElementById('courseSearch');
  var cards = document.querySelectorAll('.pkg-card, .series-card');
  var courseType = '系统学习';
  var keyword = '';
  function gProv() { var el = document.getElementById('globalProvince'); if (!el) return 'all'; if (el.value === 'all') return 'all'; return el.options[el.selectedIndex] ? el.options[el.selectedIndex].text : el.value; }
  function gYear() { var el = document.getElementById('globalYear'); return el ? el.value : ''; }
  function applyFilter() {
    var cardsAll = document.querySelectorAll('.pkg-card, .series-card');
    var visibleCount = 0;
    cardsAll.forEach(function(card) {
      var cp = card.getAttribute('data-province') || '';
      var cy = card.getAttribute('data-year') || '';
      var title = (card.getAttribute('data-title') || '').toLowerCase();
      var gp = gProv();
      var gy = gYear();
      var ct = card.getAttribute('data-type') || '';
      var okP = (courseType === 'all' || ct === courseType) && (gp === 'all' || cp === gp);
      var okY = !gy || cy === gy;
      var okK = !keyword || title.indexOf(keyword) > -1;
      card.style.display = (okP && okY && okK) ? '' : 'none';
      if (card.style.display !== 'none') visibleCount++;
    });
    var emptyBox = document.getElementById('filterEmpty');
    if (emptyBox) emptyBox.style.display = (cardsAll.length && !visibleCount) ? '' : 'none';
  }
  window.applyGlobalFilter = applyFilter;
  if (bar) bar.addEventListener('click', function(e) {
    var btn = e.target.closest('button[data-t]');
    if (!btn) return;
    bar.querySelectorAll('button').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    courseType = btn.dataset.t;
    if (window.backToPackages) window.backToPackages();
    applyFilter();
  });
  if (search) search.addEventListener('input', function() {
    keyword = search.value.trim().toLowerCase();
    applyFilter();
  });
  applyFilter();
})();
</script>
<script>
(function(){
  var gp = document.getElementById('globalProvince');
  var gy = document.getElementById('globalYear');
  function savePref(){
    if (!gp || !gy) return;
    try { localStorage.setItem('cz_province_pref', JSON.stringify({ province: gp.value, year: gy.value })); } catch(e) {}
  }
  function autoYear(){
    if (!gy) return;
    var years = {};
    document.querySelectorAll('.pkg-card, .series-card').forEach(function(c){
      if (c.style.display !== 'none') { var y = c.getAttribute('data-year'); if (y) years[y] = 1; }
    });
    var keys = Object.keys(years).sort();
    if (!keys.length) return;
    var preferred = keys.indexOf('2027') >= 0 ? '2027' : keys[0];
    if (!gy.value || !years[gy.value]) gy.value = preferred;
  }
  function sync(){
    var homeP = document.getElementById('homeProvince');
    var homeY = document.getElementById('homeYear');
    if (homeP && gp) homeP.value = gp.value;
    if (homeY && gy) homeY.value = gy.value;
    if (window.loadScheduleGlobal) window.loadScheduleGlobal();
    if (window.applyGlobalFilter) window.applyGlobalFilter();
    autoYear();
    if (window.applyGlobalFilter) window.applyGlobalFilter();
    savePref();
  }
  if (gp) gp.addEventListener('change', sync);
  if (gy) gy.addEventListener('change', sync);
  var homeP = document.getElementById('homeProvince');
  var homeY = document.getElementById('homeYear');
  if (homeP) homeP.addEventListener('change', function(){ if (gp) gp.value = homeP.value; if (window.loadScheduleGlobal) window.loadScheduleGlobal(); if (window.applyGlobalFilter) window.applyGlobalFilter(); });
  if (homeY) homeY.addEventListener('change', function(){ if (gy) gy.value = homeY.value; if (window.applyGlobalFilter) window.applyGlobalFilter(); });
})();
</script>
<script>
(function(){
  var REGION_MAP = { 'shandong':'山东', 'zhejiang':'浙江', 'henan':'河南', 'guangdong':'广东', 'jiangsu':'江苏', 'sichuan':'四川', 'fujian':'福建', 'hunan':'湖南', 'anhui':'安徽', 'shaanxi':'陕西', 'hubei':'湖北', 'jiangxi':'江西' };
  function applyProvince(value, save){
    var gp = document.getElementById('globalProvince');
    var hp = document.getElementById('homeProvince');
    if (!gp || !value) return;
    var name = REGION_MAP[String(value).toLowerCase()] || value;
    var ok = false;
    for (var i = 0; i < gp.options.length; i++) {
      var text = gp.options[i].text || '';
      if (text === name || text.indexOf(name) > -1 || name.indexOf(text) > -1 || String(gp.options[i].value) === String(value)) {
        gp.value = gp.options[i].value;
        ok = true;
        break;
      }
    }
    if (!ok) return;
    if (hp) hp.value = gp.value;
    if (save) { try { localStorage.setItem('cz_province_pref', JSON.stringify({ province: gp.value, year: document.getElementById('globalYear') ? document.getElementById('globalYear').value : '' })); } catch(e) {} }
    if (window.loadScheduleGlobal) window.loadScheduleGlobal();
    if (window.applyGlobalFilter) window.applyGlobalFilter();
  }
  var saved = null;
  try { saved = JSON.parse(localStorage.getItem('cz_province_pref') || 'null'); } catch(e) {}
  if (saved && saved.year) { var gy0 = document.getElementById('globalYear'); if (gy0) gy0.value = saved.year; }
  if (saved && saved.province) { applyProvince(saved.province, false); return; }
  try {
    fetch('https://ipapi.co/json/').then(function(r){ return r.json(); }).then(function(d){
      applyProvince(d.region || d.country_name || '', true);
    }).catch(function(){});
  } catch(e) {}
})();
</script>
<script>
  var _allQuestions = [];
  var _practiceMode = 'practice';
  var _pSubject = '全部';
  var _lessonFilter = 0;
  var _pIdx = 0;
  var _pSelected = -1;
  var _pAnswered = false;
  var _examQuestions = [];
  var _examIdx = 0;
  var _examAnswers = [];
  var _examTimer = null;
  var _examSeconds = 0;
  var _examSubmitted = false;

  function loadQuestions(){
    fetch('/api/practice/questions').then(function(r){ return r.json(); }).then(function(d){
      if (d.ok) _allQuestions = d.questions || [];
      switchPractice(_practiceMode);
    }).catch(function(){ document.getElementById('practiceBox').innerHTML = '<div class="empty">题库加载失败</div>'; });
  }
  function switchPractice(mode){
    _practiceMode = mode;
    document.querySelectorAll('.practice-tab').forEach(function(b){ b.classList.toggle('active', b.getAttribute('data-mode') === mode); });
    if (mode === 'practice') renderPractice();
    else renderExamHome();
  }
  function renderPractice(){
    var subjects = ['全部'];
    (_allQuestions || []).forEach(function(q){ if (subjects.indexOf(q.subject) < 0) subjects.push(q.subject); });
    var filterBar = _lessonFilter ? '<div class="explanation" style="margin-bottom:14px">当前仅显示本课时课后练习 <button type="button" class="primary" style="margin-left:8px;border:none;border-radius:6px;padding:6px 12px;font-size:12px;cursor:pointer;font-family:inherit" onclick="clearLessonFilter()">返回全部题库</button></div>' : '';
    var pills = '<div class="subject-pills">' + subjects.map(function(s){ return '<button type="button" class="subject-pill' + (s === _pSubject ? ' active' : '') + '" onclick="setPracticeSubject(\'' + s + '\')">' + escHtml(s) + '</button>'; }).join('') + '</div>';
    var list = _allQuestions.filter(function(q){ return (_pSubject === '全部' || q.subject === _pSubject) && (!_lessonFilter || Number(q.lesson_id) === Number(_lessonFilter)); });
    if (!list.length) { document.getElementById('practiceBox').innerHTML = filterBar + pills + '<div class="empty">暂无题目</div>'; return; }
    if (_pIdx >= list.length) _pIdx = list.length - 1;
    var q = list[_pIdx];
    var opts = q.options.map(function(o, i){
      var cls = 'option-btn';
      if (_pAnswered) { if (i === q.answer) cls += ' correct'; else if (i === _pSelected) cls += ' wrong'; }
      else if (i === _pSelected) cls += ' selected';
      return '<button type="button" class="' + cls + '" onclick="' + (_pAnswered ? '' : 'selectPracticeOption(' + i + ')') + '">' + escHtml(o) + '</button>';
    }).join('');
    var result = _pAnswered ? (q.answer === _pSelected ? '<div style="color:#16a34a;font-weight:700;margin-top:12px">回答正确</div>' : '<div style="color:#dc2626;font-weight:700;margin-top:12px">回答错误，正确答案：' + escHtml(q.options[q.answer]) + '</div>') : '';
    var explanation = _pAnswered && q.explanation ? '<div class="explanation"><b>解析：</b>' + escHtml(q.explanation) + '</div>' : '';
    var actions = '<div class="practice-actions">' + (_pIdx > 0 ? '<button type="button" class="ghost" onclick="prevPractice()">上一题</button>' : '') + '<button type="button" class="primary" onclick="' + (_pAnswered ? 'nextPractice()' : 'submitPractice()') + '">' + (_pAnswered ? '下一题' : '提交答案') + '</button></div>';
    document.getElementById('practiceBox').innerHTML = filterBar + pills + '<div class="question-card"><div class="question-meta"><span>' + escHtml(q.subject || '') + '</span><span>' + (_pIdx + 1) + ' / ' + list.length + '</span></div><div class="question-content">' + escHtml(q.content) + '</div>' + opts + result + explanation + actions + '</div>';
  }
  function clearLessonFilter(){ _lessonFilter = 0; _pIdx = 0; _pSelected = -1; _pAnswered = false; renderPractice(); }
  function openLessonPractice(lessonId){ _lessonFilter = lessonId; _pIdx = 0; _pSelected = -1; _pAnswered = false; switchView('practice'); switchPractice('practice'); }
  function setPracticeSubject(s){ _pSubject = s; _pIdx = 0; _pSelected = -1; _pAnswered = false; renderPractice(); }
  function selectPracticeOption(i){ _pSelected = i; renderPractice(); }
  function submitPractice(){ if (_pSelected < 0) { alert('请先选择一个答案'); return; } _pAnswered = true; renderPractice(); }
  function prevPractice(){ _pIdx--; _pSelected = -1; _pAnswered = false; renderPractice(); }
  function nextPractice(){ _pIdx++; _pSelected = -1; _pAnswered = false; renderPractice(); }
  function renderExamHome(){
    document.getElementById('practiceBox').innerHTML = '<div class="question-card"><div class="question-content">模拟考试共 8 题，限时 10 分钟，交卷后显示得分和答案解析。</div><div class="practice-actions"><button type="button" class="primary" onclick="startExam()">开始考试</button></div></div>';
  }
  function startExam(){
    _examQuestions = (_allQuestions || []).slice().sort(function(){ return Math.random() - 0.5; }).slice(0, Math.min(8, (_allQuestions || []).length));
    _examIdx = 0; _examAnswers = []; _examSubmitted = false; _examSeconds = 600;
    if (_examTimer) clearInterval(_examTimer);
    _examTimer = setInterval(function(){
      _examSeconds--;
      var t = document.getElementById('examTimer');
      if (t) t.textContent = fmtExamTime(_examSeconds);
      if (_examSeconds <= 0) submitExam();
    }, 1000);
    renderExamQ();
  }
  function fmtExamTime(s){ var m = Math.floor(s / 60); var ss = s % 60; return (m < 10 ? '0' : '') + m + ':' + (ss < 10 ? '0' : '') + ss; }
  function renderExamQ(){
    if (_examSubmitted || _examIdx >= _examQuestions.length) { submitExam(); return; }
    var q = _examQuestions[_examIdx];
    var opts = q.options.map(function(o, i){ return '<button type="button" class="option-btn' + (_examAnswers[_examIdx] === i ? ' selected' : '') + '" onclick="selectExamOption(' + i + ')">' + escHtml(o) + '</button>'; }).join('');
    document.getElementById('practiceBox').innerHTML = '<div class="question-card"><div class="question-meta"><span>模拟考试 · ' + escHtml(q.subject || '') + '</span><span class="exam-timer" id="examTimer">' + fmtExamTime(_examSeconds) + '</span></div><div class="question-content">' + escHtml(q.content) + '</div>' + opts + '<div class="practice-actions"><button type="button" class="ghost" onclick="prevExamQ()">上一题</button><button type="button" class="primary" onclick="nextExamQ()">下一题</button><button type="button" class="primary" style="background:#dc2626" onclick="submitExam()">交卷</button></div></div>';
  }
  function selectExamOption(i){ _examAnswers[_examIdx] = i; renderExamQ(); }
  function prevExamQ(){ if (_examIdx > 0) { _examIdx--; renderExamQ(); } }
  function nextExamQ(){ if (_examAnswers[_examIdx] === undefined) { alert('请先选择答案'); return; } _examIdx++; renderExamQ(); }
  function submitExam(){
    if (_examSubmitted) return;
    _examSubmitted = true;
    if (_examTimer) clearInterval(_examTimer);
    var score = 0;
    var review = _examQuestions.map(function(q, i){
      var ok = _examAnswers[i] === q.answer;
      if (ok) score++;
      return '<div class="question-card" style="margin-bottom:12px"><div class="question-meta"><span>' + (i + 1) + '. ' + escHtml(q.subject || '') + '</span><span>' + (ok ? '<span style="color:#16a34a;font-weight:700">正确</span>' : '<span style="color:#dc2626;font-weight:700">错误</span>') + '</span></div><div class="question-content">' + escHtml(q.content) + '</div><div style="font-size:13px;color:var(--text-2)">你的答案：' + escHtml(_examAnswers[i] === undefined ? '未作答' : q.options[_examAnswers[i]]) + '；正确答案：' + escHtml(q.options[q.answer]) + '</div>' + (q.explanation ? '<div class="explanation"><b>解析：</b>' + escHtml(q.explanation) + '</div>' : '') + '</div>';
    }).join('');
    document.getElementById('practiceBox').innerHTML = '<div class="question-card result-card"><div class="result-score">' + score + ' / ' + _examQuestions.length + '</div><div class="rs-label">模拟考试得分</div><div class="practice-actions" style="justify-content:center"><button type="button" class="primary" onclick="switchPractice(\'practice\')">去刷题</button><button type="button" class="ghost" onclick="renderExamHome()">重新考试</button></div></div>' + review;
  }
  var _provinces = <%- JSON.stringify(provinces || []) %>;
  function renderNews(code){
    var provs = _provinces || [];
    if (!provs.length) { document.getElementById('newsBox').innerHTML = '<div class="empty">暂无考情资讯</div>'; return; }
    var pills = '<div class="subject-pills">' + provs.map(function(p){ return '<button type="button" class="subject-pill' + (String(p.code) === String(code) ? ' active' : '') + '" onclick="renderNews(' + p.code + ')">' + escHtml(p.name || '') + '</button>'; }).join('') + '</div>';
    document.getElementById('newsProvincePills').innerHTML = pills;
    var p = null;
    for (var i = 0; i < provs.length; i++) { if (String(provs[i].code) === String(code)) { p = provs[i]; break; } }
    if (!p) p = provs[0];
    var schedule = [];
    try { schedule = JSON.parse(p.schedule || '[]'); } catch(e) {}
    var items = schedule.map(function(s){ return '<div class="upcoming-item"><span class="u-time">' + escHtml(s.month || '') + '</span><div><b>' + escHtml(s.event || '') + '</b><span>' + escHtml(p.name || '') + ' 考情节点</span></div></div>'; }).join('');
    if (!items) items = '<div class="empty">该省份考情持续更新中</div>';
    var files = '';
    if (p.outline_file) files += '<a class="res-file" style="text-decoration:none;color:inherit" href="' + p.outline_file + '" target="_blank"><span class="icon">PDF</span><span class="info"><strong>' + escHtml(p.name || '') + ' 考试大纲</strong><span>点击查看</span></span></a>';
    if (p.papers_file) files += '<a class="res-file" style="text-decoration:none;color:inherit;margin-top:8px" href="' + p.papers_file + '" target="_blank"><span class="icon">PDF</span><span class="info"><strong>' + escHtml(p.name || '') + ' 历年真题</strong><span>点击查看</span></span></a>';
    document.getElementById('newsBox').innerHTML = '<div class="overview-panel"><h3>' + escHtml(p.name || '') + ' · 考情日程</h3>' + items + (files ? '<div style="margin-top:12px">' + files + '</div>' : '') + '</div>';
  }
  renderNews(_provinces.length ? _provinces[0].code : 0);
  loadQuestions();
</script>
<script>
  function openAuthModal(){ document.getElementById('authModal').classList.add('open'); }
  function closeAuthModal(){ document.getElementById('authModal').classList.remove('open'); }
  function guestEntry(){
    fetch('/api/auth/guest', { method: 'POST' }).then(function(r){ return r.json(); }).then(function(d){
      if (d.success) location.reload();
    }).catch(function(){});
  }
  function switchAuth(mode){
    document.getElementById('authLogin').style.display = mode === 'login' ? '' : 'none';
    document.getElementById('authRegister').style.display = mode === 'register' ? '' : 'none';
    document.getElementById('tabLogin').classList.toggle('active', mode === 'login');
    document.getElementById('tabRegister').classList.toggle('active', mode === 'register');
    document.getElementById('authMsg').textContent = '';
    document.getElementById('authMsg2').textContent = '';
  }
  function sendCode(){
    var phone = document.getElementById('regPhone').value.trim();
    if (!phone) { alert('请输入手机号'); return; }
    fetch('/api/auth/send-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone: phone })
    }).then(function(r){ return r.json(); }).then(function(d){
      if (!d.success) { alert(d.error || '发送失败'); return; }
      if (d.devCode) alert('开发模式验证码：' + d.devCode);
      else alert('验证码已发送');
    }).catch(function(){ alert('发送失败'); });
  }
  function doRegister(){
    var phone = document.getElementById('regPhone').value.trim();
    var code = document.getElementById('regCode').value.trim();
    var password = document.getElementById('regPassword').value;
    if (!password) { document.getElementById('authMsg2').textContent = '请设置登录密码'; return; }
    fetch('/api/auth/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone: phone, code: code, password: password })
    }).then(function(r){ return r.json(); }).then(function(d){
      if (!d.success) { document.getElementById('authMsg2').textContent = d.error || '注册失败'; return; }
      closeAuthModal();
      if (PACKAGE_ID) createOrder(); else location.reload();
    }).catch(function(){ document.getElementById('authMsg2').textContent = '注册失败'; });
  }
  function doLogin(){
    var phone = document.getElementById('loginPhone').value.trim();
    var password = document.getElementById('loginPassword').value;
    var remember = document.getElementById('rememberPwd');
    fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ phone: phone, password: password })
    }).then(function(r){ return r.json(); }).then(function(d){
      if (!d.success) { document.getElementById('authMsg').textContent = d.error || '登录失败'; return; }
      if (remember && remember.checked) {
        try { localStorage.setItem('cz_remember_login', JSON.stringify({ phone: phone, password: password })); } catch(e) {}
      } else {
        try { localStorage.removeItem('cz_remember_login'); } catch(e) {}
      }
      closeAuthModal();
      if (PACKAGE_ID) createOrder(); else location.reload();
    }).catch(function(){ document.getElementById('authMsg').textContent = '登录失败'; });
  }
  function openModal(id){ var m = document.getElementById(id); if (m) m.classList.add('open'); }
  function closeModal(id){ var m = document.getElementById(id); if (m) m.classList.remove('open'); }
  function closePayModal(){ closeModal('payModal'); }
  function startBuy(){
    var agree = document.getElementById('agreeTerms');
    if (agree && !agree.checked) { alert('请先阅读并同意服务协议、隐私政策和退款说明'); return; }
    if (!<%= student ? 'true' : 'false' %>) { openAuthModal(); return; }
    createOrder();
  }
  function createOrder(){
    fetch('/api/orders', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ package_id: PACKAGE_ID })
    }).then(function(r){ return r.json(); }).then(function(d){
      if (!d.ok) { alert(d.error || '下单失败'); return; }
      CURRENT_ORDER_ID = d.order.id;
      document.getElementById('payAmount').textContent = '订单金额：¥' + Number(d.order.amount || 0).toFixed(2);
      openModal('payModal');
    }).catch(function(){ alert('下单请求失败'); });
  }
  function doPay(channel){
    fetch('/api/orders/' + CURRENT_ORDER_ID + '/pay', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ channel: channel })
    }).then(function(r){ return r.json(); }).then(function(d){
      if (!d.ok) { alert(d.error || '支付失败'); return; }
      if (d.dev) { alert('开发模式：已模拟支付成功'); closePayModal(); location.reload(); return; }
      alert('支付参数生成中，请稍后到我的订单查看');
    }).catch(function(){ alert('支付请求失败'); });
  }
  function logoutStudent(){
    fetch('/api/auth/logout', { method: 'POST' }).then(function(){ location.reload(); }).catch(function(){ location.reload(); });
  }
  (function(){
    try {
      var saved = JSON.parse(localStorage.getItem('cz_remember_login') || 'null');
      if (saved && saved.phone) {
        var lp = document.getElementById('loginPhone'); if (lp) lp.value = saved.phone;
        var lpw = document.getElementById('loginPassword'); if (lpw) lpw.value = saved.password || '';
        var rp = document.getElementById('rememberPwd'); if (rp && saved.password) rp.checked = true;
      }
    } catch(e) {}
  })();
</script>
</body>
</html>
