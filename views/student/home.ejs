  .modal-actions .cancel { background:#fff; border:1px solid #E5E7EB; color:var(--text-1); }
  .modal-actions .primary { background:var(--button-gradient); border:1px solid #C9D2DA; color:#1E1E1E; }
  .auth-tip { font-size:12px; color:var(--text-3); margin-top:8px; min-height:16px; }

  /* 备考工具：省份选择 / 日程 / 资料 */
  .tool-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:20px 22px; margin-bottom:16px; box-shadow:var(--shadow-card); }
