  /* 答疑 / 社区 */
  .assistant-grid, .ai-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; }
  .assistant-card, .ai-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:16px; box-shadow:var(--shadow-card); transition:transform .2s ease, box-shadow .2s ease; }
