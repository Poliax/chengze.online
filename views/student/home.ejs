  #coursePanelCatalog { display:flex; flex-direction:column; }
  .catalog-table-wrap { max-height:none; overflow:visible; flex:1; }
  .pager { display:flex; align-items:center; justify-content:center; gap:12px; padding:12px 0 2px; margin-top:auto; }
  .pager button { border:1px solid #E5E7EB; background:#fff; border-radius:6px; padding:6px 14px; font-size:12px; color:var(--text-1); cursor:pointer; font-family:inherit; }
  .pager button:hover:not(:disabled) { border-color:#94A3B8; color:#1c1917; }
  .pager button:disabled { opacity:.45; cursor:default; }
  .pager span { font-size:12px; color:var(--text-3); }
  .detail-table { width:100%; border-collapse:separate; border-spacing:0; }
  .detail-table th { position:sticky; top:0; z-index:2; text-align:left; background:#EFF4FA; padding:14px 16px; font-size:12.5px; font-weight:700; color:#1E1E1E; border-bottom:2px solid #C7D4E0; letter-spacing:.5px; white-space:nowrap; }
