  .course-showcase .showcase-eyebrow { font-size:12px; letter-spacing:2px; color:#C8A96A; margin-bottom:8px; font-weight:600; }
  .course-showcase h2 { font-size:22px; font-weight:800; line-height:1.4; }
  .course-showcase p { margin-top:8px; color:var(--text-2); font-size:13px; line-height:1.7; max-width:640px; }
  .ad-tag { position:absolute; top:10px; right:12px; font-size:10px; color:var(--text-3); border:1px solid #e5e7eb; border-radius:4px; padding:1px 6px; }
  .ad-placeholder { display:flex; align-items:center; justify-content:center; min-height:72px; font-size:14px; color:var(--text-3); letter-spacing:2px; }
  .course-lesson { display:flex; align-items:center; gap:12px; padding:12px 14px; border:1px solid var(--border); border-radius:10px; margin-bottom:8px; background:#fafbfe; }
  .course-lesson .num { width:32px; height:32px; border-radius:50%; background:#f5f0f2; color:#1c1917; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; flex-shrink:0; }
  .course-lesson .info { flex:1; min-width:0; }
  .course-lesson .name { font-size:14px; font-weight:600; color:var(--text-1); }
  .course-lesson .meta { font-size:12px; color:var(--text-3); margin-top:2px; }
  .course-lesson .watch { background:var(--button-gradient); color:#1E1E1E; border:1px solid #C9D2DA; border-radius:8px; padding:7px 14px; font-size:12px; font-weight:600; text-decoration:none; }
  .course-tabs { display:flex; gap:4px; padding:4px; background:#f1f5f9; border-radius:10px; margin-bottom:16px; width:fit-content; flex-wrap:nowrap; overflow-x:auto; max-width:100%; }
  .course-tabs-divider { height:1px; background:#e2e8f0; margin:22px 0 16px; }
  .course-tab { flex-shrink:0; white-space:nowrap; border:none; background:transparent; padding:8px 18px; border-radius:8px; font-size:13px; color:var(--text-2); cursor:pointer; font-family:inherit; font-weight:500; }
  .course-tab.active { background:var(--button-gradient); color:#1E1E1E; box-shadow:0 1px 3px rgba(23,18,25,.08); font-weight:600; }
  .course-panels { display:grid; }
  .course-panel { grid-area:1 / 1; visibility:hidden; }
  .course-panel.active { visibility:visible; }
  .detail-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px 24px; }
  @media (max-width:640px) { .detail-grid { grid-template-columns:1fr; } }
  @media (max-width:960px) { .detail-layout { grid-template-columns:1fr; } .detail-side { position:static; } }

  @media (max-width:960px) {
    .app { flex-direction:column; }
    .sidebar { width:100%; height:auto; position:static; flex-direction:row; align-items:center; padding:10px 14px; gap:8px; }
    .main { margin-left:0; }
    .logo { height:auto; border:none; padding:0; }
    .logo-text { display:none; }
    .menu-scroll { display:flex; gap:4px; overflow-x:auto; padding:0; }
    .menu-group { display:none; }
    .menu-item { width:auto; padding:8px 10px; margin:0; white-space:nowrap; }
    .sidebar-foot { border:none; padding:0; }
    .sidebar-foot .auth-btn { width:auto; padding:8px 12px; }
    .content { padding:18px 16px 40px; }
    .hero { flex-direction:column; align-items:flex-start; }
    .stats { grid-template-columns:1fr; }
    .footer-inner { grid-template-columns:1fr; }
  }
  @media (max-width:640px) {
    .main-header { padding:0 14px; }
    .content { padding:16px 12px 36px; }
    .search { margin-left:0; width:100%; }
    .search input { width:100%; }
    .toolbar { align-items:flex-start; }
    .seg { flex-wrap:wrap; }
    .header-sub { display:none; }
  }
</style>
<style>.chengze-mobile-mark{display:none}@media(max-width:768px){.logo .chengze-wordmark{display:none!important}.chengze-mobile-mark{display:block;background:#f5f3ed;border-radius:6px;padding:3px;box-sizing:border-box}}</style><link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"><link rel="stylesheet" href="/public/css/student-topnav.css?v=20261018-topnav1"></head>
<body class="student-top-layout">
<%
  var totalLessons = (courses || []).reduce(function(s, c){ return s + (c.lesson_count || 0); }, 0);
  var initialView = typeof initialView !== 'undefined' ? initialView : 'home';
  var hp = typeof homeProvinceData !== 'undefined' ? homeProvinceData : {};
  var ov = typeof overview !== 'undefined' ? overview : {};
  var myList = typeof myCourses !== 'undefined' ? myCourses : [];
  var upList = typeof upcomingLessons !== 'undefined' ? upcomingLessons : [];
%>
<div class="app">
  <header class="sidebar student-topnav">
    <div class="logo">
      <img class="chengze-wordmark" src="/public/images/brand-green/online-dark.svg?v=20261017-brand1" alt="承泽在线" style="width:144px;max-width:100%;height:auto;display:block;flex:none"><img class="chengze-mobile-mark" src="/public/images/brand-green/app-rounded.svg?v=20261017-brand1" alt="承泽在线" style="width:32px;height:32px">
    </div>
    <nav class="menu-scroll" aria-label="学员主导航">
      <div class="menu-group"><div class="group-title"><span class="group-dot"></span>专升本在线学习平台</div></div>
      <button type="button" class="menu-item" data-view="home" onclick="switchView('home')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        首页
      </button>
      <button type="button" class="menu-item" data-view="overview" onclick="switchView('overview')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
        学习总览
      </button>
      <button type="button" class="menu-item" data-view="courses" onclick="switchView('courses')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        课程中心
      </button>
      <button type="button" class="menu-item" data-view="practice" onclick="switchView('practice')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        刷题模考
      </button>
      <button type="button" class="menu-item" data-view="ai" onclick="switchView('ai')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect x="4" y="8" width="16" height="12" rx="2"/></svg>
        在线答疑
      </button>
      <button type="button" class="menu-item" data-view="community" onclick="switchView('community')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        备考社区
      </button>
      <button type="button" class="menu-item" data-view="news" onclick="switchView('news')">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0V9"/><line x1="10" y1="6" x2="20" y2="6"/><line x1="10" y1="10" x2="20" y2="10"/></svg>
        考情资讯
      </button>
    </nav>
    <div class="sidebar-foot">
      <div class="foot-glow"></div>
      <% if (student) { %>
        <div class="sidebar-user">
          <span class="avatar"><%= (student.name || '学').charAt(0) %></span>
          <span class="u-name"><%= student.name %></span>
          <a href="javascript:;" onclick="logoutStudent()">退出</a>
        </div>
      <% } else if (guest) { %>
        <div class="sidebar-user">
          <span class="avatar">游</span>
          <span class="u-name">游客</span>
          <a href="javascript:;" onclick="logoutStudent()">退出</a>
        </div>
      <% } else { %>
        <button type="button" class="auth-btn" onclick="openAuthModal()">登录 / 注册</button>
      <% } %>
    </div>
  </header>

  <main class="main">
    <header class="main-header">
      <span class="header-time"><%= new Date().getFullYear() %> 年 <%= new Date().getMonth() + 1 %> 月 <%= new Date().getDate() %> 日 · 星期<%= ['日','一','二','三','四','五','六'][new Date().getDay()] %></span>
      <div class="header-right">
        <div class="global-filter">
          <label>招考省份</label>
          <select id="globalProvince"><% (typeof provinces !== "undefined" ? provinces : []).forEach(p => { %><option value="<%= p.code %>"><%= p.name %></option><% }) %></select>
          <label>考试年份</label>
          <select id="globalYear"><option value="2027" selected>2027</option><option value="2028">2028</option><option value="2029">2029</option></select>
        </div>
      </div>
    </header>

    <div class="content">
      <!-- 首页视图 -->
      <section class="view" id="viewHome">
        <div class="hero">
          <div>
            <h2>专升本备考，从这里开始</h2>
            <p>直播授课 + 课后回放 + 科学排课，覆盖山东、陕西、浙江等省份，按考期系统备考。</p>
          </div>
          <button type="button" class="hero-cta" onclick="goCourseCenter()">进入课程中心 →</button>
        </div>

        <div class="learn-overview">
          <div class="overview-card"><span class="ov-num"><%= ov.enrolled || 0 %></span><span class="ov-label">已购课程</span></div>
          <div class="overview-card"><span class="ov-num"><%= ov.completed || 0 %></span><span class="ov-label">完成课时</span></div>
          <div class="overview-card"><span class="ov-num"><%= ov.upcoming || 0 %></span><span class="ov-label">待上课</span></div>
          <div class="overview-card"><span class="ov-num"><%= Math.round((ov.minutes || 0) / 60) %></span><span class="ov-label">学习小时</span></div>
        </div>

        <div class="tool-card">
          <h3>备考工具 <span class="en">Exam Tools</span></h3>
          <div class="schedule-bar" id="homeSchedule">
            <% (hp.schedule || []).forEach(function(it) { %>
            <span class="schedule-item"><b><%= it.month||'' %></b> <%= it.event||'' %></span>
            <% }) %>
          </div>
        </div>

        <div class="tool-card">
          <h3>备考资料 <span class="en">Resources</span></h3>
          <div class="res-tabs" id="resTabs">
            <button type="button" class="res-tab active" data-tab="syllabus">考试大纲</button>
            <button type="button" class="res-tab" data-tab="papers">历年真题</button>
            <button type="button" class="res-tab" data-tab="major">官方公告</button>
            <button type="button" class="res-tab" data-tab="admission">招录数据</button>
          </div>
          <div class="res-pane active" id="resSyllabus">
            <% if (hp.outline_file) { %>
            <div class="res-file"><div class="icon">PDF</div><div class="info"><strong><%= hp.name||'' %> 专升本考试大纲</strong><span>点击查看或下载</span></div><a href="<%= hp.outline_file %>" target="_blank">查看 →</a></div>
            <% } else { %><div class="res-empty">考纲持续更新中</div><% } %>
          </div>
          <div class="res-pane" id="resPapers">
            <% if (hp.papers_file) { %>
            <div class="res-file"><div class="icon">PDF</div><div class="info"><strong><%= hp.name||'' %> 历年真题</strong><span>点击查看或下载</span></div><a href="<%= hp.papers_file %>" target="_blank">查看 →</a></div>
            <% } else { %><div class="res-empty">历年真题持续更新中</div><% } %>
          </div>
          <div class="res-pane" id="resMajor"><div class="res-empty">官方公告持续更新中</div></div>
          <div class="res-pane" id="resAdmission"><div class="res-empty">招录数据持续更新中</div></div>
        </div>

        <% if (packages && packages.length > 0) { %>
        <div class="section-title" style="justify-content:flex-end">
          <button type="button" class="more" onclick="switchView('courses')">查看全部 →</button>
        </div>
        <div class="pkg-grid">
          <% packages.slice(0, 6).forEach(p => { %>
          <div class="pkg-card" onclick="showChildren('<%= p.id %>')" data-id="<%= p.id %>" data-title="<%= p.title %>" data-year="<%= p.year||'' %>" data-type="<%= (function(){ var _t=p.class_type||''; return (_t==='公开课'||_t==='免费课'||_t==='公共课') ? '公开课' : (['专项提升','专项提升课','专项集训','专项集训课','冲刺密训','押题密训课'].includes(_t) ? '专项提升' : '系统学习') })() %>">
            <div class="pkg-top">
              <div class="pkg-tags">
                <span><%= p.province||'全国' %></span>
                <span><%= p.year||'' %>年</span>
                <span><%= p.exam_type || '专升本' %></span>
              </div>
              <h3><%= p.title %></h3>
            </div>
            <div class="pkg-body">
              <div class="pkg-start"><b>课时：</b><%= p.total_hours || 0 %><%= p.total_hours_plus ? '+' : '' %></div><div class="pkg-start"><b>开课：</b><%= p.start_date || '待定' %><% if (p.end_date) { %> ~ <%= p.end_date %><% } %></div>
              <div class="pkg-desc"><%= p.description ? p.description.substring(0,70)+(p.description.length>70?'...':'') : '系统化课程包，多门系列课组合学习。' %></div>
            </div>
            <div class="pkg-foot">
              <span class="go pkg-price">
                <% if (p.price) { %>
                  <span class="now">¥<%= Number(p.price).toFixed(2) %></span>
                  <% if (p.sale_price && Number(p.sale_price) < Number(p.price)) { %><span class="old">¥<%= Number(p.sale_price).toFixed(2) %></span><% } %>
                <% } else if (p.sale_price) { %>
                  <span class="now">¥<%= Number(p.sale_price).toFixed(2) %></span>
                <% } else { %>
                  <span class="none">价格面议</span>
                <% } %>
              </span>
              <span><%= (p.display_student_count||0) %> 人报名</span>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>

      </section>

      <!-- 学习总览视图 -->
      <section class="view" id="viewOverview">
        <div class="overview-hero">
          <div class="ov-greet">
            <% var hour = new Date().getHours(); var greet = hour < 12 ? '早上好' : (hour < 18 ? '下午好' : '晚上好'); %>
            <h2><%= greet %>，开始今天的学习吧</h2>
            <p>已学课程、完成课时、待上课和学习时长一目了然。</p>
          </div>
          <div class="overview-chips">
            <div class="chip"><span class="chip-value"><%= myList.length %></span><span class="chip-label">已学课程</span></div>
            <div class="chip"><span class="chip-value"><%= Math.round((ov.minutes||0)/60) %></span><span class="chip-label">学习时长(小时)</span></div>
            <div class="chip"><span class="chip-value"><%= ov.completed||0 %></span><span class="chip-label">完成课时</span></div>
            <div class="chip"><span class="chip-value"><%= ov.upcoming||0 %></span><span class="chip-label">待上课</span></div>
          </div>
        </div>

        <div class="overview-grid">
          <div class="overview-panel">
            <h3>我的课程</h3>
            <% if (myList.length) { %>
              <% myList.forEach(function(c){ %>
              <div class="overview-course">
                <div class="ovc-info"><b><%= c.title %></b><span><%= c.province||'' %> · <%= c.year||'' %>年 · <%= c.teacher_name||'' %></span></div>
                <div class="ovc-meta"><span>进度 <%= c.percent||0 %>%</span><span><%= c.completed %> / <%= c.lesson_count %> 课时</span></div>
                <div class="overview-progress"><i style="width:<%= c.percent||0 %>%"></i></div>
              </div>
              <% }) %>
            <% } else { %><div class="empty">暂无已购课程</div><% } %>
          </div>
          <div class="overview-panel">
            <h3>待上课</h3>
            <% if (upList.length) { %>
              <% upList.forEach(function(l){ %>
              <div class="upcoming-item">
                <span class="u-time"><%= String(l.schedule_time||'').replace('T',' ').substring(5,16) %></span>
                <div><b><%= l.title %></b><span><%= l.course_title %></span></div>
              </div>
              <% }) %>
            <% } else { %><div class="empty">暂无待上课</div><% } %>
          </div>
        </div>
      </section>

      <!-- 课程中心视图 -->
      <section class="view" id="viewCourses">
        <% var ad = (typeof adConfig !== 'undefined' && adConfig && adConfig.enabled) ? adConfig : null; %>
        <div class="course-showcase" id="adBanner">
          <span class="ad-tag">广告</span>
          <% if (ad) { %>
            <% if (ad.link) { %><a href="<%= ad.link %>" target="_blank" rel="noopener" style="display:block;text-decoration:none;color:inherit"><% } %>
            <% if (ad.image) { %>
              <img src="<%= ad.image %>" alt="<%= ad.title || '' %>" style="width:100%;max-height:190px;object-fit:cover;border-radius:8px">
            <% } else { %>
              <div style="padding:6px 0">
                <% if (ad.title) { %><div class="showcase-eyebrow"><%= ad.title %></div><% } %>
                <% if (ad.subtitle) { %><h2 style="margin-top:8px"><%= ad.subtitle %></h2><% } %>
                <% if (!ad.title && !ad.subtitle) { %><div class="ad-placeholder">广告展示位</div><% } %>
              </div>
            <% } %>
            <% if (ad.link) { %></a><% } %>
          <% } else { %>
            <div class="ad-placeholder">广告展示位</div>
          <% } %>
        </div>

        <div class="toolbar">
          <div class="seg" id="typeFilter">
            <button class="active" data-t="系统学习">系统学习</button>
            <button data-t="专项提升">专项提升</button>
            <button data-t="公开课">公开课</button>
          </div>
          <button type="button" class="back-btn" id="childBackBtn" style="display:none" onclick="backToPackages()">← 返回</button>
          <div class="search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="courseSearch" type="text" name="q" autocomplete="off" spellcheck="false" placeholder="搜索课程名称">
          </div>
        </div>

        <% if (packages && packages.length > 0) { %>
        <div class="pkg-grid" id="mainPkgGrid">
          <% packages.forEach(p => { %>
          <div class="pkg-card" onclick="showChildren('<%= p.id %>')" data-id="<%= p.id %>" data-province="<%= p.province||'' %>" data-title="<%= p.title||'' %>" data-year="<%= p.year||'' %>" data-type="<%= (function(){ var _t=p.class_type||''; return (_t==='公开课'||_t==='免费课'||_t==='公共课') ? '公开课' : (['专项提升','专项提升课','专项集训','专项集训课','冲刺密训','押题密训课'].includes(_t) ? '专项提升' : '系统学习') })() %>">
            <div class="pkg-top">
              <div class="pkg-tags">
                <span><%= p.province||'全国' %></span>
                <span><%= p.year||'' %>年</span>
                <span><%= p.exam_type || '专升本' %></span>
              </div>
              <h3><%= p.title %></h3>
            </div>
            <div class="pkg-body">
              <div class="pkg-start"><b>课时：</b><%= p.total_hours || 0 %><%= p.total_hours_plus ? '+' : '' %></div><div class="pkg-start"><b>开课：</b><%= p.start_date || '待定' %><% if (p.end_date) { %> ~ <%= p.end_date %><% } %></div>
              <div class="pkg-desc"><%= p.description ? p.description.substring(0,70)+(p.description.length>70?'...':'') : '系统化课程包，多门系列课组合学习。' %></div>
            </div>
            <div class="pkg-foot">
              <span class="go pkg-price">
                <% if (p.price) { %>
                  <span class="now">¥<%= Number(p.price).toFixed(2) %></span>
                  <% if (p.sale_price && Number(p.sale_price) < Number(p.price)) { %><span class="old">¥<%= Number(p.sale_price).toFixed(2) %></span><% } %>
                <% } else if (p.sale_price) { %>
                  <span class="now">¥<%= Number(p.sale_price).toFixed(2) %></span>
                <% } else { %>
                  <span class="none">价格面议</span>
                <% } %>
              </span>
              <span><%= (p.student_count||0) %> 人报名</span>
            </div>
          </div>
          <% }) %>
        </div>
        <% } %>

        <div id="filterEmpty" class="empty" style="display:none"><h3>该省份暂无课程</h3></div>

        <div class="pkg-grid" id="childrenGrid" style="display:none"></div>

        <div id="packageDetailView" style="display:none">
          <div id="embeddedCourseDetail"></div>
          <div id="packageDetailContent"></div>
        </div>

        <div id="courseDetailView" style="display:none">
          <div id="courseDetailContent"></div>
        </div>

        <% if (!packages || packages.length === 0) { %>
        <div class="empty">
