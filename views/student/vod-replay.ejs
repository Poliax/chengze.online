<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { background:#2B2F36; color:#fff; font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei","Helvetica Neue",Arial,sans-serif; min-height:100vh; }
    .topbar { display:flex; align-items:center; gap:12px; height:64px; padding:0 20px; border-bottom:1px solid rgba(255,255,255,.28); background:#2B2F36; backdrop-filter:blur(12px); }
    .topbar .brand { display:inline-flex; align-items:center; gap:10px; font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif; color:#fff; text-decoration:none; font-size:22px; font-weight:400; line-height:1; letter-spacing:.5px; white-space:nowrap; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; }
    .topbar .brand svg { width:28px; height:28px; flex:none; }
    .topbar .brand .brand-tag { font-size:11px; font-weight:400; color:rgba(255,255,255,.55); letter-spacing:1px; margin-left:2px; }
    .badge { background:#6366f1; color:#fff; font-size:12px; font-weight:700; padding:3px 8px; border-radius:4px; }
    .course { font-size:15px; font-weight:600; }
    .back { margin-left:auto; color:rgba(255,255,255,.6); text-decoration:none; font-size:13px; }
    .wrap { max-width:1200px; margin:24px auto; padding:0 20px; display:flex; gap:18px; align-items:stretch; }
    .player-col { flex:1; min-width:0; display:flex; flex-direction:column; justify-content:center; }
    video { width:100%; aspect-ratio:16/9; background:#000; border-radius:10px; box-shadow:0 24px 60px rgba(0,0,0,.55); border:1px solid rgba(255,255,255,.1); }
    .no-video { width:100%; aspect-ratio:16/9; background:#000; border-radius:10px; border:1px solid rgba(255,255,255,.1); display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,.45); font-size:14px; }
    .chat-col { width:280px; display:flex; flex-direction:column; background:#2B2F36; border:1px solid rgba(255,255,255,.1); border-radius:12px; overflow:hidden; backdrop-filter:blur(10px); }
    .chat-hd { padding:10px 14px; font-size:13px; font-weight:600; border-bottom:1px solid rgba(255,255,255,.08); color:rgba(255,255,255,.85); }
    .chat-msgs { flex:1; overflow-y:auto; padding:12px 14px; }
    .chat-msg { margin-bottom:10px; font-size:12px; }
    .chat-msg .head { display:flex; align-items:baseline; gap:8px; margin-bottom:2px; }
    .chat-msg .who { color:#7aa2ff; font-weight:600; font-size:11px; }
    .chat-msg .time { color:rgba(255,255,255,.35); font-size:10px; }
    .chat-msg .txt { display:block; color:rgba(255,255,255,.9); line-height:1.5; font-size:12px; }
    .empty { color:rgba(255,255,255,.35); font-size:12px; text-align:center; padding:30px 0; }
    @media (max-width:900px) { .wrap { flex-direction:column; } .chat-col { width:100%; min-height:260px; } }
  </style>
<%- include('../partials/playback-assets') %><%- include('../partials/brand-icons') %><link rel="stylesheet" href="/public/css/student-viewer-avatar.css?v=20261021-avatar1">
<link rel="stylesheet" href="/public/css/player-themes.css?v=20261027-theme1">
<script src="/js/player-theme.js?v=20261027-theme1"></script>
</head>
<body>
  <div class="topbar">
    <span class="brand"><%- include('../partials/playback-brand') %></span><div class="playback-course-group"><span class="playback-course-title"><%= replay.title %></span><span class="playback-kind">课程回放</span></div>
    <button type="button" class="player-theme-toggle" data-player-theme-toggle aria-pressed="false" aria-label="切换为日间模式"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg><span>夜间</span></button>
    <%- include('../partials/student-viewer-avatar') %>
  </div>
  <div class="wrap">
    <div class="player-col">
      <% if (replay.video_url && replay.video_url !== '') { %>
      <video id="player" controls playsinline autoplay></video>
      <% } else { %>
      <div class="no-video"><%= typeof playbackUnavailable !== 'undefined' && playbackUnavailable ? playbackUnavailable : '回放视频暂未生成。' %></div>
      <% } %>
    </div>
    <div class="chat-col">
      <div class="chat-hd">课堂互动</div>
      <div class="chat-msgs" id="chatMsgs"></div>
    </div>
  </div>
  <script src="/player/hls.min.js"></script>
  <script src="/player/flv.min.js"></script>
  <script>
    var videoUrl = <%- jsonForScript(replay.video_url || '') %>;
    var video = document.getElementById('player');
    if (video && videoUrl) {
      if (videoUrl.indexOf('.m3u8') > -1) {
        if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = videoUrl;
        } else if (window.Hls && Hls.isSupported()) {
          var hls = new Hls();
          hls.loadSource(videoUrl);
          hls.attachMedia(video);
        } else {
          video.src = videoUrl;
        }
      } else if (videoUrl.indexOf('.flv') > -1 && window.flvjs && flvjs.isSupported()) {
        var flvPlayer = flvjs.createPlayer({ type: 'flv', url: videoUrl });
        flvPlayer.attachMediaElement(video);
        flvPlayer.load();
        flvPlayer.play();
      } else {
        video.src = videoUrl;
      }
      video.play().catch(function(){});
    }
    var chatLog = <%- JSON.stringify((function(){ try { return JSON.parse(replay.chat_log || '[]'); } catch(e){ return []; } })()) %>;
    (function(){
      var box = document.getElementById('chatMsgs');
      if (!box) return;
      function fmt(t) {
        try { var d = new Date(String(t).replace(' ', 'T') + 'Z'); var p = function(n){ return (n<10?'0'+n:''+n); }; return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate())+' '+p(d.getHours())+':'+p(d.getMinutes()); } catch(e){ return ''; }
      }
      if (!chatLog || chatLog.length === 0) {
        box.innerHTML = '<div class="empty">本次课堂暂无聊天记录</div>';
        return;
      }
      chatLog.forEach(function(m) {
        var div = document.createElement('div');
        div.className = 'chat-msg';
        var head = document.createElement('div');
        head.className = 'head';
        var who = document.createElement('span');
        who.className = 'who';
        who.textContent = m.sender || '学生';
        var tm = document.createElement('span');
        tm.className = 'time';
        tm.textContent = fmt(m.created_at);
        var txt = document.createElement('span');
        txt.className = 'txt';
        txt.textContent = m.content || '';
        head.appendChild(who); head.appendChild(tm);
        div.appendChild(head); div.appendChild(txt);
        box.appendChild(div);
      });
    })();
  </script>
</body>
</html>
