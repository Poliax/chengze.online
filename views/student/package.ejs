<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background:#f8fafc; font-family:'Noto Sans SC','PingFang SC',sans-serif; color:#0f172a; }
    .container { max-width:1040px; margin:0 auto; padding:24px; }
    .pkg-hd { margin-bottom:24px; }
    .pkg-hd h1 { font-size:22px; font-weight:800; margin-bottom:6px; }
    .pkg-hd .meta { font-size:13px; color:#94a3b8; display:flex; gap:12px; flex-wrap:wrap; }
    .back { color:#64748b; text-decoration:none; font-size:13px; display:inline-block; margin-bottom:12px; }
    .back:hover { color:#2563eb; }
    .item-list { list-style:none; padding:0; margin:0; }
    .item-card { display:flex; align-items:center; gap:14px; padding:14px 18px; background:#fff; border:1px solid #e2e8f0; border-radius:10px; margin-bottom:8px; transition:box-shadow .15s; text-decoration:none; color:inherit; }
    .item-card:hover { box-shadow:0 2px 8px rgba(0,0,0,.06); }
    .child-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:14px; margin-bottom:16px; }
    .child-card { background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:16px 18px; text-decoration:none; color:inherit; display:flex; flex-direction:column; transition:box-shadow .15s,transform .15s; }
    .child-card:hover { box-shadow:0 6px 18px rgba(15,23,42,.08); transform:translateY(-2px); }
    .child-card h4 { margin:0 0 6px; font-size:15px; font-weight:700; }
    .child-card .meta { font-size:12px; color:#94a3b8; display:flex; gap:10px; flex-wrap:wrap; margin-bottom:10px; }
    .child-price { display:flex; align-items:baseline; gap:8px; margin-top:auto; }
    .child-price .now { font-size:20px; font-weight:800; color:#111827; text-decoration:line-through; }
    .child-price .old { font-size:14px; color:#dc2626; text-decoration:none; }
    .child-price .none { font-size:13px; color:#94a3b8; }
    .child-teacher { display:flex; align-items:flex-start; flex-wrap:wrap; gap:12px; margin-bottom:10px; font-size:12px; color:#64748b; }
    .child-teacher-item { display:inline-flex; flex-direction:column; align-items:center; gap:5px; width:50px; text-align:center; }
    .child-avatar { width:42px; height:42px; border-radius:50%; background:linear-gradient(135deg,#881538,#a3173f); color:#fff; display:inline-flex; align-items:center; justify-content:center; font-size:17px; font-weight:700; overflow:hidden; }
    .child-card .go { margin-top:12px; color:#2563eb; font-size:13px; font-weight:600; text-align:right; }
    .item-icon { width:40px; height:40px; border-radius:8px; background:#eff6ff; color:#2563eb; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
    .item-info { flex:1; min-width:0; }
    .item-name { font-weight:600; font-size:15px; }
    .item-meta { font-size:12px; color:#94a3b8; display:flex; gap:10px; margin-top:2px; flex-wrap:wrap; }
    .empty { text-align:center; padding:40px; color:#94a3b8; }
    .table-wrap { background:#fff; border:1px solid #e2e8f0; border-radius:10px; overflow-x:auto; margin-top:16px; }
    table { width:100%; border-collapse:collapse; }
    th { text-align:left; background:#eef2f6; padding:10px 12px; font-size:12px; font-weight:700; color:#111827; border-bottom:1px solid #d4dae2; }
    td { padding:9px 12px; font-size:13px; border-bottom:1px solid #eef2f7; color:#334155; }
    tr:last-child td { border-bottom:none; }
    .buy-box { display:flex; align-items:center; gap:16px; background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:16px 18px; margin:18px 0; }
    .buy-price { font-size:22px; font-weight:800; color:#dc2626; }
    .buy-price small { font-size:12px; color:#94a3b8; font-weight:400; margin-left:6px; }
    .buy-btn { margin-left:auto; background:#2563eb; color:#fff; border:none; border-radius:8px; padding:10px 22px; font-size:14px; font-weight:600; cursor:pointer; font-family:inherit; text-decoration:none; display:inline-block; }
    .buy-btn:hover { background:#1d4ed8; }
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,.45); z-index:200; align-items:center; justify-content:center; }
    .modal-overlay.open { display:flex; }
    .modal-box { background:#fff; border-radius:10px; padding:22px; width:400px; max-width:92vw; box-shadow:0 24px 64px rgba(0,0,0,.22); box-sizing:border-box; }
    .modal-box h3 { margin:0 0 14px; font-size:15px; font-weight:700; }
    .tabs { display:flex; gap:4px; margin-bottom:14px; }
    .tabs button { flex:1; padding:8px 0; border:1px solid #d1d5db; background:#fff; border-radius:7px; font-size:13px; cursor:pointer; font-family:inherit; }
    .tabs button.active { background:#2563eb; color:#fff; border-color:#2563eb; }
    .field { margin-bottom:10px; }
    .field label { display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px; }
    .field input { width:100%; box-sizing:border-box; padding:8px 10px; border:1px solid #d1d5db; border-radius:6px; font-size:13px; font-family:inherit; }
    .code-row { display:flex; gap:8px; }
    .code-row input { flex:1; }
    .modal-actions { display:flex; gap:8px; justify-content:flex-end; margin-top:14px; }
    .modal-actions button { height:32px; padding:0 14px; border-radius:6px; font-size:12px; font-weight:600; cursor:pointer; font-family:inherit; }
    .modal-actions .cancel { background:#fff; border:1px solid #cbd5e1; color:#64748b; }
    .modal-actions .primary { background:#2563eb; border:none; color:#fff; }
    .auth-tip { font-size:12px; color:#94a3b8; margin-top:8px; min-height:16px; }
  </style>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-round.png?v=20261015-green9"><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon-green-v9.ico"></head>
<body>
  <div class="container">
    <a href="/live/student" class="back">&larr; 返回课程列表</a>
    <div class="pkg-hd">
      <h1><%= pkg.title %></h1>
      <p style="color:#64748b;font-size:14px;margin:0 0 8px"><%= pkg.description %></p>
      <div class="meta"><%= pkg.year || '--' %>年 · <%= pkg.province || '--' %> · <%= (function(){ var _t=(pkg.class_type||'').trim(); return (_t==='公开课'||_t==='免费课'||_t==='公共课') ? '公开课' : '系统课'; })() %></div>
    </div>

    <% if (children.length === 0 && courses.length > 0) { %>
    <div class="buy-box">
      <div class="buy-price">¥<%= Number(pkg.sale_price || pkg.price || 0).toFixed(2) %><small>系统课价格</small></div>
      <% if (typeof enrolled !== 'undefined' && enrolled) { %>
      <a class="buy-btn" href="/live/student">已购，去学习</a>
      <% } else { %>
      <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px;margin-left:auto">
        <div style="display:flex;gap:8px">
          <a class="buy-btn" href="<%= (typeof trialUrl !== 'undefined' && trialUrl) || ('/live/student/courses/' + (courses[0] ? courses[0].id : '')) %>" style="background:#f1f5f9;color:#2563eb">试听课程</a>
          <button class="buy-btn" id="buyBtn" onclick="startBuy()">立即购买</button>
        </div>
        <label style="font-size:11px;color:#64748b;cursor:pointer"><input type="checkbox" id="agreeTerms" style="margin-right:4px">我已阅读并同意<a href="/live/student/policy" target="_blank" rel="noopener" style="color:#2563eb">《用户协议》《隐私政策》《退款说明》</a></label>
      </div>
      <% } %>
    </div>
    <% } %>

    <% if (children.length > 0) { %>
      <h3 style="font-size:15px;margin-bottom:12px">系统课</h3>
      <div class="child-grid">
        <% children.forEach(c => { %>
        <a href="/packages/<%= c.id %>" class="child-card">
          <h4><%= c.title %></h4>
          <% var tNames = (c.teachers && c.teachers.length) ? c.teachers : (c.teacher_name ? [c.teacher_name] : []); %>
          <% if (tNames.length) { %><div class="child-teacher"><% tNames.forEach(function(n, i){ var _av = (c.teacher_avatars && c.teacher_avatars[i]) ? '<img src="' + c.teacher_avatars[i] + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%" alt="">' : n.charAt(0); %><span class="child-teacher-item"><span class="child-avatar"><%= _av %></span><span><%= n %></span></span><% }); %></div><% } %>
          <div class="meta"><span><%= c.display_student_count || 0 %>人报名</span><span><%= (function(){ var _t=(c.class_type||'').trim(); return (_t==='公开课'||_t==='免费课'||_t==='公共课') ? '公开课' : '系统课'; })() %></span></div>
          <div class="child-price">
            <% if (c.price) { %>
              <span class="now" style="text-decoration:line-through">¥<%= Number(c.price).toFixed(2) %></span>
              <% if (c.sale_price && Number(c.sale_price) < Number(c.price)) { %><span class="old">¥<%= Number(c.sale_price).toFixed(2) %></span><% } %>
            <% } else if (c.sale_price) { %>
              <span class="now">¥<%= Number(c.sale_price).toFixed(2) %></span>
            <% } else { %>
              <span class="none">价格面议</span>
            <% } %>
          </div>
          <span class="go">查看 →</span>
        </a>
        <% }) %>
      </div>
    <% } else { %>
      <h3 style="font-size:15px;margin-bottom:12px">包含科目（<%= courses.length %>）</h3>
      <% if (courses.length === 0) { %><div class="empty">暂无课程</div><% } %>
      <div class="item-list">
        <% courses.forEach(c => { %>
        <a href="/live/student/courses/<%= c.id %>" class="item-card">
          <div class="item-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></div>
          <div class="item-info">
            <div class="item-name"><%= c.title %></div>
            <div class="item-meta"><span><%= c.lesson_count || 0 %>课时</span><span><%= c.teacher_name || '--' %></span></div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
        <% }) %>
      </div>

      <% if (scheduleRows && scheduleRows.length) { %>
      <h3 style="font-size:15px;margin:22px 0 0">课表</h3>
      <div class="table-wrap">
        <table>
          <thead><tr><th>科目</th><th>课次</th><th>上课时间</th><th>入口</th></tr></thead>
          <tbody>
            <% scheduleRows.forEach(l => { %>
            <tr>
              <td><%= l.course_title || '-' %></td>
              <td><%= l.title || '-' %></td>
              <td><%= l.schedule_time || '待排课' %></td>
              <td><% if (l.video_url) { %><a href="/live/student/replay-duo/<%= l.course_id %>?lesson=<%= l.id %>&v=2" target="_blank" rel="noopener" style="color:#2563eb;text-decoration:none">观看回放</a><% } else { %><a href="/live/student/courses/<%= l.course_id %>" style="color:#2563eb;text-decoration:none">进入课程</a><% } %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    <% } %>
  </div>

  <div class="modal-overlay" id="authModal">
    <div class="modal-box">
      <h3>登录 / 注册</h3>
      <div class="tabs">
        <button type="button" id="tabLogin" class="active" onclick="switchAuth('login')">登录</button>
        <button type="button" id="tabRegister" onclick="switchAuth('register')">注册</button>
      </div>
      <div id="authLogin">
        <div class="field"><label>手机号</label><input id="loginPhone" placeholder="请输入手机号"></div>
        <div class="field"><label>密码</label><input id="loginPassword" type="password" placeholder="请输入密码"></div>
        <div class="modal-actions"><button class="cancel" onclick="closeModal('authModal')">取消</button><button class="primary" onclick="doLogin()">登录</button></div>
        <div class="auth-tip" id="authMsg"></div>
      </div>
      <div id="authRegister" style="display:none">
        <div class="field"><label>手机号</label><input id="regPhone" placeholder="请输入手机号"></div>
        <div class="field"><label>验证码</label><div class="code-row"><input id="regCode" placeholder="请输入验证码"><button class="btn" onclick="sendCode()">获取验证码</button></div></div>
        <div class="modal-actions"><button class="cancel" onclick="closeModal('authModal')">取消</button><button class="primary" onclick="doRegister()">注册并购买</button></div>
        <div class="auth-tip" id="authMsg2"></div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="payModal">
    <div class="modal-box">
      <h3>选择支付方式</h3>
      <p style="font-size:13px;color:#64748b;margin:0 0 12px" id="payAmount"></p>
      <div class="modal-actions">
        <button class="cancel" onclick="closeModal('payModal')">取消</button>
        <button class="primary" onclick="doPay('wechat')">微信支付</button>
        <button class="primary" onclick="doPay('alipay')">支付宝</button>
      </div>
    </div>
  </div>

  <script>
    var PACKAGE_ID = <%= pkg.id %>;
    var CURRENT_ORDER_ID = 0;
    function openModal(id){ var m=document.getElementById(id); if(m) m.classList.add('open'); }
    function closeModal(id){ var m=document.getElementById(id); if(m) m.classList.remove('open'); }
    function switchAuth(mode){
      document.getElementById('authLogin').style.display = mode === 'login' ? '' : 'none';
      document.getElementById('authRegister').style.display = mode === 'register' ? '' : 'none';
      document.getElementById('tabLogin').classList.toggle('active', mode === 'login');
      document.getElementById('tabRegister').classList.toggle('active', mode === 'register');
      document.getElementById('authMsg').textContent = '';
      document.getElementById('authMsg2').textContent = '';
    }
    function startBuy(){
      var agree = document.getElementById('agreeTerms');
      if (agree && !agree.checked) { alert('请先阅读并同意服务协议、隐私政策和退款说明'); return; }
      if (!<%= (typeof studentId !== 'undefined' && studentId) ? 'true' : 'false' %>) { openModal('authModal'); return; }
      createOrder();
    }
    function createOrder(){
      fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ package_id: PACKAGE_ID })
      }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.ok) { alert(d.error || '下单失败'); return; }
        CURRENT_ORDER_ID = d.order.id;
        document.getElementById('payAmount').textContent = '订单金额：¥' + Number(d.order.amount || 0).toFixed(2);
        openModal('payModal');
      }).catch(function(){ alert('下单请求失败'); });
    }
    function doPay(channel){
      fetch('/api/orders/' + CURRENT_ORDER_ID + '/pay', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ channel: channel })
      }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.ok) { alert(d.error || '支付失败'); return; }
        if (d.dev) { alert('开发模式：已模拟支付成功'); closeModal('payModal'); location.reload(); return; }
        alert('支付参数生成中，请稍后到我的订单查看');
      }).catch(function(){ alert('支付请求失败'); });
    }
    function sendCode(){
      var phone = document.getElementById('regPhone').value.trim();
      if (!phone) { alert('请输入手机号'); return; }
      fetch('/api/auth/send-code', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: phone })
      }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.success) { alert(d.error || '发送失败'); return; }
        if (d.devCode) alert('开发模式验证码：' + d.devCode);
        else alert('验证码已发送');
      }).catch(function(){ alert('发送失败'); });
    }
    function doRegister(){
      var phone = document.getElementById('regPhone').value.trim();
      var code = document.getElementById('regCode').value.trim();
      fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: phone, code: code })
      }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.success) { document.getElementById('authMsg2').textContent = d.error || '注册失败'; return; }
        closeModal('authModal');
        createOrder();
      }).catch(function(){ document.getElementById('authMsg2').textContent = '注册失败'; });
    }
    function doLogin(){
      var phone = document.getElementById('loginPhone').value.trim();
      var password = document.getElementById('loginPassword').value;
      fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phone: phone, password: password })
      }).then(function(r){ return r.json(); }).then(function(d){
        if (!d.success) { document.getElementById('authMsg').textContent = d.error || '登录失败'; return; }
        closeModal('authModal');
        createOrder();
      }).catch(function(){ document.getElementById('authMsg').textContent = '登录失败'; });
    }
  </script>
</body>
</html>
