    <div class="purchased-course-list">
    <% if (myList.length) { myList.forEach(function(c) {
      var detail = (typeof courseDetails !== 'undefined' && courseDetails || {})[c.id];
      var lessons = detail && detail.lessons || [];
      var total = Math.max(0, Number(c.lesson_count) || 0);
      var completed = Math.min(total, Math.max(0, Number(c.completed) || 0));
      var progress = Math.min(100, Math.max(0, Number(c.percent) || 0));
      var metadata = [c.province, c.year ? c.year + '年' : '', c.teacher_name].filter(Boolean);
    %>
    <details class="overview-course purchased-course" id="learningCourse<%= c.id %>">
      <summary>
        <div class="purchased-course-info"><div class="purchased-course-meta"><% metadata.forEach(function(text){ %><span><%= text %></span><% }); %></div><h4><%= c.title %></h4></div>
        <div class="purchased-progress"><div class="purchased-progress-label"><span>学习进度</span><strong><%= progress %><small>%</small></strong></div><div class="overview-progress" role="progressbar" aria-label="学习进度" aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100"><i style="width:<%= progress %>%"></i></div><span class="purchased-progress-count"><% if(total){ %>已完成 <%= completed %> / <%= total %> 课次<% } else { %>课次待安排<% } %></span></div>
        <span class="purchased-course-action"><span class="purchased-action-label">课程目录</span><span class="purchased-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span></span>
      </summary>
      <div class="purchased-lessons">
        <div class="purchased-lessons-heading"><span>课程目录</span><span><%= lessons.length %> 个课次</span></div>
        <% if (lessons.length) { lessons.forEach(function(l,index) { %>
        <div class="purchased-lesson">
          <span class="purchased-lesson-index" aria-hidden="true"><%= String(index+1).padStart(2,'0') %></span>
          <div class="purchased-lesson-info"><b><%= l.title %></b><span><%= String(l.schedule_time || '').replace('T', ' ').substring(0,16) || '时间待定' %></span></div>
          <% if (l.is_live) { %>
          <a class="purchased-live-link" href="/live/student/live-watch/<%= c.id %>" target="_blank" rel="noopener">进入直播</a>
          <% } else if (l.has_replay || l.hasVideo) { %>
          <a href="/live/student/replay-duo/<%= c.id %>?lesson=<%= l.id %>&amp;v=2" target="_blank" rel="noopener">观看回放</a>
          <% } else { %><span class="purchased-pending">暂无回放</span><% } %>
        </div>
        <% }); } else { %><div class="purchased-empty-lessons">课次正在安排中</div><% } %>
      </div>
    </details>
    <% }); } else { %><div class="purchased-empty"><span class="purchased-empty-icon" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><path d="M6 6h9v21H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Zm20 0h-9v21h9a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></span><strong>暂无已购课程</strong><p>报名课程后，可在这里查看课次、进入直播和观看回放。</p></div><% } %>
    </div>
