  <script>
    document.querySelectorAll('.faq-q').forEach(function(b){ b.addEventListener('click', function(){ this.closest('.faq-item').classList.toggle('open'); }); });
    function submitEnroll(form){
      var ok = true;
      form.querySelectorAll('[required]').forEach(function(el){
        var field = el.closest('.field');
        var valid = el.value && String(el.value).trim() !== '';
        if (el.name === 'phone') valid = /^1\d{10}$/.test(String(el.value||'').trim());
        if (field) field.classList.toggle('invalid', !valid);
        if (!valid) ok = false;
      });
      if (!ok) return false;
      alert('预约提交成功，课程顾问将在 1 个工作日内与您联系。');
      form.reset();
      return false;
    }
