<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>承泽教育 - 管理后台</title>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Noto Sans SC', system-ui, sans-serif;
      background: #f7f7f7;
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh;
    }
    .login-box {
      background: #fff; padding: 40px; border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.06);
      width: 340px; text-align: center;
    }
    .login-logo { margin-bottom: 16px; }
    .login-logo .logo-mark { display: block; margin: 0 auto 12px; }
    h1 { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 22px; font-weight: 400; line-height: 1; letter-spacing: .5px; margin-bottom: 8px; color: #1E1E1E; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
    p { font-size: 13px; color: #6b7280; margin-bottom: 24px; }
    input {
      width: 100%; padding: 12px 16px;
      border: 1px solid #d1d5db; border-radius: 6px;
      font-size: 14px; font-family: inherit;
      outline: none; margin-bottom: 16px;
    }
    input:focus { border-color: #A51C30; box-shadow: 0 0 0 3px rgba(165,28,48,.12); }
    button {
      width: 100%; padding: 12px; border: none; border-radius: 6px;
      background: #FFFFFF; color: #1E1E1E; border: 1px solid #E5E7EB; font-size: 14px; font-weight: 600;
      cursor: pointer; font-family: inherit;
    }
    button:hover { background: #F7F7F7; }
    .error { color: #dc2626; font-size: 13px; margin-bottom: 12px; }
  </style>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-round.png?v=20261015-green9"><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon-green-v9.ico"></head>
<body>
  <div class="login-box">
    <div class="login-logo"><svg class="logo-mark" width="28" height="28" viewBox="0 0 340 300" role="img" aria-label="承泽教育"><g transform="translate(-4.112999999999998,0) scale(1.15,1)" fill="#16423C"><g transform="translate(-23.04501671122989,-27.417098512700477) scale(1.1768883689839569) rotate(-90,130.28,150.751)" fill="#16423C"><g transform="translate(58.472,63.352) scale(.528,.4416)"><path d="M0 159.4036001950587 V136 A136 141.39886578449904 0 0 1 272 136 V215.06373702550277 L211.9054092171854 170.76277997795341 V136 A75.9054092171854 78.91866742807555 0 0 0 60.094590782814606 136 V200.55471855344743 Z" />
<path d="M0 173.3 L211.9054092171854 348.26776907840997 V187.58258597083147 L272 241 V419.2871559633028 Q272 427.2871559633028 266 422.3330275229358 L60.094590782814606 252.3193868848928 V429 Q60.094590782814606 435 54.094590782814606 435 H6 Q0 435 0 429 Z" transform="translate(0,35.07155753926529) scale(1,0.8293354864269329)" />
<path d="M60.094590782814606 222.91938688489282 L211.9054092171854 348.26776907840997 L211.9054092171854 377.66776907840995 L60.094590782814606 252.3193868848928 Z" fill="#C8A96A" transform="translate(0,35.07155753926529) scale(1,0.8293354864269329)" /></g></g></g></svg></div>
    <h1>承泽教育</h1>
    <p>日程管理后台</p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="post" action="/admin/login">
      <input type="password" name="password" placeholder="管理员密码" required>
      <button type="submit">登录</button>
    </form>
  </div>
</body>
</html>
