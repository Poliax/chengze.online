<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>日程管理 · 承泽教育</title>

  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Noto Sans SC', system-ui, sans-serif;
      background: #f2eee9; color: #1c1c1a;
      padding: 24px;
    }
    .container { max-width: 900px; margin: 0 auto; }
    .header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 24px;
    }
    h1 { font-size: 22px; color: #2d5f6e; }
    h1 small { font-size: 13px; color: #6b6763; font-weight: 400; }
    .logout-btn {
      padding: 8px 20px; border: 1px solid #e0d8d0; border-radius: 6px;
      background: #fff; cursor: pointer; font-size: 13px; font-family: inherit;
      color: #6b6763;
    }
    .logout-btn:hover { color: #dc2626; border-color: #dc2626; }
    .tabs { display: flex; gap: 4px; margin-bottom: 20px; flex-wrap: wrap; }
    .tab-btn {
      padding: 8px 18px; border-radius: 6px; border: 1px solid #e0d8d0;
      background: #fff; cursor: pointer; font-size: 13px; font-family: inherit;
      transition: all 0.2s;
    }
    .tab-btn.active { background: #2d5f6e; color: #fff; border-color: #2d5f6e; }
    .editor { display: none; }
    .editor.active { display: block; }
    .editor textarea {
      width: 100%; min-height: 300px;
      padding: 16px; border: 1px solid #e0d8d0; border-radius: 8px;
      font-family: 'Inter', monospace; font-size: 13px; line-height: 1.6;
      background: #fff; resize: vertical; outline: none;
    }
    .editor textarea:focus { border-color: #2d5f6e; }
    .actions { display: flex; gap: 10px; margin-top: 14px; align-items: center; }
    .save-btn {
      padding: 10px 28px; border: none; border-radius: 6px;
      background: #2d5f6e; color: #fff; font-size: 14px; font-weight: 600;
      cursor: pointer; font-family: inherit;
    }
    .save-btn:hover { background: #244f5c; }
    .save-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .nav-tabs { display: flex; gap: 4px; margin-bottom: 20px; }
  .nav-tab { padding: 10px 24px; border-radius: 6px; border: 1px solid #e0d8d0; background: #fff; cursor: pointer; font-size: 14px; font-family: inherit; transition: all 0.2s; font-weight: 500; }
  .nav-tab.active { background: #2d5f6e; color: #fff; border-color: #2d5f6e; }
  .nav-tab:hover:not(.active) { border-color: #2d5f6e; color: #2d5f6e; }
  .msg { font-size: 13px; color: #2d5f6e; }
    .hint {
      font-size: 12px; color: #999490; margin-top: 20px;
      line-height: 1.7; padding: 14px; background: #fff; border-radius: 8px;
    }
    .hint code { background: #f2eee9; padding: 1px 6px; border-radius: 3px; font-size: 12px; }
  </style>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body>
  <div class="container">
    <div class="header">
      <h1>📅 考试日程管理 <small>承泽教育</small></h1>
      <form method="post" action="/admin/logout">
        <button class="logout-btn" type="submit">退出登录</button>
      </form>
    </div>
    <div class="tabs" id="tabContainer"></div>
    <div id="editorContainer"></div>
    <div class="tabs" id="tabContainer"></div>
    <div id="editorContainer"></div>
    <div class="hint">
      <strong>格式说明：</strong><br>
      每个省份是一个数组，每个条目包含 <code>month</code>（月份）、<code>event</code>（事件名称）、<code>desc</code>（描述）。<br>
      修改后点击「保存」即可生效，前端自动读取最新数据。
    </div>
  </div>
  <div class="nav-tabs">
    <button class="nav-tab active" data-section="schedule">📅 考试日程</button>
    <button class="nav-tab" data-section="courses">📚 课程管理</button>
  </div>

  <script>
    const provinces = <%- JSON.stringify(provinces) %>;
    const names = <%- JSON.stringify(provinceNames) %>;
    let schedule = <%- schedule %>;
    let courseData = {};

    function render() {
      const tabContainer = document.getElementById('tabContainer');
      const editorContainer = document.getElementById('editorContainer');
      tabContainer.innerHTML = '';
      editorContainer.innerHTML = '';

      provinces.forEach((id, idx) => {
        const btn = document.createElement('button');
        btn.className = 'tab-btn' + (idx === 0 ? ' active' : '');
        btn.textContent = names[id];
        btn.onclick = () => switchTab(id);
        tabContainer.appendChild(btn);
      });

      switchTab(provinces[0]);
    }

    function switchTab(id) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(b => {
        if (b.textContent === names[id]) b.classList.add('active');
      });

      const data = schedule[id] || [];
      const container = document.getElementById('editorContainer');
      container.innerHTML = '';
      
      const editor = document.createElement('div');
      editor.className = 'editor active';
      editor.innerHTML = \`
        <textarea id="editorArea">\${JSON.stringify(data, null, 2)}</textarea>
        <div class="actions">
          <button class="save-btn" id="saveBtn">保存</button>
          <span class="msg" id="saveMsg"></span>
        </div>
      \`;
      container.appendChild(editor);

      document.getElementById('saveBtn').onclick = () => save(id);
    }

    async function save(id) {
      const btn = document.getElementById('saveBtn');
      const msg = document.getElementById('saveMsg');
      btn.disabled = true;
      msg.textContent = '保存中...';

      try {
        const newData = JSON.parse(document.getElementById('editorArea').value);
        schedule[id] = newData;
        const res = await fetch('/admin/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: JSON.stringify(schedule) })
        });
        const result = await res.json();
        if (result.success) {
          msg.textContent = '✅ 保存成功';
        } else {
          msg.textContent = '❌ ' + (result.error || '保存失败');
        }
      } catch(e) {
        msg.textContent = '❌ JSON 格式错误';
      }
      btn.disabled = false;
      setTimeout(() => { msg.textContent = ''; }, 3000);
    }

    render();
    initNavTabs();
  </script>
</body>
</html>
