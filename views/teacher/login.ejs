<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>管理后台</title>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1">
<link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1">
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  min-height: 100svh;
  display: grid;
  place-items: center;
  padding: 32px 20px;
  background: #fafaf9;
  color: #252a28;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}
.login-card {
  width: 100%;
  max-width: 304px;
  padding: 24px;
  background: #fff;
  border: 1px solid #e8ebe8;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(25, 39, 32, .035);
}
.login-header { text-align: center; margin-bottom: 20px; }
.login-header img { display: block; width: 64px; height: 64px; margin: 0 auto 12px; }
h1 { margin: 0; font-size: 19px; line-height: 1.4; font-weight: 600; letter-spacing: .5px; }
.field { margin-bottom: 12px; }
label { display: block; margin-bottom: 6px; font-size: 13px; line-height: 1.5; font-weight: 500; }
input {
  width: 100%;
  height: 36px;
  padding: 0 10px;
  border: 1px solid #dfe4df;
  border-radius: 8px;
  background: #fff;
  color: #252a28;
  font: inherit;
  font-size: 13px;
  outline: none;
}
input::placeholder { color: #a1a8a3; font-size: 13px; }
input:focus { border-color: #28554a; box-shadow: 0 0 0 3px rgba(40, 85, 74, .08); }
button {
  display: block;
  width: 112px;
  height: 36px;
  margin: 16px auto 0;
  padding: 0 16px;
  border: 0;
  border-radius: 8px;
  background: #252a28;
  color: #fff;
  font: inherit;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
}
button:hover { background: #16423c; }
button:focus-visible { outline: 3px solid #b7cec5; outline-offset: 3px; }
.alert { margin: 0 0 20px; padding: 10px 12px; border-radius: 8px; background: #fff3f1; color: #a33a2e; font-size: 13px; line-height: 1.6; }
@media (max-width: 440px) { .login-card { padding: 24px; } }
</style>
</head>
<body>
<main class="login-card" aria-labelledby="loginTitle">
  <header class="login-header">
    <img src="/public/images/brand-green/app-rounded.svg?v=20261017-login-app3" alt="承泽在线" width="64" height="64">
    <h1 id="loginTitle">管理后台</h1>
  </header>
  <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
  <form method="POST" action="/admin/login">
    <div class="field">
      <label for="username">账号</label>
      <input id="username" name="username" placeholder="请输入账号" required autocomplete="username" autocapitalize="none" spellcheck="false">
    </div>
    <div class="field">
      <label for="password">密码</label>
      <input id="password" name="password" type="password" placeholder="请输入密码" required autocomplete="current-password">
    </div>
    <button type="submit">登录</button>
  </form>
</main>
</body>
</html>
