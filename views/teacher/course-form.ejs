<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title><%= title %></title>

<link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
<style>
body{background:#f1f5f9;font-family:'Noto Sans SC',sans-serif}
.container{max-width:500px;margin:40px auto;padding:0 16px}
h1{font-size:18px;font-weight:700;margin-bottom:20px;text-align:center;color:#1e293b}
.option{display:block;background:white;border:1px solid #e2e8f0;border-radius:12px;padding:20px;margin-bottom:12px;text-decoration:none;color:inherit;transition:box-shadow .15s,border-color .15s;cursor:pointer}
.option:hover{box-shadow:0 4px 12px rgba(0,0,0,.08);border-color:#2563eb}
.option .icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:8px;font-size:18px}
.option .name{font-weight:600;font-size:15px;margin-bottom:2px}
.option .desc{font-size:12px;color:#94a3b8}
.back{display:inline-block;margin-bottom:16px;color:#64748b;text-decoration:none;font-size:13px}
</style><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-round.png?v=20261015-green9"><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon-green-v9.ico"></head>
<body class="teacher-body"><%- include('partials/sidebar') %><div class="teacher-main"><%- include('partials/header') %>
<div class="container">
<h1>新建什么？</h1>

<a href="/admin/packages-manage/new" class="option">
  <div class="icon" style="background:#eff6ff;color:#2563eb">📦</div>
  <div class="name">课程包</div>
  <div class="desc">创建课程包（如：山东专升本全程班），可包含多个系列课</div>
</a>

<a href="/admin/courses-manage/new?type=series" class="option">
  <div class="icon" style="background:#f0fdf4;color:#16a34a">📚</div>
  <div class="name">系列课</div>
  <div class="desc">在课程包下创建系列课（如：大学英语），包含多节课时</div>
</a>

<a href="/admin/lessons/new" class="option" style="display:none" id="lessonOption">
  <div class="icon" style="background:#fef2f2;color:#dc2626">🎬</div>
  <div class="name">一节课</div>
  <div class="desc">在已有系列课下添加一节新课时</div>
</a>

<p style="text-align:center;color:#94a3b8;font-size:12px;margin-top:20px">选择要创建的内容类型</p>
</div></div></body></html>
