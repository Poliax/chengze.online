      document.getElementById("lessonOverlay").classList.add("open");
      if(window._fp){window._fp.destroy();}
      window._fp=flatpickr("#editDate",{enableTime:true,time_24hr:true,dateFormat:"Y-m-d H:i",locale:"zh"});
    };
      ls.appendChild(box);
      idx++;
    }
  }
}

function closeModal(){document.getElementById("lessonModal").classList.remove("open");document.getElementById("lessonOverlay").classList.remove("open")}
function saveLesson(){
  var box=window._editBox;if(!box)return;
  var name=document.getElementById("editName").value;
  if(name)box.childNodes[0].textContent=name;
  var subj=document.getElementById("editSubject").value;
  var tea=document.getElementById("editTeacher").value;
  if(subj)box.setAttribute("data-subject",subj);
  if(tea)box.setAttribute("data-teacher",tea);
  var date=document.getElementById("editDate").value;
  if(date){date=date.replace("T"," ");}
  var ex=box.querySelector(".lesson-date");
  if(date){
    if(ex)ex.textContent=date;
    else{var d=document.createElement("small");d.style.cssText="color:#2563eb;font-size:9px;margin-left:4px";d.className="lesson-date";d.textContent=date;box.appendChild(d);}
  }else{if(ex)ex.remove();}
  closeModal();
}
function syncRule(i,card){
  var days=[],times=[];
  card.querySelectorAll('.day-cell.active').forEach(function(cell){
    var wd=cell.getAttribute('data-wd');
    var t=cell.querySelector('.day-time');
    days.push(wd);
    times.push(t?t.value:'19:30');
  });
  var ri=document.getElementById('rule_'+i); if(ri) ri.value=days.join(',');
  var ti=document.getElementById('time_'+i); if(ti) ti.value=times.join(',');
}
var stageArea=document.getElementById('stageArea');
if(stageArea) stageArea.addEventListener('click',function(e){
  var btn=e.target.closest ? e.target.closest('.week-btn') : null;
  if(!btn) return;
  var card=btn.closest('.stage-card');
  if(!card) return;
  var i=parseInt(card.getAttribute('data-i'));
  var cell=btn.closest('.day-cell');
  if(!cell) return;
  var active=btn.classList.toggle('active');
  cell.classList.toggle('active',active);
  if(active){
    if(!cell.querySelector('.day-time')){
      var t=document.createElement('input');
      t.type='time';t.className='day-time';t.value='19:30';
      cell.appendChild(t);
    }
  } else {
    var inp=cell.querySelector('.day-time'); if(inp) inp.remove();
  }
  syncRule(i,card);
});
if(stageArea) stageArea.addEventListener('change',function(e){
  if(e.target.classList && e.target.classList.contains('day-time')){
    var card=e.target.closest('.stage-card');
    if(!card) return;
    var i=parseInt(card.getAttribute('data-i'));
    syncRule(i,card);
  }
});
renderStages();
updateAutoTitle();
</script>
<div class="modal-overlay" id="lessonOverlay"></div>
<div class="course-detail-modal" id="lessonModal">
  <div class="course-detail-modal__header">
    <div>
      <h3 class="course-detail-modal__title">编辑课程</h3>
      <p class="course-detail-modal__sub">编辑课程名称和上课时间</p>
    </div>
    <button class="course-detail-modal__close" onclick="closeModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="course-detail-modal__body">
    <div class="field" style="margin-bottom:14px">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">课程名称</label>
      <input id="editName" placeholder="如: 函数极限" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
    </div>
    <div class="field" style="margin-bottom:14px">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">科目</label>
      <select id="editSubject" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"><option value="">选择科目</option></select>
    </div>
    <div class="field" style="margin-bottom:14px">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">教师</label>
      <select id="editTeacher" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"><option value="">选择教师</option></select>
    </div>
    <div class="field">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">上课时间</label>
      <input id="editDate" type="datetime-local" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
    </div>
  </div>
  <div style="display:flex;gap:8px;justify-content:flex-end;padding:16px 24px;border-top:1px solid var(--color-border-light,#e2e8f0)">
    <button onclick="closeModal()" class="btn btn-outline">取消</button>
    <button onclick="saveLesson()" class="btn btn-primary">保存</button>
  </div>
</div>
<div class="modal-overlay" id="addPkgOverlay" style="position:fixed;inset:0;z-index:280;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center"></div>
<div class="course-detail-modal" id="addPkgModal" style="position:fixed;top:50%;left:50%;z-index:290;transform:translate(-50%,-50%);width:460px;max-width:92vw;background:#fff;border-radius:10px;box-shadow:0 24px 64px rgba(0,0,0,.18);display:none">
  <div class="course-detail-modal__header">
    <div>
      <h3 class="course-detail-modal__title">添加关联课程包</h3>
      <p class="course-detail-modal__sub">先选择一级课程包，再选择二级课程包。</p>
    </div>
    <button class="course-detail-modal__close" onclick="closeAddPkgModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="course-detail-modal__body">
    <div class="field" style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">一级课程包</label>
      <select id="addModalParent" onchange="onModalParentChange()" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"></select>
    </div>
    <div class="field">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">二级课程包</label>
      <select id="addModalChild" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"></select>
    </div>
  </div>
  <div style="display:flex;gap:8px;justify-content:flex-end;padding:16px 24px;border-top:1px solid var(--color-border-light,#e2e8f0)">
    <button onclick="closeAddPkgModal()" class="btn btn-outline">取消</button>
    <button onclick="confirmAddPkg()" class="btn btn-primary">添加</button>
  </div>
</div>
<div class="modal-overlay" id="pkgOverlay" style="position:fixed;inset:0;z-index:260;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center"></div>
<div class="course-detail-modal" id="pkgModal" style="position:fixed;top:50%;left:50%;z-index:270;transform:translate(-50%,-50%);width:420px;max-width:92vw;background:#fff;border-radius:10px;box-shadow:0 24px 64px rgba(0,0,0,.18);display:none">
  <div class="course-detail-modal__header">
    <div>
      <h3 class="course-detail-modal__title">新建课程包</h3>
      <p class="course-detail-modal__sub" id="pkgModalSub">一级课程包</p>
    </div>
    <button class="course-detail-modal__close" onclick="closePkgModal()">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="course-detail-modal__body">
    <input type="hidden" id="pkgParentId" value="0">
    <div class="field" id="pkgParentField" style="display:none;margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">所属一级课程包</label>
      <select id="pkgParentSel" onchange="onPkgParentChange()" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"></select>
    </div>
    <div class="field" style="margin-bottom:12px">
      <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">课程包名称</label>
      <input id="pkgTitle" placeholder="如：2027山东专升本卓越班" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
    </div>
    <div style="display:flex;gap:10px;margin-bottom:12px">
      <div class="field" style="flex:1">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">年份</label>
        <select id="pkgYear" style="width:100%;padding:9px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
          <option value="">选择年份</option>
          <% for(var _y=2026;_y<=2035;_y++){ %><option value="<%= _y %>"><%= _y %>年</option><% } %>
        </select>
      </div>
      <div class="field" style="flex:1">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">省份</label>
        <select id="pkgProvince" style="width:100%;padding:9px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
          <option value="">选择省份</option>
          <% (typeof provinceOptions !== 'undefined' ? provinceOptions : []).forEach(p=>{ %><option value="<%= p.name %>"><%= p.name %></option><% }) %>
        </select>
      </div>
    </div>
    <div style="display:flex;gap:10px;margin-bottom:12px">
      <div class="field" style="flex:1">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">课程类型</label>
        <select id="pkgClassType" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
          <option value="班课">系统学习</option>
          <option value="专项集训课">专项集训</option>
          <option value="押题密训课">冲刺密训</option>
          <option value="公开课">公开课（免费课）</option>
        </select>
      </div>
      <div class="field" style="flex:1">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">价格</label>
        <input id="pkgPrice" type="number" value="0" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
      </div>
    </div>
  </div>
  <div style="display:flex;gap:8px;justify-content:flex-end;padding:16px 24px;border-top:1px solid var(--color-border-light,#e2e8f0)">
    <button onclick="closePkgModal()" class="btn btn-outline">取消</button>
    <button onclick="savePkg()" class="btn btn-primary">保存</button>
  </div>
</div>
</body></html>
