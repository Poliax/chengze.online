ss="lessons" id="ls_'+i+'"></div>';
    wrap.appendChild(card);
    if(i===_stages.length-1){
      var addBar=document.createElement('div');addBar.className='stage-add';
      addBar.innerHTML='<button type="button" class="add-btn" title="添加阶段" onclick="addStage('+i+')">+</button>';
      wrap.appendChild(addBar);
    }
    area.appendChild(wrap);
  }
  sch();
}

