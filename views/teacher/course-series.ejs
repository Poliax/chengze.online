function examDateToInput(v){
  var s=String(v||'');
  var m=s.match(/(\d{4})年(\d{1,2})月(\d{1,2})日/);
  if(m) return m[1]+'-'+String(parseInt(m[2])).padStart(2,'0')+'-'+String(parseInt(m[3])).padStart(2,'0');
  var p=s.split('T')[0].split('-');
  if(p.length===3) return p[0]+'-'+p[1]+'-'+p[2];
  return '';
}
