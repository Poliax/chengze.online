// Stages
var stageLabels=['第一阶段','第二阶段','第三阶段','第四阶段','第五阶段','第六阶段'];
var _savedStages = <%- JSON.stringify(typeof stageData !== 'undefined' ? stageData : []) %>;
var _stages=[];
function cloneStage(s){
  return {
    name:(s&&s.name)||'',
    count:(s&&s.count)||30,
    duration:(s&&s.duration)||120,
    start:(s&&s.start)||'',
    end:(s&&s.end)||'',
    rule:(s&&s.rule)||'',
    time:(s&&s.time)||''
  };
}
if(_savedStages.length){
  _savedStages.forEach(function(s){_stages.push(cloneStage(s));});
} else {
  _stages.push(cloneStage({count:30,duration:120}));
}
function stageTitle(i){ return i < stageLabels.length ? stageLabels[i] : '第'+(i+1)+'阶段'; }
function countOptions(v){
  var h='';
  var val=Math.min(30,Math.max(1,parseInt(v)||30));
  for(var c=1;c<=30;c++){
    h+='<option value="'+c+'"'+(c===val?' selected':'')+'>'+c+'次</option>';
  }
  return h;
}
function durOptions(v){
  var h='';
  var val=[30,45,60,90,120].indexOf(parseInt(v))>-1?parseInt(v):120;
  [30,45,60,90,120].forEach(function(d){
    h+='<option value="'+d+'"'+(d===val?' selected':'')+'>'+d+'分钟</option>';
  });
  return h;
}
function weekHtml(rule,timeStr){
  var days=[['1','周一'],['2','周二'],['3','周三'],['4','周四'],['5','周五'],['6','周六'],['0','周日']];
  var r=String(rule||'').split(',').filter(Boolean);
  var tm={};
  String(timeStr||'').split(',').forEach(function(v,i){ if(r[i]) tm[r[i]]=v; });
  var h='';
  days.forEach(function(d){
    var on=r.indexOf(d[0])>-1;
    var t=on?(tm[d[0]]||'19:30'):'';
    h+='<span class="day-cell'+(on?' active':'')+'" data-wd="'+d[0]+'"><button type="button" class="week-btn'+(on?' active':'')+'" data-wd="'+d[0]+'">'+d[1]+'</button>'+(on?'<input type="time" class="day-time" data-wd="'+d[0]+'" value="'+esc(t)+'">':'')+'</span>';
  });
  return h;
}
function collectStageInputs(){
  for(var i=0;i<_stages.length;i++){
    var sn=document.getElementById('sn_'+i); if(sn) _stages[i].name=sn.value;
    var sc=document.getElementById('sc_'+i); if(sc) _stages[i].count=parseInt(sc.value)||0;
    var sd=document.getElementById('sd_'+i); if(sd) _stages[i].duration=parseInt(sd.value)||120;
    var s0=document.getElementById('sd_start_'+i); if(s0) _stages[i].start=s0.value;
    var s1=document.getElementById('sd_end_'+i); if(s1) _stages[i].end=s1.value;
    var rv=document.getElementById('rule_'+i); if(rv) _stages[i].rule=rv.value;
    var tm=document.getElementById('time_'+i); if(tm) _stages[i].time=tm.value;
  }
}
function addStage(i){
  collectStageInputs();
  _stages.splice(i+1,0,cloneStage({count:30,duration:120}));
  renderStages();
}
function delStage(i){
  if(_stages.length<=1) return;
  collectStageInputs();
  _stages.splice(i,1);
  renderStages();
}
function moveStage(i,d){
  if((i===0&&d<0)||(i===_stages.length-1&&d>0)) return;
  collectStageInputs();
  var st=_stages.splice(i,1)[0];
  _stages.splice(i+d,0,st);
  renderStages();
}
function renderStages(){
  var area=document.getElementById('stageArea');
