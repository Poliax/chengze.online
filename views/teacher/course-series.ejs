<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="UTF-8"><title><%= title %></title>

<link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
<style>
.add-btn{display:inline-flex;align-items:center;justify-content:center;gap:0;width:24px;height:24px;padding:0;background:linear-gradient(180deg,#ffffff,#f4f6f8);color:#111827;border:1px solid #d9dee7;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap;margin-top:6px;box-shadow:0 1px 2px rgba(15,23,42,.05), inset 0 1px 0 rgba(255,255,255,.9)}
.add-btn:hover{background:linear-gradient(180deg,#f8fafc,#e9edf2);border-color:#c3cad4;color:#000000;transform:translateY(-1px);box-shadow:0 2px 6px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.9)}
.del-btn{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;padding:0;border:1px solid #fecaca;background:linear-gradient(180deg,#ffffff,#fef2f2);color:#dc2626;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;box-shadow:0 1px 2px rgba(220,38,38,.06), inset 0 1px 0 rgba(255,255,255,.9)}
.del-btn:hover{background:linear-gradient(180deg,#fff7f7,#fee2e2);border-color:#fca5a5;color:#b91c1c;transform:translateY(-1px)}
.subj-row{display:flex;align-items:center;gap:6px;padding:8px;border:1px solid #e2e8f0;border-radius:6px;margin-bottom:6px;background:#f8fafc;flex-wrap:wrap}
.subj-row .subj-main{display:flex;align-items:center;gap:6px;flex:1;min-width:320px}
.subj-row select{padding:5px 7px;border:1px solid #cbd5e1;border-radius:5px;font-size:12px;outline:none;font-family:inherit;flex:1;min-width:0;background:#fff}
.row-move{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;padding:0;border:1px solid #d9dee7;background:linear-gradient(180deg,#ffffff,#f4f6f8);color:#111827;border-radius:6px;font-size:11px;cursor:pointer;font-family:inherit;line-height:1;box-shadow:0 1px 2px rgba(15,23,42,.05), inset 0 1px 0 rgba(255,255,255,.9)}
.row-move:hover{background:linear-gradient(180deg,#f8fafc,#e9edf2);border-color:#c3cad4;color:#000000;transform:translateY(-1px)}
#subjList{background:transparent;border:none;padding:0;margin:0}
.stage-wrap{display:flex;flex-direction:column;margin-bottom:10px}
.stage-add{display:flex;justify-content:flex-end;margin-top:6px}
.stage-add .add-btn{margin-top:0}
.add-row{display:flex;justify-content:flex-end;margin-top:6px}
.add-row .add-btn{margin-top:0}
.stage-card{flex:1;min-width:0;background:#fbfcfe;border:1px solid #e2e8f0;border-radius:8px;padding:14px 16px 12px}
.stage-card .hd{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:700;color:#0f172a;margin-bottom:12px}
.stage-index{display:inline-flex;align-items:center;justify-content:center;min-width:20px;height:20px;padding:0 5px;border-radius:6px;background:linear-gradient(180deg,#2563eb,#4f46e5);color:#fff;font-size:11px;font-weight:700}
.stage-card .row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:10px}
.stage-card .field{display:flex;align-items:center;gap:6px;min-width:0}
.stage-card .field span{flex-shrink:0;font-size:11px;font-weight:600;color:#475569;white-space:nowrap}
.stage-card .row input,.stage-card .row select,.stage-card .dates input{flex:1;min-width:0;width:auto;padding:7px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:12px;background:#fff;font-family:inherit;outline:none;transition:border-color .15s,box-shadow .15s}
.stage-card .row input:focus,.stage-card .row select:focus,.stage-card .dates input:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.stage-card .dates{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-bottom:10px}
.stage-card .dates label{display:flex;align-items:center;gap:6px;min-width:0;font-size:11px;font-weight:600;color:#475569}
.stage-card .dates label span{flex-shrink:0;white-space:nowrap}
.stage-card .rules{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.stage-card .rule-label{flex-shrink:0;font-size:11px;font-weight:600;color:#475569}
.stage-card .week-days{display:flex;gap:5px;flex-wrap:wrap}
.stage-card .day-cell{display:inline-flex;align-items:center;gap:4px}
.stage-card .day-cell .day-time{width:96px;min-width:96px;padding:5px 6px;border:1px solid #d1d5db;border-radius:5px;font-size:11px;background:#fff;font-family:inherit;outline:none}
.stage-card .week-btn{padding:5px 10px;border:1px solid #d1d5db;border-radius:6px;background:#fff;color:#475569;font-size:11px;cursor:pointer;transition:border-color .15s,color .15s,background .15s;font-family:inherit}
.stage-card .week-btn:hover{border-color:#2563eb;color:#2563eb}
.stage-card .week-btn.active{background:#2563eb;border-color:#2563eb;color:#fff}
.stage-actions{display:flex;gap:6px;margin-left:auto;flex-shrink:0}
.stage-actions .add-btn,.stage-actions .del-btn,.stage-actions .row-move{margin-top:0}
.stage-actions button:disabled{opacity:.38;cursor:not-allowed;transform:none}
.stage-card .lessons{display:flex;gap:6px;flex-wrap:wrap;padding:9px;background:#fff;border:1px dashed #dbe3ee;border-radius:7px;min-height:34px}
.stage-card .lessons:empty{display:none}
.stage-card .lessons span{padding:4px 10px;background:#fff;border:1px solid #dde3ec;border-radius:5px;font-size:11px;color:#334155;cursor:pointer;transition:border-color .15s,color .15s,background .15s}
.stage-card .lessons span:hover{border-color:#2563eb;color:#2563eb;background:#eff6ff}
@media (max-width:640px){.stage-card .row,.stage-card .dates{grid-template-columns:1fr}}
.modal-box{background:white;border-radius:10px;padding:20px;width:320px;box-shadow:0 10px 40px rgba(0,0,0,0.15)}
.modal-box h3{margin:0 0 14px;font-size:15px;font-weight:700;color:#0f172a}
.modal-box .field{margin-bottom:10px}
.modal-box .field label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:3px}
.modal-box .field input{width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:5px;font-size:13px;box-sizing:border-box}
.modal-actions{display:flex;gap:8px;margin-top:14px;justify-content:flex-end}
.modal-actions button{padding:7px 16px;border-radius:5px;font-size:13px;cursor:pointer;font-weight:500}
.modal-actions .btn-cancel{background:white;border:1px solid #d1d5db;color:#475569}
.modal-actions .btn-save{background:#2563eb;border:none;color:white}
body.modal-mode{background:#fff;display:block;overflow:auto}
body.modal-mode .teacher-main{background:#fff;min-height:auto}
body.modal-mode .teacher-content{padding:16px 20px;overflow:visible}
body.modal-mode .list-header{display:none}
body.modal-mode .form-card{max-width:none;box-shadow:none;background:transparent;border:0;padding:0;margin-bottom:14px}
body.modal-mode .form-card h3{display:none}
body.modal-mode .form-actions{display:none}
</style><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body class="teacher-body<% if (modal) { %> modal-mode<% } %>"><% if (typeof modal === 'undefined' || !modal) { %><%- include('partials/sidebar') %><% } %><div class="teacher-main"><% if (typeof modal === 'undefined' || !modal) { %><%- include('partials/header') %><% } %>
<div class="teacher-content">
<div class="list-header">
<h2><%= typeof editMode !== 'undefined' && editMode ? '编辑系列课' : '新建课程·新建系列课' %></h2>
</div>
<form method="POST" action="/admin/courses-manage<%= typeof editMode !== 'undefined' && editMode ? '/' + course.id + '/edit-series' : '' %>" id="seriesForm" class="staff-form" onsubmit="updateAutoTitle(); var ok=collectSubjects(); if(ok && window.parent && parent.closeSeriesModal) parent.closeSeriesModal(); return ok;">
<%
function parseYMD(v){
  if(!v) return {y:'',m:'',d:''};
  var s=String(v);
  if(s.indexOf('年')>-1){
    var p1=s.split('年');
    var p2=(p1[1]||'').split('月');
    var p3=(p2[1]||'').split('日');
    return {y:p1[0]||'',m:p2[0]||'',d:p3[0]||''};
  }
  var parts=s.split('-');
  return {y:parts[0]||'',m:parseInt(parts[1])||'',d:parseInt(parts[2])||''};
}
var sd=parseYMD(course?course.start_date:'');
var ed=parseYMD(course?course.valid_until:'');
function pad2(n){ return String(n==null||n===''?'':n).padStart(2,'0'); }
var _nowDate=new Date();
var sdVal=sd.y?sd.y+'-'+pad2(sd.m)+'-'+pad2(sd.d):_nowDate.getFullYear()+'-'+pad2(_nowDate.getMonth()+1)+'-'+pad2(_nowDate.getDate());
var edVal=ed.y?ed.y+'-'+pad2(ed.m)+'-'+pad2(ed.d):'';
%>

<div class="form-card">
<h3>关联课程包</h3>
<%
var _pkgSel = null;
var _pkgParent = null;
if (typeof packages !== 'undefined' && course) {
  for (var _pi=0;_pi<packages.length;_pi++) {
    if (String(packages[_pi].id) === String(course.package_id || '')) { _pkgSel = packages[_pi]; break; }
  }
}
if (_pkgSel && _pkgSel.parent_id && typeof packages !== 'undefined') {
  for (var _pj=0;_pj<packages.length;_pj++) {
    if (String(packages[_pj].id) === String(_pkgSel.parent_id)) { _pkgParent = packages[_pj]; break; }
  }
}
var _pkgIds = [];
if (typeof coursePackageIds !== 'undefined' && coursePackageIds) {
  for (var _pk=0;_pk<coursePackageIds.length;_pk++) {
    var _pidN = parseInt(coursePackageIds[_pk]) || 0;
    if (_pidN > 0 && _pkgIds.indexOf(_pidN) < 0) _pkgIds.push(_pidN);
  }
} else if (course && course.package_id) {
  var _pid0 = parseInt(course.package_id) || 0;
  if (_pid0 > 0) _pkgIds.push(_pid0);
}
var _pkgDefaultText = '未选择';
if (_pkgSel) {
  _pkgDefaultText = (_pkgParent ? _pkgParent.title + ' · ' : '') + _pkgSel.title;
}
var _autoProv = (_pkgSel && _pkgSel.province) || (course && course.province) || '';
var _autoYear = (_pkgSel && _pkgSel.year) || (course && course.year) || '';
var _autoExam = (_pkgSel && _pkgSel.exam_type) || (course && course.exam_type) || '专升本';
var _autoClass = (_pkgSel && _pkgSel.class_type) || (course && course.class_type) || (course && course.course_type === 'public' ? '公开课' : '班课');
var _autoClassRaw = (_autoClass === '公开课' || _autoClass === '免费课' || _autoClass === '公共课') ? '公开课' : (_autoClass === '专项集训课' ? '专项集训课' : (_autoClass === '押题密训课' ? '押题密训课' : '班课'));
var _autoClassText = _autoClassRaw === '公开课' ? '公开课（免费课）' : (_autoClassRaw === '专项集训课' ? '专项集训' : (_autoClassRaw === '押题密训课' ? '冲刺密训' : '系统学习'));
var _autoCourseType = _autoClassRaw === '公开课' ? 'public' : 'class';
%>
<input type="hidden" name="package_id" id="pkgId" value="<%= course ? (course.package_id || 0) : 0 %>">
<input type="hidden" name="package_ids" id="pkgIds" value="<%= _pkgIds.join(',') %>">
<div style="width:100%">
<div style="padding:8px;border:1px solid #e2e8f0;border-radius:6px;background:#f8fafc;box-sizing:border-box">
<div style="display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #e2e8f0;border-radius:6px;background:#fff;margin-bottom:6px"><span style="flex:1;min-width:0;font-size:12px;color:#334155;line-height:1.5"><%= _pkgDefaultText %></span></div>
<div id="pkgAssocList" style="display:none;flex-direction:column;gap:6px;margin-bottom:8px"></div>
</div>
<div style="display:flex;justify-content:flex-end;margin-top:6px"><button type="button" class="add-btn" title="添加课程包" onclick="openAddPkgModal()" style="margin-top:0">+</button></div>
</div>
</div>

<div class="form-card">
<h3>课程信息</h3>
<input type="hidden" name="title" id="autoTitle" value="<%= course ? course.title : '' %>">
<div class="form-grid">
<div class="form-group"><label>考试科目</label><select name="category" required onchange="filterTeacherBySubject()"><option value="">选择科目</option><% var _subjectVal = course ? (course.category || course.title) : ''; var _provSel = (typeof provinceOptions !== 'undefined' ? provinceOptions : []).find(function(p){ return course && course.province === p.name; }); var _subsSel = _provSel && _provSel.subjects && _provSel.subjects.length ? _provSel.subjects : [{name:'数学',standard:'数学'},{name:'英语',standard:'英语'},{name:'语文',standard:'语文'},{name:'计算机',standard:'计算机'},{name:'政治',standard:'政治'},{name:'管理学',standard:'管理学'},{name:'教育学',standard:'教育学'},{name:'医学',standard:'医学'},{name:'会计',standard:'会计'},{name:'经济学',standard:'经济学'},{name:'法学',standard:'法学'},{name:'艺术',standard:'艺术'},{name:'体育',standard:'体育'}]; _subsSel.forEach(function(s){ var _lb=s.name+(s.standard&&s.standard!==s.name?'（'+s.standard+'）':'')+(s.type?' · '+s.type:''); %><option value="<%= s.name %>" data-standard="<%= s.standard||s.name||'' %>" <%= _subjectVal===s.name?'selected':'' %>><%= _lb %></option><% }); if(_subjectVal && !_subsSel.some(function(s){return s.name===_subjectVal;})){ %><option value="<%= _subjectVal %>" data-standard="<%= _subjectVal %>" selected><%= _subjectVal %></option><% } %></select></div>
<div class="form-group"><label>授课教师</label><select name="teacher_id" required><option value="">选择教师</option><% (typeof teachers !== 'undefined' ? teachers : []).forEach(t=>{%><option value="<%=t.id%>" data-subject="<%= t.subject||'' %>" <%= course && course.teacher_id==t.id ? 'selected':'' %>><%=t.display_name%></option><%})%></select><input type="hidden" name="teaching_mode" value="<%= course ? course.teaching_mode||'' : '' %>"></div>
</div>
<div class="form-grid">
<div class="form-group"><label>招考省份</label><input type="text" name="province" readonly value="<%= _autoProv %>"></div>
<div class="form-group"><label>考试年份</label><input type="text" name="year" readonly value="<%= _autoYear %>"></div>
</div>
<div class="form-grid">
<div class="form-group"><label>考试类型</label><input type="text" name="exam_type" readonly value="<%= _autoExam %>"></div>
<div class="form-group"><label>课程类型</label><input type="text" readonly value="<%= _autoClassText %>"><input type="hidden" name="course_type" value="<%= _autoCourseType %>"><input type="hidden" name="class_type" value="<%= _autoClassRaw %>"></div>
</div>

</div>

<div class="form-actions">
<a href="/admin/courses-manage" class="btn btn-outline" onclick="if(window.parent && parent.closeSeriesModal){ event.preventDefault(); parent.closeSeriesModal(); }">取消</a>
<button type="submit" class="btn btn-primary">保存</button>
</div>
</form>
</div>
</div>

<script defer src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script defer src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/zh.js"></script>
<script>
// Province-driven subjects
var _provs = <%- JSON.stringify(typeof provinceOptions !== 'undefined' ? provinceOptions : []) %>;
var _editMode = <%- typeof editMode !== 'undefined' && editMode ? 1 : 0 %>;
var _courseYear = '<%= course ? (course.year||'') : '' %>';
var _courseTitle = <%- JSON.stringify(course ? (course.category||course.title||'') : '') %>;
var _teachers = <%- JSON.stringify(typeof teachers !== 'undefined' ? teachers : []) %>;
var _pkgData = <%- JSON.stringify(typeof packages !== 'undefined' ? packages : []) %>;
var _selectedPkgIds = <%- JSON.stringify(_pkgIds) %>;
function esc(v){ return String(v==null?'':v).replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function pkgList(level){ return (_pkgData||[]).filter(function(p){ return level===1 ? (!p.parent_id) : !!p.parent_id; }); }
function pkgById(id){ for(var i=0;i<_pkgData.length;i++){ if(parseInt(_pkgData[i].id)===parseInt(id)) return _pkgData[i]; } return null; }
function renderPkgAssoc(){
  var box=document.getElementById('pkgAssocList');
  var hidden=document.getElementById('pkgIds');
  var primary=document.getElementById('pkgId');
  if(!box) return;
  box.innerHTML='';
  box.style.display=_selectedPkgIds.length ? 'flex' : 'none';
  _selectedPkgIds.forEach(function(id){
    var p=pkgById(id);
    if(!p) return;
    var card=document.createElement('div');
    card.style.cssText='display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #e2e8f0;border-radius:6px;background:#f8fafc';
    var parent=pkgById(p.parent_id);
    var label=(parseInt(p.parent_id)||0) && parent ? parent.title + ' · ' + p.title : p.title;
    card.innerHTML='<span style="flex:1;min-width:0;font-size:12px;color:#334155;line-height:1.5">'+esc(label)+'</span><button type="button" class="del-btn" onclick="removePkg('+p.id+')" title="移除">×</button>';
    box.appendChild(card);
  });
  if(hidden) hidden.value=_selectedPkgIds.join(',');
  if(primary && _selectedPkgIds.length) primary.value=_selectedPkgIds[0];
}
function renderParentSelect(selected){
  var sel=document.getElementById('addPkgParent');
  if(!sel) return;
  var h='<option value="">选择一级课程包</option>';
  pkgList(1).forEach(function(p){
    h+='<option value="'+p.id+'"'+(parseInt(selected)===parseInt(p.id)?' selected':'')+'>'+esc(p.title)+'</option>';
  });
  sel.innerHTML=h;
}
function renderChildSelect(){
  var parent=document.getElementById('addPkgParent');
  var sel=document.getElementById('addPkgChild');
  if(!sel) return;
  var pid=parseInt(parent ? parent.value : 0)||0;
  var h='<option value="">选择二级课程包</option>';
  pkgList(2).filter(function(p){ return parseInt(p.parent_id)===pid; }).forEach(function(p){
    h+='<option value="'+p.id+'">'+esc(p.title)+'</option>';
  });
  sel.innerHTML=h;
}
function addSelectedPkg(){
  var sel=document.getElementById('addPkgChild');
  var id=parseInt(sel ? sel.value : 0)||0;
  if(!id){ alert('请选择二级课程包'); return; }
  if(_selectedPkgIds.indexOf(id)<0) _selectedPkgIds.push(id);
  renderPkgAssoc();
}
function removePkg(id){
  id=parseInt(id)||0;
  var i=_selectedPkgIds.indexOf(id);
  if(i>=0) _selectedPkgIds.splice(i,1);
  renderPkgAssoc();
}
function removeLastPkg(){
  if(!_selectedPkgIds.length){ alert('暂无关联课程包可删除'); return; }
  _selectedPkgIds.pop();
  renderPkgAssoc();
}
function openAddPkgModal(){
  var parentSel=document.getElementById('addModalParent');
  var childSel=document.getElementById('addModalChild');
  if(parentSel){
    var h='<option value="">选择一级课程包</option>';
    pkgList(1).forEach(function(p){
      h+='<option value="'+p.id+'">'+esc(p.title)+'</option>';
    });
    parentSel.innerHTML=h;
  }
  if(childSel) childSel.innerHTML='<option value="">选择二级课程包</option>';
  var overlay=document.getElementById('addPkgOverlay');
  var modal=document.getElementById('addPkgModal');
  if(overlay){ overlay.style.display='flex'; overlay.classList.add('open'); }
  if(modal){ modal.style.display='block'; modal.classList.add('open'); }
}
function closeAddPkgModal(){
  var overlay=document.getElementById('addPkgOverlay');
  var modal=document.getElementById('addPkgModal');
  if(overlay){ overlay.style.display='none'; overlay.classList.remove('open'); }
  if(modal){ modal.style.display='none'; modal.classList.remove('open'); }
}
function fillAddParentSelect(selected){
  var sel=document.getElementById('addModalParent');
  if(!sel) return;
  var h='<option value="">选择一级课程包</option>';
  pkgList(1).forEach(function(p){
    h+='<option value="'+p.id+'"'+(parseInt(selected)===parseInt(p.id)?' selected':'')+'>'+esc(p.title)+'</option>';
  });
  sel.innerHTML=h;
}
function onModalParentChange(){
  var parent=document.getElementById('addModalParent');
  var child=document.getElementById('addModalChild');
  if(!parent || !child) return;
  var pid=parseInt(parent.value)||0;
  var h='<option value="">选择二级课程包</option>';
  pkgList(2).filter(function(p){ return parseInt(p.parent_id)===pid; }).forEach(function(p){
    h+='<option value="'+p.id+'">'+esc(p.title)+'</option>';
  });
  child.innerHTML=h;
}
function confirmAddPkg(){
  var child=document.getElementById('addModalChild');
  var id=parseInt(child ? child.value : 0)||0;
  if(!id){ alert('请选择二级课程包'); return; }
  if(_selectedPkgIds.indexOf(id)<0) _selectedPkgIds.push(id);
  renderPkgAssoc();
  closeAddPkgModal();
}
function fillPkgParentSelect(selected){
  var sel=document.getElementById('pkgParentSel');
  if(!sel) return;
  var h='<option value="0">选择一级课程包</option>';
  pkgList(1).forEach(function(p){
    h+='<option value="'+p.id+'"'+(parseInt(selected)===parseInt(p.id)?' selected':'')+'>'+esc(p.title)+'</option>';
  });
  sel.innerHTML=h;
}
function onPkgParentChange(){
  var sel=document.getElementById('pkgParentSel');
  var id=parseInt(sel ? sel.value : 0)||0;
  var p=pkgById(id);
  if(p){
    document.getElementById('pkgYear').value=p.year||'';
    document.getElementById('pkgProvince').value=p.province||'';
    document.getElementById('pkgClassType').value=(p.class_type==='公开课'||p.class_type==='免费课'||p.class_type==='公共课')?'公开课':(p.class_type==='专项集训课'?'专项集训课':(p.class_type==='押题密训课'?'押题密训课':'班课'));
  }
