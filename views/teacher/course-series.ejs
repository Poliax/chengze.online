function savePkg(){
  var title=document.getElementById('pkgTitle').value.trim();
  if(!title){ alert('请输入课程包名称'); return; }
  var parentSel=document.getElementById('pkgParentSel');
  var parentId=parseInt(parentSel ? parentSel.value : 0)||0;
  if(pkgModalLevel===2 && !parentId){ alert('请先选择一级课程包'); return; }
  var data={
    title: title,
    year: document.getElementById('pkgYear').value,
    province: document.getElementById('pkgProvince').value,
    class_type: document.getElementById('pkgClassType').value,
    price: document.getElementById('pkgPrice').value||'0',
    parent_id: parentId,
    level: pkgModalLevel,
    status: 'draft'
  };
  fetch('/admin/packages-manage/api/create',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(data)
  }).then(function(r){ return r.json(); }).then(function(d){
    if(d && d.ok){
      _pkgData.push(d);
      if(_selectedPkgIds.indexOf(parseInt(d.id))<0) _selectedPkgIds.push(parseInt(d.id));
      renderParentSelect();
      renderChildSelect();
      renderPkgAssoc();
      closePkgModal();
    } else {
      alert((d && d.error) || '创建失败');
    }
  }).catch(function(){ alert('创建失败，请重试'); });
}
