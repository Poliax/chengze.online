<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/teacher.css?v=<%= cssVer %>">
<style>
  .user-form { max-width: 820px; }
  .form-card { border-color: #dbe3ef; box-shadow: 0 1px 3px rgba(15,23,42,.05); margin-bottom: 12px; }
  .form-card h3 { position: relative; margin-bottom: 10px; padding: 1px 0 6px 10px; border-bottom: 1px solid #eef2f7; font-size: 15px; font-weight: 800; color: #1e3a8a; letter-spacing: .5px; }
  .form-card h3::before { content:""; position:absolute; left:0; top:3px; bottom:7px; width:3px; border-radius:2px; background:#2563eb; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 48px; }
  .form-group { display: flex; align-items: center; gap: 4px; margin-bottom: 6px; }
  .form-group label { width: 72px; flex-shrink: 0; font-weight: 600; color: #111827; }
  .form-group input, .form-group select { flex: 0 1 260px; width: 260px; min-width: 0; padding: 7px 10px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 13px; font-family: inherit; outline: none; box-sizing: border-box; }
  .form-group input:focus, .form-group select:focus { border-color: #64748b; box-shadow: 0 0 0 2px rgba(100,116,139,.14); }
  .form-tip { font-size: 11px; color: #94a3b8; margin-top: 3px; }
  .error-box { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:8px 12px; border-radius:6px; margin-bottom:12px; font-size:13px; }
  .form-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
  @media (max-width:640px){ .form-grid { grid-template-columns: 1fr; } }
</style>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body class="teacher-body">
<%- include('partials/sidebar') %>
<div class="teacher-main">
<%- include('partials/header') %>
<div class="teacher-content">
  <div class="list-header">
    <h2><%= mode === 'student' ? '添加学员' : '添加用户' %></h2>
    <div class="list-tools">
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %><div class="error-box"><%= error %></div><% } %>
  <%
    function fv(k) {
      if (typeof formData !== 'undefined' && formData && formData[k] != null) return formData[k];
      return '';
    }
  %>

  <form method="POST" action="<%= mode === 'student' ? '/admin/students-manage/new' : '/admin/users-manage/new' %>" class="user-form">
    <div class="form-card">
      <h3>基本信息</h3>
      <div class="form-grid">
        <div class="form-group">
          <label>真实姓名</label>
          <input name="name" value="<%= fv('name') %>" placeholder="学员姓名" required>
        </div>
        <div class="form-group">
          <label>手机号</label>
          <input name="phone" value="<%= fv('phone') %>" placeholder="登录账号" required>
        </div>
        <div class="form-group">
          <label>登录密码</label>
          <input type="password" name="password" value="<%= fv('password') %>" placeholder="至少 6 位" required>
        </div>
        <div class="form-group">
          <label>考试年份</label>
          <select name="exam_year">
            <option value="">选择年份</option>
            <% for (var y = 2026; y <= 2035; y++) { %>
              <option value="<%= y %>" <%= String(fv('exam_year')) === String(y) ? 'selected' : '' %>><%= y %>年</option>
            <% } %>
          </select>
        </div>
        <% if (mode === 'student') { %>
        <div class="form-group" style="grid-column:1/-1">
          <label>选择课程</label>
          <select name="course_id" required style="flex:1 1 420px;width:420px">
            <option value="">选择课程</option>
            <% courses.forEach(c => { %>
              <option value="<%= c.id %>" <%= String(fv('course_id')) === String(c.id) ? 'selected' : '' %>><%= c.title %></option>
            <% }) %>
          </select>
        </div>
        <% } %>
      </div>
    </div>
    <div class="form-actions">
      <a href="<%= mode === 'student' ? '/admin/students-manage' : '/admin/users-manage' %>" class="btn btn-outline">取消</a>
      <button type="submit" class="btn btn-primary">保存</button>
    </div>
  </form>
</div>
</div>
</body>
</html>
