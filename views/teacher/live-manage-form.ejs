<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-round.png?v=20261015-green9"><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon-green-v9.ico"></head>
<body class="teacher-body">
<%- include('partials/sidebar') %>
<div class="teacher-main">
<%- include('partials/header') %>
<div class="teacher-content">
  <div class="list-header">
    <h2><%= stream ? '编辑直播配置' : '添加直播配置' %></h2>
    <div class="list-tools">
    </div>
  </div>

  <% if (!stream) { %>
  <div class="form-card live-form-card">
    <h3>一键生成</h3>
    <form method="POST" action="/admin/live-manage/autogen" class="staff-form">
      <div class="form-grid">
        <div class="form-group">
          <label>选择课程</label>
          <select name="course_id" id="autogenCourse" required>
            <option value="">请选择课程</option>
            <% courses.forEach(c => { %><option value="<%= c.id %>"><%= c.title %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">自动生成并保存</button>
        <button type="button" class="btn btn-outline" id="goStudioBtn">进入直播台</button>
      </div>
      <div class="hint">自动生成：流名称、推流服务器、带签名推流码、FLV 播放地址（有效期 24 小时）</div>
    </form>
  </div>
  <% } %>

  <div class="form-card live-form-card">
    <h3>手动配置</h3>
    <form method="POST" action="/admin/live-manage/save" class="staff-form">
      <div class="form-grid">
        <div class="form-group">
          <label>选择课程</label>
          <select name="course_id" required>
            <option value="">请选择课程</option>
            <% courses.forEach(c => { %><option value="<%= c.id %>" <%= stream && Number(stream.course_id) === Number(c.id) ? 'selected' : '' %>><%= c.title %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>流名称（StreamName）</label>
          <input name="stream_name" placeholder="如 UYMPIV" value="<%= stream ? stream.stream_name : '' %>">
        </div>
        <div class="form-group">
          <label>推流服务器（OBS 服务器）</label>
          <input name="push_server" placeholder="rtmp://push.chengze.online/live/" value="<%= stream ? stream.push_server : '' %>">
        </div>
        <div class="form-group">
          <label>推流码（OBS 推流码，含签名）</label>
          <input name="stream_key" placeholder="UYMPIV?txSecret=xxx&txTime=xxx" value="<%= stream ? stream.stream_key : '' %>">
        </div>
        <div class="form-group">
          <label>播放地址</label>
          <input name="play_url" placeholder="https://play.chengze.online/live/UYMPIV.flv" value="<%= stream ? stream.play_url : '' %>">
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">保存配置</button>
      </div>
    </form>
  </div>
</div>
</div>
<script>
  document.getElementById('goStudioBtn').addEventListener('click', function() {
    var sel = document.getElementById('autogenCourse');
    if (!sel.value) { sel.focus(); return; }
    location.href = '/admin/live/studio/' + sel.value;
  });
</script>
</body>
</html>
