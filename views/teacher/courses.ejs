    function renderPagination(total,totalPages){
      var box=document.getElementById('pkgPagination');
      if(!box) return;
      var h='<button type="button" class="page-btn" data-page="'+(Math.max(1,_page-1))+'" '+( _page<=1?'disabled':'')+'>上一页</button>';
      for(var i=1;i<=totalPages;i++) h+='<button type="button" class="'+(i===_page?'current':'page-btn')+'" data-page="'+i+'">'+i+'</button>';
      h+='<button type="button" class="page-btn" data-page="'+(Math.min(totalPages,_page+1))+'" '+( _page>=totalPages?'disabled':'')+'>下一页</button>';
      h+='<span class="info">共 '+total+' 条</span>';
      box.innerHTML=h;
