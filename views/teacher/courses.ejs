      document.getElementById('pkgFormId').value=editId;
      document.getElementById('pkgLevelWrap').style.display='none';
      document.getElementById('pkgFormParentLabel').textContent='所属一级课程包';
      document.getElementById('pkgFormTitle').value='';
      document.getElementById('pkgFormDescription').value='';
      document.getElementById('pkgFormExamType').value='专升本';
      document.getElementById('pkgFormSalePrice').value='';
      document.getElementById('pkgFormYear').value='';
      document.getElementById('pkgFormProvince').value='';
      document.getElementById('pkgFormClassType').value='班课';
      document.getElementById('pkgFormPrice').value='';
      document.getElementById('pkgFormStudentCount').value='';
      document.getElementById('pkgFormActualCount').value='0';
      document.getElementById('pkgFormStatus').value='archived';
      document.getElementById('pkgFormSort').value='';
      document.getElementById('pkgFormStartDate').value='';
      document.getElementById('pkgFormEndDate').value='';
      setInheritLocked(false);
      var p=null;
      if(editId){
        for(var ei=0;ei<_pkgData.length;ei++){ if(parseInt(_pkgData[ei].id)===editId){ p=_pkgData[ei]; break; } }
      }
      if(p){
        var lv=parseInt(p.parent_id)||0 ? 2 : 1;
        document.getElementById('pkgFormLevel').value=lv;
        document.getElementById('pkgParentWrap').style.display=lv===2?'':'none';
        document.getElementById('pkgModalTitle').textContent=lv===2?'编辑二级课程包':'编辑一级课程包';
        fillParentSelect(parseInt(p.parent_id)||0);
        document.getElementById('pkgFormParent').disabled = lv===1;
        document.getElementById('pkgFormTitle').value=p.title||'';
        document.getElementById('pkgFormDescription').value=p.description||'';
        document.getElementById('pkgFormExamType').value=p.exam_type||'专升本';
        document.getElementById('pkgFormSalePrice').value=p.sale_price||'';
        document.getElementById('pkgFormYear').value=p.year||'';
        document.getElementById('pkgFormProvince').value=p.province||'';
        var _ct=p.class_type||'';
        document.getElementById('pkgFormClassType').value=(_ct==='公开课'||_ct==='免费课'||_ct==='公共课')?'公开课':(_ct==='专项集训课'?'专项集训课':(_ct==='押题密训课'?'押题密训课':'班课'));
        document.getElementById('pkgFormPrice').value=p.price||'';
        document.getElementById('pkgFormStudentCount').value=p.student_count||'';
        document.getElementById('pkgFormActualCount').value=p.actual_student_count||0;
        document.getElementById('pkgFormStatus').value=(p.status==='published'?'published':'archived');
        document.getElementById('pkgFormSort').value=p.sort_order||'';
        document.getElementById('pkgFormStartDate').value=p.start_date||'';
        document.getElementById('pkgFormEndDate').value=p.end_date||'';
        if(lv===2) setInheritLocked(true);
      } else {
        document.getElementById('pkgParentWrap').style.display=_viewParentId ? '' : 'none';
        document.getElementById('pkgFormLevel').value=_viewParentId ? 2 : 1;
        document.getElementById('pkgModalTitle').textContent=_viewParentId ? '新建二级课程包' : '新建一级课程包';
        fillParentSelect(_viewParentId||0);
        document.getElementById('pkgFormParent').disabled=true;
        if(_viewParentId){
          var parent=null;
          for(var i=0;i<_pkgData.length;i++){ if(parseInt(_pkgData[i].id)===_viewParentId){ parent=_pkgData[i]; break; } }
          if(parent){
            document.getElementById('pkgFormProvince').value=parent.province||'';
            document.getElementById('pkgFormYear').value=parent.year||'';
            var ct=parent.class_type||'';
            document.getElementById('pkgFormClassType').value=(ct==='公开课'||ct==='免费课'||ct==='公共课')?'公开课':(ct==='专项集训课'?'专项集训课':(ct==='押题密训课'?'押题密训课':'班课'));
            document.getElementById('pkgFormExamType').value=parent.exam_type||'专升本';
            setInheritLocked(true);
          }
        }
      }
      document.getElementById('pkgOverlay').style.display='flex';
      document.getElementById('pkgOverlay').classList.add('open');
      var pkgDescWrap=document.getElementById('pkgDescWrap');
      if(pkgDescWrap) pkgDescWrap.style.display=(parseInt(document.getElementById('pkgFormLevel').value)||0)===1?'':'none';
      document.getElementById('pkgModal').style.display='flex';
      document.getElementById('pkgModal').classList.add('open');
    }
    function closePkgModal(){
      document.getElementById('pkgOverlay').style.display='none';
      document.getElementById('pkgOverlay').classList.remove('open');
      document.getElementById('pkgModal').style.display='none';
      document.getElementById('pkgModal').classList.remove('open');
    }
    function savePkgForm(){
      var title=document.getElementById('pkgFormTitle').value.trim();
      if(!title){ alert('请输入名称'); return; }
      var id=parseInt(document.getElementById('pkgFormId').value)||0;
      var p=null;
      if(id){
        for(var i=0;i<_pkgData.length;i++){ if(parseInt(_pkgData[i].id)===id){ p=_pkgData[i]; break; } }
      }
      var lv = p ? (parseInt(p.parent_id)||0 ? 2 : 1) : (_viewParentId ? 2 : 1);
      var parentId = p ? (lv===2 ? (parseInt(document.getElementById('pkgFormParent').value)||0) : 0) : (_viewParentId||0);
      var data={title:title, description:document.getElementById('pkgFormDescription').value, year:document.getElementById('pkgFormYear').value, province:document.getElementById('pkgFormProvince').value, class_type:document.getElementById('pkgFormClassType').value, exam_type:document.getElementById('pkgFormExamType').value, price:document.getElementById('pkgFormPrice').value||'', sale_price:document.getElementById('pkgFormSalePrice').value||'', student_count:document.getElementById('pkgFormStudentCount').value||0, status:document.getElementById('pkgFormStatus').value, parent_id:parentId, level:lv, sort_order:document.getElementById('pkgFormSort').value||0, start_date:document.getElementById('pkgFormStartDate').value, end_date:document.getElementById('pkgFormEndDate').value};
      if(id) data.id=id;
      var url=id ? '/admin/packages-manage/api/update' : '/admin/packages-manage/api/create';
      fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)}).then(function(r){ return r.json(); }).then(function(d){
        if(d && d.ok){
          if(id){
            for(var j=0;j<_pkgData.length;j++){
              if(parseInt(_pkgData[j].id)===id){
                _pkgData[j]=Object.assign({}, _pkgData[j], d, {child_count:_pkgData[j].child_count||0, course_count:_pkgData[j].course_count||0});
                break;
              }
            }
          } else {
            var parentTitle='';
            for(var k=0;k<_pkgData.length;k++){ if(parseInt(_pkgData[k].id)===parentId){ parentTitle=_pkgData[k].title; break; } }
            _pkgData.push(Object.assign({}, d, {child_count:0, course_count:0, parent_title:parentTitle}));
          }
          renderPkgList();
          closePkgModal();
        } else { alert((d && d.error) || '保存失败'); }
      }).catch(function(){ alert('保存失败，请重试'); });
    }
    renderPkgList();
    (function(){
      var hs=parseHashState();
      if(hs.course){
        loadCourses(parseInt(hs.course));
      } else if(hs.parent){
        _viewParentId=parseInt(hs.parent);
        renderPkgList();
      }
    })();
  </script>
  <div class="modal-overlay" id="seriesOverlay" style="position:fixed;inset:0;z-index:300;background:rgba(0,0,0,.45);display:none;align-items:center;justify-content:center"></div>
  <div class="course-detail-modal" id="seriesModal" style="position:fixed;top:50%;left:50%;z-index:310;transform:translate(-50%,-50%);width:560px;max-width:94vw;min-height:560px;max-height:96vh;background:#fff;border-radius:10px;box-shadow:0 24px 64px rgba(0,0,0,.22);display:none;flex-direction:column">
    <div class="course-detail-modal__header">
      <div>
        <h3 class="course-detail-modal__title">新建系列课</h3>
        <p class="course-detail-modal__sub">创建科目课</p>
      </div>
      <button class="course-detail-modal__close" onclick="closeSeriesModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="course-detail-modal__body" style="overflow-y:auto;flex:1">
      <form method="POST" action="/admin/courses-manage" id="seriesForm" onsubmit="event.preventDefault(); seriesUpdateTitle(); if(seriesCollectSubjects()){ saveSeriesModal(); } return false;">
        <input type="hidden" id="seriesCourseId" value="0">
        <input type="hidden" name="title" id="seriesAutoTitle" value="">
        <input type="hidden" name="package_id" id="seriesPkgId" value="0">
        <input type="hidden" name="package_ids" id="seriesPkgIds" value="">
        <div style="margin-bottom:12px">
          <div id="seriesDefaultPkg" style="display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #e2e8f0;border-radius:6px;background:#f8fafc;margin-bottom:6px;font-size:12px;color:#334155"></div>
          <div id="seriesAssocList" style="display:none;flex-direction:column;gap:6px;margin-bottom:8px"></div>
          <div style="display:flex;justify-content:flex-end"><button type="button" class="add-btn" title="添加课程包" onclick="seriesOpenAdd()" style="margin-top:0">+</button></div>
        </div>
        <div class="form-group"><label>考试科目</label><select name="category" id="seriesCategory" required onchange="seriesFilterTeacher()"><option value="">选择科目</option></select></div>
        <div class="form-group"><label>授课教师</label><select name="teacher_id" id="seriesTeacher"><option value="">选择教师</option></select><input type="hidden" name="teaching_mode" value=""></div>
        <div class="form-group"><label>招考省份</label><input type="text" name="province" id="seriesProvince" readonly></div>
        <div class="form-group"><label>考试年份</label><input type="text" name="year" id="seriesYear" readonly></div>
        <div class="form-group"><label>考试类型</label><input type="text" name="exam_type" id="seriesExamType" readonly></div>
        <div class="form-group"><label>课程类型</label><input type="text" id="seriesClassTypeText" readonly><input type="hidden" name="course_type" id="seriesCourseType" value="class"><input type="hidden" name="class_type" id="seriesClassType" value="班课"></div>
      </form>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 16px;border-top:1px solid var(--color-border-light,#e2e8f0);flex-shrink:0">
      <button onclick="closeSeriesModal()" class="btn btn-outline">取消</button>
      <button onclick="saveSeriesModal()" class="btn btn-primary">保存</button>
    </div>
  </div>
  <div class="modal-overlay" id="addSeriesOverlay" style="position:fixed;inset:0;z-index:320;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center"></div>
  <div class="course-detail-modal" id="addSeriesModal" style="position:fixed;top:50%;left:50%;z-index:330;transform:translate(-50%,-50%);width:440px;max-width:92vw;background:#fff;border-radius:10px;box-shadow:0 24px 64px rgba(0,0,0,.18);display:none;flex-direction:column">
    <div class="course-detail-modal__header">
      <div>
        <h3 class="course-detail-modal__title">添加关联课程包</h3>
        <p class="course-detail-modal__sub">先选择一级课程包，再选择二级课程包。</p>
      </div>
      <button class="course-detail-modal__close" onclick="seriesCloseAdd()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="course-detail-modal__body">
      <div class="field" style="margin-bottom:12px">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">一级课程包</label>
        <select id="addSeriesParent" onchange="seriesOnParentChange()" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"></select>
      </div>
      <div class="field">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">二级课程包</label>
        <select id="addSeriesChild" style="width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"></select>
      </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;padding:16px 24px;border-top:1px solid var(--color-border-light,#e2e8f0)">
      <button onclick="seriesCloseAdd()" class="btn btn-outline">取消</button>
      <button onclick="seriesConfirmAdd()" class="btn btn-primary">添加</button>
    </div>
  </div>
  <div class="modal-overlay" id="courseViewOverlay" style="position:fixed;inset:0;z-index:340;background:rgba(0,0,0,.4);display:none;align-items:center;justify-content:center"></div>
  <div class="course-detail-modal" id="courseViewModal" style="position:fixed;top:50%;left:50%;z-index:350;transform:translate(-50%,-50%);width:560px;max-width:94vw;min-height:420px;max-height:90vh;background:#fff;border-radius:10px;box-shadow:0 24px 64px rgba(0,0,0,.22);display:none;flex-direction:column">
    <div class="course-detail-modal__header">
      <div>
        <h3 class="course-detail-modal__title">课程详情</h3>
        <p class="course-detail-modal__sub">查看系列课信息</p>
      </div>
      <button class="course-detail-modal__close" onclick="closeCourseView()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="course-detail-modal__body" id="courseViewBody" style="overflow-y:auto;flex:1"></div>
    <div style="display:flex;gap:8px;justify-content:flex-end;padding:12px 16px;border-top:1px solid var(--color-border-light,#e2e8f0)">
      <button onclick="closeCourseView()" class="btn btn-outline">关闭</button>
    </div>
  </div>
</body>
</html>
