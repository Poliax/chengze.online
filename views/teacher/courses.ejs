    function loadCourses(id){
      _viewParentId=0;
      for(var i=0;i<_pkgData.length;i++){ if(parseInt(_pkgData[i].id)===parseInt(id)){ _viewParentId=parseInt(_pkgData[i].parent_id)||0; break; } }
      fetch('/admin/packages-manage/api/courses/'+id).then(function(r){ return r.json(); }).then(function(d){
        _courseCache[id]=(d && d.courses) || [];
        _viewCourseId=id; _page=1; saveHashState(); renderPkgList();
      }).catch(function(){ alert('加载课程失败'); });
    }

    function parseHashState(){
      var h=String(location.hash||'').replace(/^#/,'');
      var out={};
      h.split('&').forEach(function(pair){
        var kv=pair.split('=');
        if(kv[0]) out[kv[0]]=kv[1];
      });
      return out;
    }
    function saveHashState(){
      var parts=[];
      if(_viewParentId) parts.push('parent='+_viewParentId);
      if(_viewCourseId) parts.push('course='+_viewCourseId);
      location.hash=parts.length ? parts.join('&') : '';
    }

