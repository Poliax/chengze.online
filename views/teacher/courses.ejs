    function openSeriesModal(editId, editCourse){
      var id=parseInt(_viewCourseId)||0;
      if(!id){ alert('请先进入二级课程包课程列表'); return; }
      if(editCourse===undefined){
        editCourse=null;
      }
      if(editId && !editCourse){
        var list=_courseCache[_viewCourseId]||[];
        for(var i=0;i<list.length;i++){ if(parseInt(list[i].id)===parseInt(editId)){ editCourse=list[i]; break; } }
        if(!editCourse){ alert('课程不存在'); return; }
      }
      var pkg=seriesPkgById(editCourse ? (editCourse.package_id||id) : id);
      if(!pkg){ alert('课程包不存在'); return; }
      var parent=seriesPkgById(pkg.parent_id);
      document.getElementById('seriesCourseId').value=editCourse ? editCourse.id : 0;
      document.getElementById('seriesForm').action=editCourse ? '/admin/courses-manage/'+editCourse.id+'/update-basic' : '/admin/courses-manage';
      document.querySelector('#seriesModal .course-detail-modal__title').textContent=editCourse ? '编辑系列课' : '新建系列课';
      document.getElementById('seriesPkgId').value=editCourse ? (editCourse.package_id||id) : id;
      seriesDefaultPkgId=editCourse ? (editCourse.package_id||id) : id;
      seriesSelectedIds=[];
      if(editCourse){
        var ids=String(editCourse.package_ids||'').split(',').map(function(x){ return parseInt(x)||0; }).filter(function(x){ return x>0; });
        if(!ids.length && editCourse.package_id) ids=[parseInt(editCourse.package_id)];
        seriesSelectedIds=ids;
      }
      document.getElementById('seriesPkgIds').value=seriesSelectedIds.join(',');
      document.getElementById('seriesDefaultPkg').textContent=(parent ? parent.title + ' · ' : '') + pkg.title;
      document.getElementById('seriesProvince').value=editCourse ? (editCourse.province||pkg.province||'') : (pkg.province||'');
      document.getElementById('seriesYear').value=editCourse ? (editCourse.year||pkg.year||'') : (pkg.year||'');
      document.getElementById('seriesExamType').value=editCourse ? (editCourse.exam_type||pkg.exam_type||'专升本') : (pkg.exam_type||'专升本');
      var ct=(editCourse && editCourse.class_type) || pkg.class_type || '班课';
      ct=(ct==='公开课'||ct==='免费课'||ct==='公共课')?'公开课':(ct==='专项集训课'?'专项集训课':(ct==='押题密训课'?'押题密训课':'班课'));
      document.getElementById('seriesClassTypeText').value=ct==='公开课'?'公开课（免费课）':(ct==='专项集训课'?'专项集训':(ct==='押题密训课'?'冲刺密训':'系统学习'));
      document.getElementById('seriesCourseType').value=ct==='公开课'?'public':'class';
      document.getElementById('seriesClassType').value=ct;
      document.getElementById('seriesAutoTitle').value='';
      seriesPopulateCategory();
      seriesFilterTeacher();
      if(editCourse){
        document.getElementById('seriesCategory').value=editCourse.category||'';
        document.getElementById('seriesTeacher').value=editCourse.teacher_id||'';
        document.getElementById('seriesAutoTitle').value=editCourse.title||'';
      }
