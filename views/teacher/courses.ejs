<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
  <style>
    .level-tag{display:inline-block;padding:2px 8px;border-radius:5px;font-size:11px;font-weight:600}
    .pkg-list-row.selected td{background:#eff6ff}
    .table-wrap td:nth-child(2){white-space:nowrap;font-size:12px;max-width:220px;overflow:hidden;text-overflow:ellipsis}
    #pkgList tr{height:46px}
    #pkgTableHead th{height:40px}
    #pkgList{min-height:460px}
    #pkgModal{width:560px!important;max-height:96vh!important;min-height:560px!important;overflow:hidden!important;display:flex!important;flex-direction:column!important}
    #pkgModal .course-detail-modal__body{overflow-y:auto!important;flex:1!important;padding:16px 20px!important}
    .add-btn{display:inline-flex;align-items:center;justify-content:center;gap:0;width:24px;height:24px;padding:0;background:linear-gradient(180deg,#ffffff,#f4f6f8);color:#111827;border:1px solid #d9dee7;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;white-space:nowrap;margin-top:6px;box-shadow:0 1px 2px rgba(15,23,42,.05), inset 0 1px 0 rgba(255,255,255,.9)}
    .add-btn:hover{background:linear-gradient(180deg,#f8fafc,#e9edf2);border-color:#c3cad4;color:#000000;transform:translateY(-1px);box-shadow:0 2px 6px rgba(15,23,42,.08), inset 0 1px 0 rgba(255,255,255,.9)}
    .del-btn{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;padding:0;border:1px solid #fecaca;background:linear-gradient(180deg,#ffffff,#fef2f2);color:#dc2626;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;font-family:inherit;box-shadow:0 1px 2px rgba(220,38,38,.06), inset 0 1px 0 rgba(255,255,255,.9)}
    .del-btn:hover{background:linear-gradient(180deg,#fff7f7,#fee2e2);border-color:#fca5a5;color:#b91c1c;transform:translateY(-1px)}
  </style>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body class="teacher-body">
  <%- include('partials/sidebar') %>
  <div class="teacher-main">
    <%- include('partials/header') %>
    <div class="teacher-content">
      <div class="stats">
        <div class="stat"><span class="stat-icon stat-icon--blue"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></span><div class="stat-info"><strong><%= totalCourses %></strong><span>课程总数</span></div></div>
        <div class="stat"><span class="stat-icon stat-icon--green"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></span><div class="stat-info"><strong><%= publishedCourses %></strong><span>上架</span></div></div>
        <div class="stat"><span class="stat-icon stat-icon--purple"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span><div class="stat-info"><strong><%= pendingCourses.length %></strong><span>待排课</span></div></div>
      </div>

      <div class="list-header">
        <div style="display:flex;align-items:center;gap:10px">
          <h2 id="listTitle">课程列表</h2>
          <span id="listSubtitle" style="font-size:13px;color:#64748b;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:40vw"></span>
        </div>
        <div class="list-tools">
          <span id="pkgBackWrap"></span>
          <form method="GET" action="/admin/courses-manage" class="toolbar-form" onsubmit="return false">
            <input id="pkgSearch" value="<%= q || '' %>" placeholder="搜索课程包/省份/班型" class="toolbar-input" style="min-width:220px">
            <select id="pkgStatusFilter" class="toolbar-select">
              <option value="">全部状态</option>
              <option value="published">上架</option>
              <option value="archived">下架</option>
            </select>
          </form>
          <button type="button" id="newPkgBtn" class="btn-primary--sm" onclick="handleNewClick()">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            新建课程
          </button>
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead id="pkgTableHead">
            <tr><th>层级</th><th>名称</th><th>年份/省份/考试</th><th>状态</th><th>优先级</th><th>操作</th></tr>
          </thead>
          <tbody id="pkgList"></tbody>
        </table>
        <div id="pkgPagination" class="pagination"></div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="pkgOverlay" style="display:none"></div>
  <div class="course-detail-modal" id="pkgModal" style="max-height:90vh;overflow:hidden;display:flex;flex-direction:column">
    <div class="course-detail-modal__header">
      <div>
        <h3 class="course-detail-modal__title" id="pkgModalTitle">新建课程包</h3>
        <p class="course-detail-modal__sub" id="pkgModalSub"></p>
      </div>
      <button class="course-detail-modal__close" onclick="closePkgModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="course-detail-modal__body" style="overflow-y:auto;flex:1;padding:16px 20px">
      <input type="hidden" id="pkgFormId" value="0">
      <div style="display:flex;gap:10px;margin-bottom:8px">
        <div class="field" style="flex:1;display:none" id="pkgLevelWrap">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">课程包层级</label>
          <select id="pkgFormLevel" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
            <option value="1">一级</option>
            <option value="2">二级</option>
          </select>
        </div>
        <div class="field" style="flex:1;display:none" id="pkgParentWrap">
          <label id="pkgFormParentLabel" style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">所属一级课程包</label>
          <select id="pkgFormParent" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box"></select>
          <input type="text" id="pkgFormParentText" readonly style="display:none;width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
      </div>
      <div class="field" style="margin-bottom:8px">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">名称</label>
        <input id="pkgFormTitle" placeholder="如：2027山东专升本卓越班" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
      </div>
      <div class="field" style="margin-bottom:8px" id="pkgDescWrap">
        <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">课程介绍</label>
        <textarea id="pkgFormDescription" rows="2" placeholder="介绍该课程包，将展示在官网" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;font-family:inherit"></textarea>
      </div>
      <div style="display:flex;gap:10px;margin-bottom:8px">
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">招考省份</label>
          <select id="pkgFormProvince" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
            <option value="">选择省份</option>
            <% (provinceOptions || []).forEach(p => { %><option value="<%= p.name %>"><%= p.name %></option><% }) %>
          </select>
          <input type="text" id="pkgFormProvinceText" readonly style="display:none;width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">考试年份</label>
          <select id="pkgFormYear" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
            <option value="">选择年份</option>
            <% for(var _y=2026;_y<=2035;_y++){ %><option value="<%= _y %>"><%= _y %>年</option><% } %>
          </select>
          <input type="text" id="pkgFormYearText" readonly style="display:none;width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
      </div>
      <div style="display:flex;gap:10px;margin-bottom:8px">
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">考试类型</label>
          <select id="pkgFormExamType" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
            <option value="专升本">专升本</option>
          </select>
          <input type="text" id="pkgFormExamTypeText" readonly style="display:none;width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">课程类型</label>
          <select id="pkgFormClassType" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
            <option value="班课">系统学习</option>
            <option value="专项集训课">专项集训</option>
            <option value="押题密训课">冲刺密训</option>
            <option value="公开课">公开课（免费课）</option>
          </select>
          <input type="text" id="pkgFormClassTypeText" readonly style="display:none;width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
      </div>
      <div style="display:flex;gap:10px;margin-bottom:8px">
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">开课时间</label>
          <input type="date" id="pkgFormStartDate" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">下架时间</label>
          <input type="date" id="pkgFormEndDate" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
      </div>
      <div style="display:flex;gap:10px;margin-bottom:8px">
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">定价</label>
          <input id="pkgFormPrice" type="text" placeholder="元" value="" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">优惠价格</label>
          <input id="pkgFormSalePrice" type="text" placeholder="元" value="" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
      </div>
      <div style="display:flex;gap:10px;margin-bottom:8px">
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">实际报课人数</label>
          <input id="pkgFormActualCount" type="text" readonly placeholder="系统自动统计" value="" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box;background:#f1f5f9;color:#64748b">
        </div>
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">填写报课人数</label>
          <input id="pkgFormStudentCount" type="text" placeholder="填写报课人数" value="" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
      </div>
      <div style="display:flex;gap:10px">
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">优先级</label>
          <input id="pkgFormSort" type="text" placeholder="数字" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
        </div>
        <div class="field" style="flex:1">
          <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">状态</label>
          <select id="pkgFormStatus" style="width:100%;padding:8px 10px;border:1px solid #d1d5db;border-radius:6px;font-size:13px;box-sizing:border-box">
            <option value="published">上架</option>
            <option value="archived">下架</option>
          </select>
        </div>
      </div>
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end;padding:16px 24px;border-top:1px solid #e2e8f0;flex-shrink:0">
      <button onclick="closePkgModal()" class="btn btn-outline">取消</button>
      <button onclick="savePkgForm()" class="btn btn-primary">保存</button>
    </div>
  </div>

  <script>
    var _pkgData = <%- JSON.stringify(packages || []) %>;
    var _page = 1;
    var _pageSize = 10;
    var _viewParentId = 0;
    var _viewCourseId = 0;
    var _courseCache = {};
    function esc(v){ return String(v==null?'':v).replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function statusText(s){ return s==='published'?'<span class="badge badge-active">上架</span>':'<span class="badge badge-disabled">下架</span>'; }
    function pkgTypeText(t){ return (t==='公开课'||t==='免费课'||t==='公共课') ? '公开课（免费课）' : (t==='专项集训课' ? '专项集训' : (t==='押题密训课' ? '冲刺密训' : '系统学习')); }
    function typeText(p){ var c=p.class_type||''; return (c==='公开课'||c==='免费课'||c==='公共课')?'公开课':(c==='专项集训课'?'专项集训课':(c==='押题密训课'?'押题密训课':'班课')); }

    function filteredPkgs(){
      var kw=(document.getElementById('pkgSearch').value||'').trim().toLowerCase();
      var st=document.getElementById('pkgStatusFilter').value||'';
      if(_viewCourseId){
        var courses=_courseCache[_viewCourseId]||[];
        return courses.filter(function(c){
          if(st==='scheduled' && !((parseInt(c.lesson_count)||0)>0)) return false;
          if(st==='unscheduled' && (parseInt(c.lesson_count)||0)>0) return false;
          if(!kw) return true;
          return String(c.title||'').toLowerCase().indexOf(kw)>-1 ||
            String(c.category||'').toLowerCase().indexOf(kw)>-1 ||
            String(c.teacher_name||'').toLowerCase().indexOf(kw)>-1;
        });
      }
      var list=_pkgData.filter(function(p){
        if(_viewParentId===0) return !(parseInt(p.parent_id)||0);
        return parseInt(p.parent_id)===_viewParentId;
      });
      if(st) list=list.filter(function(p){ return p.status===st; });
      if(kw){
        list=list.filter(function(p){
          return String(p.title||'').toLowerCase().indexOf(kw)>-1 ||
            String(p.province||'').toLowerCase().indexOf(kw)>-1 ||
            String(p.class_type||'').toLowerCase().indexOf(kw)>-1 ||
            String(p.parent_title||'').toLowerCase().indexOf(kw)>-1;
        });
      }
      return list.sort(function(a,b){ return String(a.title||'').localeCompare(String(b.title||''), 'zh-Hans-CN') || a.id-b.id; });
    }

    function renderPkgList(){
      var body=document.getElementById('pkgList');
      if(!body) return;
      renderViewBar();
      var head=document.getElementById('pkgTableHead');
      if(head && !_viewCourseId){ var nameLabel=_viewParentId===0?'班型名称':'班级名称'; head.innerHTML='<tr><th>层级</th><th>年份/省份/考试</th><th>课程类型</th><th>'+nameLabel+'</th><th>创建时间</th><th>状态</th><th>优先级</th><th>操作</th></tr>'; }
      var list=filteredPkgs();
      if(_viewCourseId){ renderCourseRows(list); return; }
      var total=list.length;
      var totalPages=Math.max(1, Math.ceil(total/_pageSize));
      if(_page>totalPages) _page=totalPages;
      var rows=list.slice((_page-1)*_pageSize, _page*_pageSize);
      body.innerHTML='';
      if(!rows.length){
        for(var e=0;e<10;e++){
          var tr=document.createElement('tr');
          tr.className='pkg-empty-row';
          if(e===0 && !_viewParentId){
            tr.innerHTML='<td style="color:#94a3b8">暂无课程包</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>';
          } else {
            tr.innerHTML='<td colspan="8" style="height:46px"></td>';
          }
          body.appendChild(tr);
        }
        renderPagination(0,1);
        return;
      }
      rows.forEach(function(p){
        var tr=document.createElement('tr');
        tr.className='pkg-list-row';
        tr.setAttribute('data-id', p.id);
        var lv=parseInt(p.parent_id)||0;
        tr.innerHTML='<td><span class="level-tag '+(lv?'l2':'l1')+'">'+(lv?'二级':'一级')+'</span></td>'+
          '<td>'+esc(p.year||'--')+' / '+esc(p.province||'--')+' / '+esc(p.exam_type||'专升本')+'</td>'+
          '<td>'+pkgTypeText(p.class_type)+'</td>'+
          '<td style="font-weight:600">'+esc(p.title)+'</td>'+
          '<td>'+fmtSeriesTime(p.created_at)+'</td>'+
          '<td>'+statusText(p.status)+'</td>'+
          '<td>'+(parseInt(p.sort_order)||0)+'</td>'+
          '<td>'+
          (_viewParentId===0 ? '<button type="button" class="btn-table" data-action="children" data-id="'+p.id+'">查看</button> ' : '')+
          (lv ? '<button type="button" class="btn-table" data-action="courses" data-id="'+p.id+'">查看</button> ' : '')+
          '<button type="button" class="btn-table" data-action="edit" data-id="'+p.id+'">编辑</button> '+
          '<button type="button" class="btn-table btn-table-danger" data-action="delete" data-id="'+p.id+'">删除</button></td>';
        body.appendChild(tr);
      });
      for(var k=rows.length;k<10;k++){
        var empty=document.createElement('tr');
        empty.className='pkg-empty-row';
        empty.innerHTML='<td colspan="7" style="height:46px"></td>';
        body.appendChild(empty);
      }
      renderPagination(total,totalPages);
    }

    function renderCourseRows(list){
      var head=document.getElementById('pkgTableHead');
      if(head) head.innerHTML='<tr><th>层级</th><th>年份/省份/考试</th><th>科目名称</th><th>授课教师</th><th>创建时间</th><th>状态</th><th>操作</th></tr>';
      var body=document.getElementById('pkgList');
      if(!body) return;
      var total=list.length;
      var totalPages=Math.max(1, Math.ceil(total/_pageSize));
      if(_page>totalPages) _page=totalPages;
      var start=(_page-1)*_pageSize;
      var rows=list.slice(start, start+_pageSize);
      body.innerHTML='';
      if(!rows.length){
        for(var e=0;e<10;e++){
          var tr=document.createElement('tr');
          tr.className='pkg-empty-row';
          if(e===0){
            tr.innerHTML='<td style="color:#94a3b8">暂无课程</td><td></td><td></td><td></td><td></td><td></td><td></td>';
          } else {
            tr.innerHTML='<td colspan="8" style="height:46px"></td>';
          }
          body.appendChild(tr);
        }
        renderPagination(0,1);
        return;
      }
      rows.forEach(function(c, idx){
        var tr=document.createElement('tr');
        var scheduled=(parseInt(c.lesson_count)||0)>0 ? '已排课' : '未排课';
        tr.innerHTML='<td><span class="level-tag l3">课程</span></td>'+
          '<td>'+esc((c.year||'--')+' / '+(c.province||'--')+' / '+(c.exam_type||'专升本'))+'</td>'+
          '<td>'+esc(c.category||'-')+'</td>'+
          '<td>'+esc(c.teacher_name||'-')+'</td>'+
          '<td>'+fmtSeriesTime(c.created_at)+'</td>'+
          '<td><span class="badge '+(scheduled==='已排课'?'badge-active':'badge-disabled')+'">'+scheduled+'</span></td>'+
          '<td><a class="btn-table" href="/admin/courses-manage/'+c.id+'/scheduler?package_id='+_viewCourseId+'" target="_blank">排课</a> <button type="button" class="btn-table" onclick="openSeriesEdit('+c.id+')">编辑</button> <button type="button" class="btn-table btn-table-danger" onclick="deleteCourse('+c.id+')">删除</button></td>';
        body.appendChild(tr);
      });
      for(var k=rows.length;k<10;k++){
        var empty=document.createElement('tr');
        empty.className='pkg-empty-row';
        empty.innerHTML='<td colspan="7" style="height:46px"></td>';
        body.appendChild(empty);
      }
      renderPagination(total,totalPages);
    }

    function deleteCourse(id){
      if(!confirm('确认删除该系列课？')) return;
      fetch('/admin/courses-manage/'+id+'/delete', { method:'POST' })
        .then(function(){
          if(_courseCache && _viewCourseId) delete _courseCache[_viewCourseId];
          loadCourses(_viewCourseId);
        })
        .catch(function(){ alert('删除失败，请重试'); });
    }
    function fmtSeriesTime(v){
      if(!v) return '-';
      var s=String(v).trim();
      var d=new Date(s.indexOf('T')>=0 ? s : s.replace(' ','T') + (s.indexOf('Z')>=0 ? '' : 'Z'));
      if(isNaN(d.getTime())) return s;
      d=new Date(d.getTime()+8*3600*1000);
      function p(n){ return String(n).padStart(2,'0'); }
      return d.getUTCFullYear()+'-'+p(d.getUTCMonth()+1)+'-'+p(d.getUTCDate())+' '+p(d.getUTCHours())+':'+p(d.getUTCMinutes())+':'+p(d.getUTCSeconds());
    }
    function showCourseView(c){
      if(!c){ alert('课程不存在'); return; }
      var rows=[
        ['课程名称', c.title||'-'],
        ['关联课程', c.package_titles||'-'],
        ['考试科目', c.category||'-'],
        ['创建时间', fmtSeriesTime(c.created_at)],
        ['授课教师', c.teacher_name||'-'],
        ['招考省份', c.province||'-'],
        ['考试年份', c.year||'-'],
        ['课程类型', (c.class_type==='公开课'||c.class_type==='免费课'||c.class_type==='公共课') ? '公开课（免费课）' : (c.class_type==='专项集训课' ? '专项集训' : (c.class_type==='押题密训课' ? '冲刺密训' : '系统学习'))]
      ];
      var html='';
      rows.forEach(function(r){ html+='<div class="form-group"><label>'+r[0]+'</label><input type="text" readonly value="'+esc(r[1])+'"></div>'; });
      document.getElementById('courseViewBody').innerHTML=html;
      document.getElementById('courseViewOverlay').style.display='flex';
      document.getElementById('courseViewOverlay').classList.add('open');
      document.getElementById('courseViewModal').style.display='flex';
      document.getElementById('courseViewModal').classList.add('open');
    }
    function openCourseView(id){
      var pid=_viewCourseId;
      if(!pid){
        var list=_courseCache[pid]||[];
        var c=null;
        for(var i=0;i<list.length;i++){ if(parseInt(list[i].id)===parseInt(id)){ c=list[i]; break; } }
        showCourseView(c);
        return;
      }
      fetch('/admin/packages-manage/api/courses/'+pid).then(function(r){ return r.json(); }).then(function(d){
        _courseCache[pid]=(d && d.courses) || [];
        var c=null;
        for(var i=0;i<_courseCache[pid].length;i++){ if(parseInt(_courseCache[pid][i].id)===parseInt(id)){ c=_courseCache[pid][i]; break; } }
        showCourseView(c);
      }).catch(function(){
        var list=_courseCache[pid]||[];
        var c=null;
        for(var i=0;i<list.length;i++){ if(parseInt(list[i].id)===parseInt(id)){ c=list[i]; break; } }
        showCourseView(c);
      });
