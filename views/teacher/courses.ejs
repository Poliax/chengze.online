      var status=document.getElementById('pkgStatusFilter');
      var prev=status ? status.value : '';
      if(_viewCourseId){
        if(search) search.placeholder='搜索科目/教师';
        if(status){
          status.innerHTML='<option value="">全部状态</option><option value="scheduled">已排课</option><option value="unscheduled">未排课</option>';
          if(prev==='scheduled'||prev==='unscheduled') status.value=prev; else status.value='';
        }
      } else {
        if(search) search.placeholder='搜索课程包/省份/班型';
        if(status){
          status.innerHTML='<option value="">全部状态</option><option value="published">上架</option><option value="archived">下架</option>';
          if(prev==='published'||prev==='archived') status.value=prev; else status.value='';
        }
      }
