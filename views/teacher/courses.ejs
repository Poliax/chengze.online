    function saveSeriesModal(){
      var form=document.getElementById('seriesForm');
      if(!form) return;
      seriesUpdateTitle();
      if(!form.checkValidity()){ form.reportValidity(); return; }
      var data=new URLSearchParams(new FormData(form));
      var btn=document.querySelector('#seriesModal .btn-primary');
      if(btn) btn.disabled=true;
      var action=form.getAttribute('action') || '/admin/courses-manage';
      fetch(action, {
        method:'POST',
        headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:data.toString(),
        redirect:'follow'
      }).then(function(r){
        if(action.indexOf('update-basic')>=0){
          return r.json().then(function(d){ if(!d || !d.ok) throw new Error('保存失败'); });
        }
        return r.text();
      }).then(function(){ closeSeriesModal(); if(_viewCourseId){ _courseCache={}; loadCourses(_viewCourseId); } else { renderPkgList(); } })
        .catch(function(){ alert('保存失败，请重试'); })
        .then(function(){ if(btn) btn.disabled=false; });
    }
    function openPkgModal(editId){
