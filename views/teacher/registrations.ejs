<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-round.png?v=20261015-green9"><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon-green-v9.ico"></head>
<body class="teacher-body">
  <%- include('partials/sidebar') %>
  <div class="teacher-main">
    <%- include('partials/header') %>
    <div class="teacher-content">
      <div class="stats">
        <div class="stat"><span class="stat-icon stat-icon--blue"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg></span><div class="stat-info"><strong id="countRegs"><%= regTotal %></strong><span>用户总数</span></div></div>
        <div class="stat"><span class="stat-icon stat-icon--green"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></span><div class="stat-info"><strong><%= activeRegs %></strong><span>已启用</span></div></div>
        <div class="stat"><span class="stat-icon stat-icon--purple"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></span><div class="stat-info"><strong><%= disabledRegs %></strong><span>已停用</span></div></div>
      </div>
      <div class="list-header">
        <h2>用户列表</h2>
        <div class="list-tools">
          <form method="GET" action="/admin/users-manage" id="regFilterForm" class="toolbar-form" data-client-filter="1">
            <input name="rq" id="rq" value="<%= rq || '' %>" placeholder="搜索手机号" class="toolbar-input" style="width:140px">
            <input type="date" name="rsdate" id="rsd" value="<%= rsdate || '' %>" class="toolbar-date">
            <span style="font-size:12px;color:#94a3b8">至</span>
            <input type="date" name="redate" id="red" value="<%= redate || '' %>" class="toolbar-date">
          </form>
          <a href="/admin/users-manage/new" class="btn-primary--sm">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            添加用户
          </a>
        </div>
      </div>
      <div class="user-table-wrap">
        <table class="user-table">
          <thead>
            <tr>
              <th>用户名</th><th>UID</th><th>真实姓名</th><th>手机号</th><th>考试省份</th><th>考试年份</th><th>注册时间</th><th>操作</th>
            </tr>
          </thead>
          <tbody id="registeredTbody">
            <% if (registered.length === 0) { %>
              <tr><td colspan="8" style="text-align:center;padding:30px;color:#94a3b8">暂无注册用户</td></tr>
              <% for(var fi=1;fi<10;fi++){ %><tr><td colspan="8">&nbsp;</td></tr><% } %>
            <% } else { %>
              <% registered.forEach(s => { %>
                <tr>
                  <td><%= s.username || '-' %></td>
                  <td><%= s.uid || 'UID' + String(s.id).padStart(6, '0') %></td>
                  <td class="name-cell"><%= s.real_name || '-' %></td>
                  <td><%= s.phone || '-' %></td>
                  <td><%= s.exam_province || '-' %></td>
                  <td><%= s.exam_year || '-' %></td>
                  <td><%= s.created_at ? new Date(s.created_at.replace(' ','T')+'Z').toLocaleString('zh-CN', { timeZone:'Asia/Shanghai', hour12: false }) : '-' %></td>
                  <td><a href="/admin/students-manage/<%= s.id %>" class="btn-table">查看</a></td>
                </tr>
              <% }) %>
              <% for(var fi=registered.length;fi<10;fi++){ %><tr><td colspan="8">&nbsp;</td></tr><% } %>
            <% } %>
          </tbody>
        </table>
        <%- include('partials/pagination', { id: 'regPagination', pages: regPages, current: page || 1, total: regTotal, fn: 'loadRegistered' }) %>
      </div>
    </div>
  </div>
<script>
function escHtml(v){
  return String(v == null ? '' : v)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}
function fmtDate(v){ if(!v) return '-'; try { return new Date(String(v).replace(' ','T')+'Z').toLocaleString('zh-CN', { timeZone:'Asia/Shanghai', hour12: false }); } catch(e){ return v; } }
function fillRows(count,colspan){
  var h='';
  for(var i=0;i<Math.max(0,count);i++){h+='<tr><td colspan="'+colspan+'">&nbsp;</td></tr>';}
  return h;
}
function loadRegistered(page){
  var params=new URLSearchParams({scope:'registered',page:page||1});
  var rq=document.getElementById('rq');if(rq&&rq.value)params.set('rq',rq.value);
  var rs=document.getElementById('rsd');if(rs&&rs.value)params.set('rsdate',rs.value);
  var re=document.getElementById('red');if(re&&re.value)params.set('redate',re.value);
  fetch('/admin/api/users?'+params).then(function(r){return r.json();}).then(function(data){
    document.getElementById('countRegs').textContent=data.total;
    var rtb=document.getElementById('registeredTbody');
    if(data.rows.length===0){
      rtb.innerHTML='<tr><td colspan="8" style="text-align:center;padding:30px;color:#94a3b8">暂无注册用户</td></tr>'+fillRows(9,8);
    }else{
      rtb.innerHTML=data.rows.map(function(s){
        return '<tr><td>'+escHtml(s.username || '-')+'</td><td>'+escHtml(s.uid || 'UID'+String(s.id).padStart(6,'0'))+'</td><td class="name-cell">'+escHtml(s.real_name || '-')+'</td><td>'+escHtml(s.phone||'-')+'</td><td>'+escHtml(s.exam_province||'-')+'</td><td>'+escHtml(s.exam_year || '-')+'</td><td>'+fmtDate(s.created_at)+'</td><td><a href="/admin/students-manage/'+s.id+'" class="btn-table">查看</a></td></tr>';
      }).join('')+fillRows(10-data.rows.length,8);
    }
    renderPagination('regPagination',data.pages,data.page,data.total,'loadRegistered');
  });
}
function renderPagination(elId,totalPages,current,total,fn){
  var el=document.getElementById(elId);if(!el)return;
  if(totalPages<=1){el.style.display='none';el.innerHTML='';return;}
  el.style.display='';
  var h='';
  if(current>1){h+='<a href="javascript:void(0)" class="page-btn" onclick="'+fn+'('+(current-1)+')">‹ 上一页</a>';}
  else{h+='<span class="page-btn disabled">‹ 上一页</span>';}
  var start=Math.max(1,current-2),end=Math.min(totalPages,current+2);
  if(start>1){h+='<a href="javascript:void(0)" onclick="'+fn+'(1)">1</a>';if(start>2)h+='<span class="dots">…</span>';}
  for(var i=start;i<=end;i++){
    if(i===current)h+='<span class="current">'+i+'</span>';
    else h+='<a href="javascript:void(0)" onclick="'+fn+'('+i+')">'+i+'</a>';
  }
  if(end<totalPages){if(end<totalPages-1)h+='<span class="dots">…</span>';h+='<a href="javascript:void(0)" onclick="'+fn+'('+totalPages+')">'+totalPages+'</a>';}
  if(current<totalPages){h+='<a href="javascript:void(0)" class="page-btn" onclick="'+fn+'('+(current+1)+')">下一页 ›</a>';}
  else{h+='<span class="page-btn disabled">下一页 ›</span>';}
  h+='<span class="info">共 '+total+' 条</span>';
  h+='<span class="jump">跳至 <input type="number" min="1" max="'+totalPages+'" value="'+current+'" onkeydown="if(event.key===\'Enter\'){'+fn+'(this.value)}"> 页</span>';
  el.innerHTML=h;
}
function clearRegs(){
  ['rq','rsd','red'].forEach(function(id){var el=document.getElementById(id);if(el)el.value='';});
  loadRegistered(1);
}
document.addEventListener('DOMContentLoaded',function(){
  document.getElementById('regFilterForm').addEventListener('submit',function(e){e.preventDefault();loadRegistered(1);});
  var _regT;
  ['rq','rsd','red'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('input',function(){ clearTimeout(_regT); _regT=setTimeout(function(){ loadRegistered(1); },250); });
  });
  loadRegistered(<%= page || 1 %>);
});
</script>
</body>
</html>
