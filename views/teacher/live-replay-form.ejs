<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-round.png?v=20261015-green9"><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon-green-v9.ico"></head>
<body class="teacher-body">
<%- include('partials/sidebar') %>
<div class="teacher-main">
<%- include('partials/header') %>
<div class="teacher-content">
  <div class="list-header">
    <h2>添加回放</h2>
  </div>

  <div class="form-card replay-form">
    <h3>手动添加</h3>
    <form method="POST" action="/admin/replays-manage/save" class="staff-form">
      <div class="form-grid">
        <div class="form-group">
          <label>选择课程</label>
          <select name="course_id" required>
            <option value="">请选择课程</option>
            <% courses.forEach(c => { %><option value="<%= c.id %>"><%= c.title %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>回放标题</label>
          <input name="title" placeholder="如 大学英语精讲班 · 第1次课">
        </div>
        <div class="form-group">
          <label>时长（分钟）</label>
          <input name="duration" type="number" placeholder="120">
        </div>
        <div class="form-group full-width">
          <label>点播视频地址（云点播控制台复制播放地址）</label>
          <input name="video_url" placeholder="https://xxx.vod2.myqcloud.com/xxx.mp4" required>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">保存</button>
      </div>
    </form>
  </div>
</div>
</div>
<script>
  ['menuToggle','sidebarToggle'].forEach(function(id){
    var el=document.getElementById(id);
    if(el) el.addEventListener('click',function(){document.getElementById('sidebar').classList.toggle('open');});
  });
</script>
</body>
</html>
