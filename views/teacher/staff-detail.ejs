<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>

<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/teacher.css?v=<%= cssVer %>">
<style>
  .detail-grid { display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:6px 24px; }
  .detail-item { display:flex; align-items:flex-start; gap:8px; padding:6px 0; border-bottom:1px dashed #eef2f7; font-size:13px; }
  .detail-label { width:84px; flex-shrink:0; color:#64748b; font-weight:600; }
  .detail-value { flex:1; color:#111827; }
  .detail-actions { display:flex; gap:8px; margin-top:16px; }
  @media (max-width:640px){ .detail-grid { grid-template-columns:1fr; } }
</style>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body class="teacher-body">
<%- include('partials/sidebar') %>
<div class="teacher-main">
<%- include('partials/header') %>
<div class="teacher-content">
  <div class="list-header">
    <h2>教师详情</h2>
    <div class="list-tools">
    </div>
  </div>

  <div class="form-card">
    <h3>基本信息</h3>
    <div class="detail-grid">
      <div class="detail-item"><span class="detail-label">教师姓名</span><span class="detail-value"><%= staff.real_name %></span></div>
      <div class="detail-item"><span class="detail-label">教师昵称</span><span class="detail-value"><%= staff.username || '-' %></span></div>
      <div class="detail-item"><span class="detail-label">教师ID</span><span class="detail-value"><%= staff.teacher_no || ('T' + String(staff.id).padStart(3,'0')) %></span></div>
      <div class="detail-item"><span class="detail-label">科目</span><span class="detail-value"><%= staff.subject || '-' %></span></div>
      <div class="detail-item"><span class="detail-label">手机号</span><span class="detail-value"><%= staff.phone || '-' %></span></div>
      <div class="detail-item"><span class="detail-label">入职日期</span><span class="detail-value"><%= staff.hire_date || '-' %></span></div>
      <div class="detail-item"><span class="detail-label">状态</span><span class="detail-value"><%= staff.status === 'disabled' ? '停用' : '启用' %></span></div>
      <div class="detail-item"><span class="detail-label">课时(h)</span><span class="detail-value"><%= staff.total_hours || 0 %></span></div>
      <div class="detail-item"><span class="detail-label">课程数</span><span class="detail-value"><%= staff.course_count || 0 %></span></div>
    </div>
  </div>

  <div class="form-card">
    <h3>个人简介</h3>
    <div class="detail-value"><%= staff.bio || '暂无简介' %></div>
  </div>

  <div class="detail-actions">
    <form method="POST" action="/admin/teachers-manage/<%= staff.id %>/delete" onsubmit="return confirm('确定删除该教师？')">
      <button type="submit" class="btn btn-danger">删除</button>
    </form>
    <a href="/admin/teachers-manage/edit/<%= staff.id %>" class="btn btn-primary">编辑</a>
  </div>
</div>
</div>
</body>
</html>
