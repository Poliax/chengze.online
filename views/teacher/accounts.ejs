<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %></title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
<style>.secondary-options{display:flex;flex-wrap:wrap;gap:12px;margin:12px 0;font-size:12px}.account-form summary{cursor:pointer;font-size:13px;font-weight:600;padding:4px 0}.account-head{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:16px}.account-head h1{font-size:20px;margin:0 0 6px}.account-head p,.muted{color:var(--muted,#64748b);font-size:12px}.account-panel{background:#fff;border:1px solid var(--color-border);border-radius:var(--radius-md);padding:16px 18px;margin-bottom:16px;box-shadow:var(--shadow-sm)}.account-table,.permission-table{width:100%;border-collapse:collapse}.account-table td,.account-table th,.permission-table td{padding:10px;text-align:left;border-bottom:1px solid var(--color-border);font-size:12px}.account-table th{color:var(--muted,#64748b);font-weight:600}.pill{background:#f1f5f9;border-radius:4px;padding:3px 8px;display:inline-block}.off{color:#dc2626}.account-summary{display:flex;gap:20px;margin:16px 0;font-size:12px}.role-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.role-cards div{background:#f8fafc;padding:12px;border-radius:6px;font-size:12px}.role-cards strong{display:block;margin-bottom:8px}.notice{padding:10px 12px;border:1px solid var(--color-border);border-radius:6px;background:#f8fafc;margin-bottom:16px;font-size:13px}.error{background:#fef2f2;border-color:#fecaca;color:#dc2626}#accountEditor{max-width:820px;margin-bottom:24px}#accountEditor[hidden],#staffField[hidden],#expiryField[hidden]{display:none!important}#accountEditor>h2{font-size:17px;margin-bottom:10px}.account-form .form-tip{font-size:11px;color:var(--muted,#94a3b8);margin:6px 0 12px}.permission-table select{padding:8px 10px;border:1px solid var(--color-border);border-radius:6px;font-size:13px;font-family:inherit;width:180px;max-width:100%;background:#fff}.permission-table select:focus{outline:0;border-color:var(--color-primary)}.permission-table select:disabled{background:#f8fafc;color:#64748b}.account-form input[readonly]{background:#f8fafc}@media(max-width:850px){.role-cards{grid-template-columns:repeat(2,1fr)}.account-panel{overflow:auto}.account-table{min-width:660px}}@media(max-width:640px){.account-form .form-grid{grid-template-columns:1fr;gap:8px}.account-head{align-items:flex-start}.account-summary{flex-wrap:wrap;gap:10px}}
</style></head><body class="teacher-body"><%- include('partials/sidebar') %><div class="teacher-main"><%- include('partials/header') %><main class="teacher-content">
<div class="account-head"><div><h1>账号管理</h1><p>四个核心部门 · 超级账号直属技术支持 · 按岗位配置功能权限</p></div><button class="btn-primary--sm" id="newAccount">＋ 新建账号</button></div>
<% if(error){ %><div role="alert" class="notice error"><%= error %>（请重新填写；密码不会回显。）</div><% } %><% if(message){ %><div role="status" class="notice"><%= message %></div><% } %>
<div class="account-panel"><h2 style="font-size:18px">账号列表</h2><div class="account-summary"><span>共 <strong><%= accounts.length %></strong> 个账号</span><span>已启用 <%= accounts.filter(a=>a.status==='active').length %></span><span class="muted">仅 超级账号可管理账号与人员</span></div>
<table class="account-table"><thead><tr><th>姓名 / 登录账号</th><th>部门 / 岗位</th><th>权限等级</th><th>功能权限</th><th>状态</th><th>操作</th></tr></thead><tbody>
<% accounts.forEach(a=>{ const p=access.permissions(a); %><tr><td><strong><%= a.display_name %></strong><div class="muted"><%= a.username %><%= a.teacher_id===teacherId?' · 当前账号':'' %></div></td><td><span class="pill"><%= access.roles[a.role] %></span><div class="muted"><%= access.departments[a.department] || access.department(a.role) %><% const extras=access.assignedRoles(a).filter(r=>r!==a.role); if(extras.length){ %><br>兼任：<%= extras.map(r=>access.roles[r]).join("、") %><% } %></div></td><td><%= access.level(a.role) %></td><td><%= a.role==='ceo'?'全部功能':Object.keys(p).length+' 个模块' %></td><td class="<%= a.status==='disabled'?'off':'' %>"><%= a.status==='active'?'已启用':'已停用' %></td><td><button class="btn btn-outline btn-sm edit-account" data-account="<%= JSON.stringify({id:a.teacher_id,display_name:a.display_name,username:a.username,role:a.role,status:a.status,permission_expires_at:a.permission_expires_at,permission_mode:a.permission_mode||'custom',secondary_roles:a.secondary_roles||'[]',permissions:a.permission_mode==='default'?access.roleDefaults(a):JSON.parse(a.permissions||'{}')}) %>">编辑 / 权限</button></td></tr><% }) %>
</tbody></table></div>
<section id="accountEditor" hidden><h2 id="editorTitle" >新建后台账号</h2><p class="muted">权限按功能模块生效，涵盖该模块内数据；不表示仅能查看本人负责的数据。管理权限包含查看及新增、编辑、删除等操作。</p>
<form method="post" action="/admin/accounts-manage/save" id="accountForm" class="account-form"><input type="hidden" name="_csrf" value="<%= accountCsrf %>"><input type="hidden" name="id" id="accountId">
<div class="form-card"><h3>基本信息</h3><div class="form-grid"><div class="form-group" id="staffField"><label for="staffId">关联人员</label><select name="staff_id" id="staffId"><option value="">新建独立账号</option><% staff.forEach(t=>{ %><option value="<%= t.id %>"><%= t.display_name %> · <%= t.username %></option><% }) %></select></div><div class="form-group"><label for="accountUsername">登录账号</label><input name="username" id="accountUsername" autocomplete="off" maxlength="40" pattern="[A-Za-z][A-Za-z0-9_.-]{2,39}" placeholder="例如 operations01"></div><div class="form-group"><label for="accountName">姓名</label><input name="display_name" id="accountName" required maxlength="40"></div><div class="form-group"><label for="accountDepartment">所属部门</label><select name="department" id="accountDepartment"><% Object.entries(access.departments).forEach(([key,label])=>{ %><option value="<%= key %>"><%= label %></option><% }) %></select></div><div class="form-group"><label for="accountRole">岗位</label><select name="role" id="accountRole"><% Object.entries(access.roles).forEach(([key,label])=>{ %><option value="<%= key %>" <%= key==='operations'?'selected':'' %>><%= label %></option><% }) %></select></div><div class="form-group"><label for="accountLevel">权限等级</label><input name="permission_level" id="accountLevel" readonly aria-describedby="levelHint"></div><div class="form-group"><label for="accountStatus">状态</label><select name="status" id="accountStatus"><option value="active">启用</option><option value="disabled">停用</option></select></div><div class="form-group"><label for="accountPassword">登录密码</label><input type="password" name="password" id="accountPassword" autocomplete="new-password" minlength="12" placeholder="至少12位，包含字母和数字"></div><div class="form-group"><label for="permissionMode">权限设置</label><select name="permission_mode" id="permissionMode"><option value="default">使用身份默认权限</option><option value="custom">自定义模块权限</option></select></div><div class="form-group" id="expiryField" hidden><label for="permissionExpiry">技术授权到期</label><input type="datetime-local" name="permission_expires_at" id="permissionExpiry"></div></div>
<p class="form-tip" id="levelHint">部门与岗位决定业务功能，权限等级自动匹配；等级不会自动开放其他部门业务。</p><details><summary>兼任岗位（可选）</summary><div class="secondary-options"><% Object.entries(access.roles).filter(([key])=>access.levelCode(key)==='L2').forEach(([key,label])=>{ %><label><input type="checkbox" name="secondary_roles" value="<%= key %>"> <%= label %></label><% }) %></div></details><p class="form-tip">新密码至少 12 位，包含字母和数字；编辑或关联时留空保留。关联人员与授课后台共用密码。技术账号默认无业务权限；临时业务授权须在未来 7 天内到期（北京时间）。</p></div><details class="form-card" id="permissionDetails"><summary>功能权限（默认按岗位配置，需要时展开调整）</summary><p class="form-tip">停用、重置密码或修改权限后，原有后台登录失效。</p>
<table class="permission-table"><thead><tr><th style="text-align:left">功能模块</th><th style="text-align:left">授权范围</th></tr></thead><tbody><% Object.entries(access.modules).forEach(([key,label])=>{ %><tr><td><%= label %><%= ['accounts','teachers','assistants'].includes(key)?'（仅 超级账号）':'' %></td><td><select name="perm_<%= key %>" data-permission="<%= key %>" aria-label="<%= label %>权限"><option value="none">无权限</option><option value="read">仅查看</option><option value="manage">管理（含查看）</option></select></td></tr><% }) %></tbody></table>
</details><div class="form-actions"><button class="btn btn-primary" type="submit">保存账号</button><button class="btn btn-outline" type="button" id="cancelAccount">取消</button></div></form></section>
<div class="account-panel"><h2 style="font-size:18px">身份默认权限</h2><div class="role-cards"><div><strong>超级账号</strong>全部功能，包括账号创建与权限分配</div><div><strong>招生主管</strong>招生用户、学员、订单、物流管理</div><div><strong>教学主管</strong>课程、教学、直播、教研、题库、讲义和答疑管理</div><div><strong>服务主管</strong>助教服务、学员跟进与答疑管理</div><div><strong>技术负责人 / 开发人员</strong>超级账号直属，默认仅技术工作台；不包含云平台、代码仓库、服务器或数据库权限</div><div><strong>运营主管</strong>省份、课程、套餐、内容、广告和物流管理</div><div><strong>运营</strong>课程、内容、排课、用户与学员运营；订单仅查看</div><div><strong>教师</strong>课程与回放查看；教学、直播、题库、讲义、答疑</div><div><strong>助教</strong>课程、直播、回放、讲义和学员查看；答疑管理</div><div><strong>销售</strong>课程套餐查看；用户、学员与订单管理</div></div></div>
<div class="account-panel"><h2 style="font-size:18px">最近账号操作</h2><table class="account-table"><thead><tr><th>时间（北京时间）</th><th>操作人</th><th>目标账号</th><th>操作</th></tr></thead><tbody><% (typeof auditLogs==='undefined'?[]:auditLogs).forEach(log=>{ %><tr><td><%= new Date(log.created_at.replace(' ','T')+'Z').toLocaleString('zh-CN',{timeZone:'Asia/Shanghai',hour12:false}) %></td><td><%= log.actor_name || log.actor_id %></td><td><%= log.target_name || log.target_id %></td><td><%= log.action==='create'?'创建账号':'修改账号 / 权限' %></td></tr><% }) %></tbody></table></div>
</main></div><script>
const defaults=<%- JSON.stringify(access.defaults) %>;
const roles=<%- JSON.stringify(access.roles) %>,roleDepartments=<%- JSON.stringify(access.roleDepartments) %>;
const hasSuper=<%- JSON.stringify(accounts.some(a=>a.role==='ceo')) %>;
const form=document.getElementById('accountForm'),editor=document.getElementById('accountEditor');
const field=id=>document.getElementById(id);
const secondary=()=>[...form.querySelectorAll('[name="secondary_roles"]:checked')].map(el=>el.value);
function fillRoles(role){const department=field('accountDepartment').value;field('accountRole').replaceChildren();Object.entries(roles).filter(([key])=>roleDepartments[key]===department).forEach(([key,label])=>{const option=document.createElement('option');option.value=key;option.textContent=label;field('accountRole').append(option);});if(role&&roleDepartments[role]===department)field('accountRole').value=role;}
function combined(){const result={};for(const role of [field('accountRole').value,...secondary()])for(const [key,value] of Object.entries(defaults[role]||{}))if(result[key]!=='manage')result[key]=value;return result;}
function updatePermissions(values){const role=field('accountRole').value;field('expiryField').hidden=!['technical_lead','developer'].includes(role);field('accountLevel').value=role==='ceo'?'L0':role.endsWith('_supervisor')||role==='technical_lead'?'L1':'L2';form.querySelectorAll('[name="secondary_roles"]').forEach(el=>{el.disabled=role==='ceo'||el.value===role;if(el.disabled)el.checked=false;});document.querySelectorAll('[data-permission]').forEach(s=>{s.value=values[s.dataset.permission]||'none';s.disabled=field('permissionMode').value==='default'||role==='ceo'||['accounts','teachers','assistants'].includes(s.dataset.permission);});}
function refresh(){if(field('permissionMode').value==='default'||field('accountRole').value==='ceo')updatePermissions(combined());else updatePermissions(Object.fromEntries([...document.querySelectorAll('[data-permission]')].map(s=>[s.dataset.permission,s.value])));}
function reset(){form.reset();field('accountUsername').disabled=false;field('accountDepartment').querySelector('[value="platform"]').disabled=false;field('permissionDetails').open=false;}
field('newAccount').onclick=()=>{reset();field('accountId').value='';field('accountDepartment').value='operations';fillRoles('operations');field('accountDepartment').querySelector('[value="platform"]').disabled=hasSuper;field('staffField').hidden=false;field('accountUsername').readOnly=false;field('accountPassword').required=true;field('accountUsername').required=true;field('editorTitle').textContent='新建后台账号';editor.hidden=false;refresh();editor.scrollIntoView({behavior:'smooth'});field('accountName').focus();};
document.querySelectorAll('.edit-account').forEach(button=>button.onclick=()=>{const a=JSON.parse(button.dataset.account);reset();field('accountId').value=a.id;field('accountName').value=a.display_name;field('accountUsername').value=a.username;field('accountUsername').readOnly=true;field('staffField').hidden=true;field('accountPassword').required=false;field('accountUsername').required=false;field('accountDepartment').value=roleDepartments[a.role];fillRoles(a.role);field('accountDepartment').querySelector('[value="platform"]').disabled=hasSuper&&a.role!=='ceo';field('accountStatus').value=a.status;const extras=JSON.parse(a.secondary_roles||'[]');form.querySelectorAll('[name="secondary_roles"]').forEach(el=>el.checked=extras.includes(el.value));field('permissionExpiry').value=a.permission_expires_at?new Date(Date.parse(a.permission_expires_at)+8*3600000).toISOString().slice(0,16):'';field('permissionMode').value=a.permission_mode;field('editorTitle').textContent='编辑账号 · '+a.display_name;editor.hidden=false;updatePermissions(a.permissions);editor.scrollIntoView({behavior:'smooth'});});
field('permissionMode').onchange=refresh;field('accountDepartment').onchange=()=>{fillRoles();field('permissionMode').value='default';refresh();};field('accountRole').onchange=()=>{field('permissionMode').value='default';refresh();};form.querySelectorAll('[name="secondary_roles"]').forEach(el=>el.onchange=refresh);field('staffId').onchange=()=>{field('accountUsername').required=!field('staffId').value;field('accountUsername').disabled=!!field('staffId').value;field('accountPassword').required=!field('staffId').value;};field('cancelAccount').onclick=()=>{reset();editor.hidden=true;};
document.getElementById('sidebarToggle')?.addEventListener('click',()=>document.getElementById('sidebar').classList.toggle('open'));
</script></body></html>
