<!DOCTYPE html><html lang="zh-CN"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= title %></title>

<link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/backend.css?v=<%= cssVer %>">
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body class="teacher-body">
<%- include('partials/sidebar') %>
<div class="teacher-main"><%- include('partials/header') %><div class="teacher-content">
<div class="list-tools">
<a href="/admin/assistants-manage/edit/0" class="btn-primary--sm"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>添加助教</a>
</div>
<div class="stats">
<div class="stat"><div class="stat-icon stat-icon--blue"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div class="stat-info"><strong><%= totalAssistants %></strong><span>助教总数</span></div></div>
<div class="stat"><div class="stat-icon stat-icon--green"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></div><div class="stat-info"><strong><%= assignedCount %></strong><span>已分配</span></div></div>
</div>
<div class="card-grid">
<% if (assistants.length === 0) { %><div class="empty-state" style="grid-column:1/-1"><p>暂无助教</p></div><% } %>
<% assistants.forEach(a => { %>
<div class="card">
<div class="card-body">
<div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
<div class="teacher-avatar" style="width:40px;height:40px;font-size:15px"><%= a.name[0] %></div>
<div><strong style="font-size:15px"><%= a.name %></strong><br><span style="font-size:13px;color:var(--muted)"><%= a.email||'-' %></span></div>
<span class="badge <%= a.status==='active'?'badge-英语':'badge-数学' %>" style="margin-left:auto"><%= a.status==='active'?'在职':'离职' %></span>
</div>
<p style="font-size:13px;color:var(--muted)"><%= a.bio||'暂无简介' %></p>
<div style="font-size:13px;color:var(--muted);margin-bottom:8px"><strong>电话：</strong><%= a.phone||'-' %></div>
<div style="font-size:13px"><strong>负责课程：</strong>
<% const ass = assignments.filter(ass => ass.assistant_id === a.id); %>
<% if (ass.length === 0) { %><span style="color:var(--muted)">未分配</span><% } %>
<% ass.forEach((as, i) => { %><span class="badge badge-英语"><%= as.course_title %></span> <% }) %>
</div>
</div>
<div class="card-actions">
<a href="/admin/assistants-manage/edit/<%= a.id %>" class="btn btn-outline btn-sm">编辑</a>
<form method="POST" action="/admin/assistants-manage/<%= a.id %>/toggle" style="display:inline">
<button class="btn btn-sm <%= a.status==='active'?'btn-outline':'btn-primary' %>"><%= a.status==='active'?'停用':'启用' %></button>
</form>
</div>
</div>
<% }) %>
</div>
</div></div>
<script>document.getElementById('menuToggle')?.addEventListener('click',()=>{document.getElementById('sidebar').classList.toggle('open')});</script>
</body></html>
