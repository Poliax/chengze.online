<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/teacher.css?v=<%= cssVer %>">
  <style>
    .teacher-content { padding: 14px 16px 44px; }
    .order-form { max-width: 820px; }
    .course-detail-header { margin-bottom: 10px; }
    .course-detail-header h2 { font-size: 17px; }
    .form-card { border-color: #dbe3ef; box-shadow: 0 1px 3px rgba(15,23,42,.05); margin-bottom: 12px; }
    .form-card h3 { position: relative; margin-bottom: 10px; padding: 1px 0 6px 10px; border-bottom: 1px solid #eef2f7; font-size: 15px; font-weight: 800; color: #1e3a8a; letter-spacing: .5px; }
    .form-card h3::before { content:""; position:absolute; left:0; top:3px; bottom:7px; width:3px; border-radius:2px; background:#2563eb; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 48px; }
    .form-group { display: flex; align-items: center; gap: 4px; margin-bottom: 6px; }
    .form-group label { width: 72px; flex-shrink: 0; font-weight: 600; color: #111827; }
    .form-group input, .form-group select { flex: 0 1 260px; width: 260px; min-width: 0; }
    .form-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
    .error-box { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:8px 12px; border-radius:6px; margin-bottom:12px; font-size:13px; }
    @media (max-width:640px){ .form-grid { grid-template-columns: 1fr; } }
  </style>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body class="teacher-body">
  <%- include('partials/sidebar') %>
  <div class="teacher-main">
    <%- include('partials/header') %>
    <div class="teacher-content">
      <div class="course-detail-header">
        <h2>新建订单</h2>
      </div>

      <% if (typeof error !== 'undefined' && error) { %><div class="error-box"><%= error %></div><% } %>
      <%
        function fv(k) {
          if (typeof formData !== 'undefined' && formData && formData[k] != null) return formData[k];
          return '';
        }
      %>

      <form method="POST" action="/admin/orders-manage/new" class="order-form">
        <div class="form-card">
          <h3>订单信息</h3>
          <div class="form-grid">
            <div class="form-group">
              <label>学员</label>
              <select name="student_id" required>
                <option value="">选择学员</option>
                <% students.forEach(s => { %>
                  <option value="<%= s.id %>" <%= String(fv('student_id')) === String(s.id) ? 'selected' : '' %>><%= s.name %><% if (s.phone) { %>（<%= s.phone %>）<% } %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>课程</label>
              <select name="course_id" required>
                <option value="">选择课程</option>
                <% courses.forEach(c => { %>
                  <option value="<%= c.id %>" <%= String(fv('course_id')) === String(c.id) ? 'selected' : '' %>><%= c.title %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>金额</label>
              <input type="number" step="0.01" min="0" name="amount" value="<%= fv('amount') %>" placeholder="0.00" required>
            </div>
            <div class="form-group">
              <label>支付方式</label>
              <select name="payment_method">
                <option value="wechat" <%= fv('payment_method') === 'wechat' ? 'selected' : '' %>>微信支付</option>
                <option value="alipay" <%= fv('payment_method') === 'alipay' ? 'selected' : '' %>>支付宝</option>
                <option value="bank" <%= fv('payment_method') === 'bank' ? 'selected' : '' %>>银行转账</option>
                <option value="cash" <%= fv('payment_method') === 'cash' ? 'selected' : '' %>>线下现金</option>
              </select>
            </div>
            <div class="form-group">
              <label>状态</label>
              <select name="status">
                <option value="pending" <%= fv('status') === 'pending' ? 'selected' : '' %>>待支付</option>
                <option value="paid" <%= fv('status') === 'paid' ? 'selected' : '' %>>已支付</option>
                <option value="refunded" <%= fv('status') === 'refunded' ? 'selected' : '' %>>已退款</option>
                <option value="cancelled" <%= fv('status') === 'cancelled' ? 'selected' : '' %>>已取消</option>
              </select>
            </div>
          </div>
        </div>
        <div class="form-actions">
          <a href="/admin/orders-manage" class="btn btn-outline">取消</a>
          <button type="submit" class="btn btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
