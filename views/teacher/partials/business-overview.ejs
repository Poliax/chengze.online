<% const d=dashboard;const money=n=>Number(n).toLocaleString('zh-CN',{minimumFractionDigits:2,maximumFractionDigits:2});const sumOrders=d.orderStatus.reduce((s,r)=>s+r.value,0);const revenueMax=Math.max(1,...d.series.map(r=>r.amount));const peopleMax=Math.max(1,...d.series.map(r=>Math.max(r.registrations,r.enrollments)));const courseMax=Math.max(1,...d.courses.map(r=>Number(r.n)));const W=700,H=190,L=48,T=14,CW=632,CH=142;const x=i=>L+i*CW/Math.max(1,d.series.length-1);const y=v=>T+CH-v/revenueMax*CH;const line=d.series.map((r,i)=>(i?'L':'M')+x(i).toFixed(2)+','+y(r.amount).toFixed(2)).join(' '); %>

<div class="business-destinations"><span>系统入口</span><a href="https://www.chengze.online/" target="_blank" rel="noopener">承泽在线 <i>↗</i></a><a href="https://admin.chengze.online/teaching" target="_blank" rel="noopener">教师端 <i>↗</i></a><a href="/admin/schedule" target="_blank" rel="noopener">排课系统 <i>↗</i></a><span class="private-badge">仅超级账号可见</span></div>
<div class="business-heading"><div><h1>经营概览</h1></div><div class="business-controls"><span>北京时间 · 最近 <%= d.days %> 天</span><span class="business-refresh-status" role="status" aria-live="polite"></span><nav aria-label="统计时间范围"><% [7,30,90].forEach(n=>{ %><a href="/admin/dashboard?days=<%= n %>" class="<%= d.days===n?'active':'' %>" <%- d.days===n?'aria-current="page"':'' %>><%= n %>天</a><% }) %></nav></div></div>
<div class="business-kpis"><article><span>新增注册用户</span><strong><%= d.registered.toLocaleString('zh-CN') %><small>人</small></strong><p>所选期间新注册</p></article><article><span>首次开通课程学员</span><strong><%= d.enrolled.toLocaleString('zh-CN') %><small>人</small></strong><p>按首次课程开通去重</p></article><article><span>已付款订单登记金额</span><strong><small>¥</small><%= money(d.amount) %></strong><p>所选期间 · 按付款时间</p></article><article><span>已付款订单</span><strong><%= d.paidOrders.toLocaleString('zh-CN') %><small>笔</small></strong><p>所选期间 · 按付款时间</p></article></div>
<div class="business-chart-grid <%= d.amount ? '' : 'business-no-money' %>"><section class="business-panel business-wide business-revenue <%= d.amount ? '' : 'business-no-revenue' %>"><div class="business-panel-heading"><div><h2>订单登记金额趋势</h2><p><%= d.start %> — <%= d.today %> · 单位：元</p></div><span class="chart-key"><i></i>已付款</span></div>
<% if (d.amount>0) { %><svg class="business-line-chart" viewBox="0 0 700 190" role="img" aria-label="每日已付款订单登记金额折线图"><defs><linearGradient id="revenueFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#4F72CF" stop-opacity=".12"/><stop offset="100%" stop-color="#4F72CF" stop-opacity=".01"/></linearGradient></defs><% [0,.5,1].forEach(v=>{const yy=T+CH-v*CH; %><line x1="48" x2="680" y1="<%= yy %>" y2="<%= yy %>" stroke="#EBEFEB"/><text x="38" y="<%= yy+4 %>" text-anchor="end"><%= Math.round(revenueMax*v).toLocaleString('zh-CN') %></text><% }) %><path d="<%= line %> L680,156 L48,156 Z" fill="url(#revenueFill)"/><path d="<%= line %>" fill="none" stroke="#4F72CF" stroke-width="2.5" stroke-linejoin="round"/><% d.series.forEach((r,i)=>{ %><circle cx="<%= x(i) %>" cy="<%= y(r.amount) %>" r="3" fill="#4F72CF"><title><%= r.date %>：¥<%= money(r.amount) %>，<%= r.orders %>笔</title></circle><% });[0,Math.floor((d.series.length-1)/2),d.series.length-1].forEach(i=>{ %><text x="<%= x(i) %>" y="181" text-anchor="middle"><%= d.series[i].date.slice(5) %></text><% }) %></svg><% } else { %><div class="chart-empty"><span>暂无有效付款时间记录</span><small>缺少付款时间的订单未计入金额趋势，详见统计口径。</small></div><% } %>
<div class="chart-footnote">金额为系统订单登记值，包含人工或测试记录的可能性，不等同于真实支付到账或净收入。</div>
</section><section class="business-panel business-order"><div class="business-panel-heading"><div><h2>订单状态分布</h2><p>所选期间创建的订单</p></div></div><% if(sumOrders){let offset=0; %><div class="donut-wrap"><svg viewBox="0 0 180 180" role="img" aria-label="订单状态环形图"><circle cx="90" cy="90" r="65" fill="none" stroke="#F0F3EF" stroke-width="21"/><% d.orderStatus.forEach(r=>{const length=r.value/sumOrders*408.407; %><circle cx="90" cy="90" r="65" fill="none" stroke="<%= r.color %>" stroke-width="21" stroke-dasharray="<%= length %> <%= 408.407-length %>" stroke-dashoffset="<%= -offset %>" transform="rotate(-90 90 90)"><title><%= r.label %>：<%= r.value %>笔</title></circle><% offset+=length;}) %><text x="90" y="90" text-anchor="middle" class="donut-total"><%= sumOrders %></text><text x="90" y="112" text-anchor="middle">订单总数</text></svg></div><% }else{ %><div class="chart-empty donut-empty"><span>暂无订单</span><small>所选期间尚无订单记录。</small></div><% } %><div class="donut-legend"><% d.orderStatus.forEach(r=>{ %><div><span><i style="background:<%= r.color %>"></i><%= r.label %></span><b><%= r.value %></b></div><% }) %></div></section>
<section class="business-panel business-wide business-growth"><div class="business-panel-heading"><div><h2>注册与首次开课趋势</h2><p>单位：人 · 课程开通包含人工授权、测试账号与免费课</p></div><div class="chart-key"><i></i>注册 <i class="light"></i>首次开课</div></div>
<% if(d.registered||d.enrolled){const bw=CW/d.series.length; %><svg class="business-line-chart" viewBox="0 0 700 190" role="img" aria-label="每日注册与首次开课人数柱状图"><% [0,.5,1].forEach(v=>{const yy=T+CH-v*CH; %><line x1="48" x2="680" y1="<%= yy %>" y2="<%= yy %>" stroke="#EBEFEB"/><text x="38" y="<%= yy+4 %>" text-anchor="end"><%= Number((peopleMax*v).toFixed(1)) %></text><% }) %><% d.series.forEach((r,i)=>{const xx=L+i*bw; %><rect x="<%= xx+bw*.1 %>" y="<%= T+CH-r.registrations/peopleMax*CH %>" width="<%= bw*.33 %>" height="<%= r.registrations/peopleMax*CH %>" rx="1.5" fill="#4F72CF"><title><%= r.date %> 注册：<%= r.registrations %>人</title></rect><rect x="<%= xx+bw*.49 %>" y="<%= T+CH-r.enrollments/peopleMax*CH %>" width="<%= bw*.33 %>" height="<%= r.enrollments/peopleMax*CH %>" rx="1.5" fill="#69B6A4"><title><%= r.date %> 首次开课：<%= r.enrollments %>人</title></rect><% });[0,Math.floor((d.series.length-1)/2),d.series.length-1].forEach(i=>{ %><text x="<%= L+(i+.5)*bw %>" y="181" text-anchor="middle"><%= d.series[i].date.slice(5) %></text><% }) %></svg><% }else{ %><div class="chart-empty"><span>暂无新增记录</span><small>可切换更长的统计时间范围。</small></div><% } %>
</section><section class="business-panel business-ranking"><div class="business-panel-heading"><div><h2>课程覆盖人数 TOP 5</h2><p>累计 · 含课程包授权 · 单课程按学员去重</p></div></div><div class="course-bars"><% if(!d.courses.length){ %><div class="chart-empty"><span>暂无课程</span></div><% }d.courses.forEach((c,i)=>{ %><div class="course-bar"><div><span><em><%= i+1 %></em><%= c.title %></span><b><%= c.n %></b></div><div class="course-bar-track"><i style="width:<%= Number(c.n)/courseMax*100 %>%"></i></div></div><% }) %></div></section></div>
<div class="business-bottom"><section class="business-panel"><div class="business-panel-heading"><div><h2>服务待办</h2><p>当前未处理事项，不受上方时间范围影响</p></div></div><div class="business-todos"><a href="/admin/qa-manage"><span>待回答问题</span><strong><%= d.pendingQa %></strong><i>查看 →</i></a><a href="/admin/logistics-manage"><span>待发货</span><strong><%= d.pendingShipping %></strong><i>查看 →</i></a></div></section><section class="business-panel"><div class="business-panel-heading"><div><h2>平台规模与管理</h2><p>累计课程授权人数 <%= d.totalEnrolled %> · 课程 <%= d.courseCount %> · 课时 <%= d.lessonCount %></p></div></div><a class="business-account" href="/admin/accounts-manage"><span><b>账号管理</b><small>管理后台账号、岗位与权限</small></span><i>→</i></a></section></div>
<details class="business-definitions"><summary>统计口径与每日数据</summary><p>时间按北京时间，含今日；新增开课按每名学员在课程或课程包中的首次授权时间统计，不代表付费招生。订单金额仅统计当前状态为已付款且付款时间有效的记录，不扣除退款，不作财务对账依据。<% if(d.paidWithoutDate){ %>另有 <%= d.paidWithoutDate %> 笔已付款订单缺少有效付款时间，未计入金额趋势。<% } %></p><div class="business-table-scroll"><table><thead><tr><th>日期</th><th>注册人数</th><th>首次开课人数</th><th>已付款订单数</th><th>登记金额（元）</th></tr></thead><tbody><% d.series.forEach(r=>{ %><tr><td><%= r.date %></td><td><%= r.registrations %></td><td><%= r.enrollments %></td><td><%= r.orders %></td><td><%= money(r.amount) %></td></tr><% }) %></tbody></table></div></details><footer class="business-updated">数据更新时间：<%= d.updated %>（北京时间） · 刷新页面更新</footer>
