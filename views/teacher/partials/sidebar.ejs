<script>
(function(){
  function debounce(fn, wait){
    var t;
    return function(){ clearTimeout(t); t=setTimeout(fn, wait); };
  }
  document.querySelectorAll('form.toolbar-form').forEach(function(form){
    if(form.getAttribute('data-client-filter')) return;
    var els=form.querySelectorAll('input[type="text"], input:not([type]), select');
    if(!els.length) return;
    var submit=debounce(function(){ form.submit(); }, 400);
    els.forEach(function(el){
      el.addEventListener('input', submit);
      el.addEventListener('change', submit);
    });
  });
})();
</script>
