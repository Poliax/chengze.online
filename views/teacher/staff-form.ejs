<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/teacher.css?v=<%= cssVer %>">
  <style>
    .teacher-content { padding: 14px 16px 44px; }
    .staff-form { max-width: 820px; }
    .course-detail-header { margin-bottom: 10px; }
    .course-detail-header h2 { font-size: 17px; }
    .form-card { border-color: #dbe3ef; box-shadow: 0 1px 3px rgba(15,23,42,.05); margin-bottom: 12px; }
    .form-card h3 { position: relative; margin-bottom: 10px; padding: 1px 0 6px 10px; border-bottom: 1px solid #eef2f7; font-size: 15px; font-weight: 800; color: #1e3a8a; letter-spacing: .5px; }
    .form-card h3::before { content:""; position:absolute; left:0; top:3px; bottom:7px; width:3px; border-radius:2px; background:#2563eb; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 48px; }
    .form-group.full-width { grid-column: 1 / -1; }
    .form-group { display: flex; align-items: center; gap: 4px; margin-bottom: 6px; }
    .form-group label { width: 72px; flex-shrink: 0; font-weight: 600; color: #111827; }
    .form-group input, .form-group select, .form-group textarea { flex: 0 1 260px; width: 260px; min-width: 0; }
    .form-group .ctrl-wrap { flex: 0 1 260px; width: 260px; min-width: 0; }
    .form-group .ctrl-wrap input, .form-group .ctrl-wrap select, .form-group .ctrl-wrap textarea { width: 100%; }
    .form-group.full-width textarea, .form-group.full-width .ctrl-wrap { flex: 1 1 auto; width: 100%; }
    .staff-form input::placeholder, .staff-form textarea::placeholder { color: #9aa7b8; font-size: 12px; font-weight: 400; opacity: 1; font-family: 'PingFang SC', 'Microsoft YaHei', '黑体', 'SimHei', sans-serif; }
    .pw-toggle { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); width: 26px; height: 26px; border: none; background: transparent; cursor: pointer; color: #94a3b8; display: flex; align-items: center; justify-content: center; padding: 0; }
    .pw-toggle:hover { color: #2563eb; }
    .error-box { background:#fef2f2; border:1px solid #fecaca; color:#dc2626; padding:8px 12px; border-radius:6px; margin-bottom:12px; font-size:13px; }
    .form-tip { font-size: 11px; color: #94a3b8; margin-top: 3px; }
    @media (max-width:640px){ .form-grid { grid-template-columns: 1fr; } }
  </style>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-round.png?v=20261015-green9"><link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon-green-v9.ico"></head>
<body class="teacher-body">
  <%- include('partials/sidebar') %>
  <div class="teacher-main">
    <%- include('partials/header') %>
    <div class="teacher-content">
      <div class="course-detail-header">
        <h2><%= staff && staff.id ? '编辑教师' : '添加教师' %></h2>
      </div>

      <% if (typeof error !== 'undefined' && error) { %><div class="error-box"><%= error %></div><% } %>

      <%
        var isEdit = !!(staff && staff.id);
        var teacherNo = isEdit ? ((staff.teacher_no && staff.teacher_no.trim()) ? staff.teacher_no : ('T' + String(staff.id).padStart(3,'0'))) : (typeof nextTeacherNo !== 'undefined' ? nextTeacherNo : '');
        function fv(k) {
          if (isEdit) return (staff[k] == null ? '' : staff[k]);
          if (typeof formData !== 'undefined' && formData && formData[k] != null) return formData[k];
          return '';
        }
        var subjList = (typeof subjects !== 'undefined' && subjects) ? subjects : ['英语','数学','语文','计算机','政治','管理学','教育学','医学','会计','经济学','法学','艺术','体育'];
        var provinceList = ['山东省','陕西省','浙江省','北京市','上海市','天津市','重庆市','河北省','山西省','辽宁省','吉林省','黑龙江省','江苏省','安徽省','福建省','江西省','河南省','湖北省','湖南省','广东省','海南省','四川省','贵州省','云南省','甘肃省','青海省','内蒙古','广西','西藏','宁夏','新疆'];
        var hireVal = String(fv('hire_date')||'');
        var hireY = '', hireM = '', hireD = '';
        if (hireVal.indexOf('年') > -1) {
          var hp1 = hireVal.split('年');
          hireY = hp1[0] || '';
          var hp2 = (hp1[1]||'').split('月');
          hireM = parseInt(hp2[0]) || '';
          var hp3 = (hp2[1]||'').split('日');
          hireD = parseInt(hp3[0]) || '';
        } else {
          var hparts = hireVal.split('-');
          if (hparts.length === 3) {
            hireY = hparts[0];
            hireM = parseInt(hparts[1]) || '';
            hireD = parseInt(hparts[2]) || '';
          }
        }
        if (!isEdit && !hireVal) {
          var nowD = new Date();
          hireY = String(nowD.getFullYear());
          hireM = nowD.getMonth() + 1;
          hireD = nowD.getDate();
        }
        var hireDateVal = hireY ? hireY + '-' + String(parseInt(hireM) || '').padStart(2, '0') + '-' + String(parseInt(hireD) || '').padStart(2, '0') : '';
      %>

      <form method="POST" action="/admin/teachers-manage/<%= isEdit ? staff.id : 'new' %>" class="staff-form" enctype="multipart/form-data">
        <div class="form-card">
          <h3>基本信息</h3>
          <div class="form-grid">
            <div class="form-group">
              <label>真实姓名</label>
              <input name="real_name" value="<%= fv('real_name') %>">
            </div>
            <div class="form-group">
              <label>教师昵称</label>
              <input name="username" value="<%= fv('username') %>" required>
            </div>
            <div class="form-group">
              <label>教师照片</label>
              <div class="ctrl-wrap">
                <% if (fv('avatar')) { %><img src="<%= fv('avatar') %>" alt="教师照片" style="width:48px;height:48px;border-radius:50%;object-fit:cover;margin-bottom:6px;display:block"><% } %>
                <input type="file" name="avatar" accept="image/*" style="padding:4px;border:1px solid #d1d5db;border-radius:6px;background:#fff">
                <div class="form-tip">上传后展示在官网课程卡片教师头像</div>
              </div>
            </div>
            <div class="form-group">
              <label>联系电话</label>
              <div class="ctrl-wrap">
                <input name="phone" value="<%= fv('phone') %>" placeholder="授课后台登录账号">
              </div>
            </div>
            <div class="form-group">
              <label>登录密码</label>
              <div class="ctrl-wrap" style="position:relative">
                <% if (isEdit) { %>
                  <div id="pwSetState" style="display:flex;align-items:center;gap:8px;height:32px">
                    <span style="color:#16a34a;font-size:13px">已设置密码</span>
                    <button type="button" class="btn btn-outline btn-sm" onclick="showResetPw()">重置密码</button>
                  </div>
                  <div id="pwResetWrap" style="display:none;position:relative">
                    <input name="password" type="password" placeholder="请输入新密码" style="padding-right:34px" autocomplete="new-password">
                    <button type="button" class="pw-toggle" tabindex="-1" onclick="togglePw(this)">
                      <svg class="eye-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                      <svg class="eye-off" style="display:none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                  </div>
                <% } else { %>
                  <input name="password" type="password" placeholder="授课后台登录密码" style="padding-right:34px" required autocomplete="new-password">
                  <button type="button" class="pw-toggle" tabindex="-1" onclick="togglePw(this)">
                    <svg class="eye-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="eye-off" style="display:none" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                  </button>
                <% } %>
              </div>
            </div>
            <div class="form-group">
              <label>讲授科目</label>
              <select name="subject">
                <option value="">请选择</option>
                <% subjList.forEach(sub => { %>
                <option value="<%= sub %>" <%= fv('subject')===sub ? 'selected' : '' %>><%= sub %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>入职日期</label>
              <div style="display:flex;gap:4px;width:260px">
                <input type="date" name="hire_date" value="<%= hireDateVal %>">
              </div>
            </div>
            <div class="form-group">
              <label>办公地点</label>
              <input name="office_location" value="<%= fv('office_location') %>" placeholder="如：济南市历下区">
            </div>
            <div class="form-group">
              <label>讲授省份</label>
              <select name="province">
                <option value="">请选择</option>
                <% provinceList.forEach(function(pv) { %>
                <option value="<%= pv %>" <%= fv('province')===pv ? 'selected' : '' %>><%= pv %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group full-width">
              <label>个人简介</label>
              <textarea name="bio" rows="4" placeholder="将展示在课程详情页的教师简介中"><%= fv('bio') %></textarea>
            </div>
          </div>
        </div>

        <div class="form-card">
          <h3>账号信息</h3>
          <div class="form-grid">
            <div class="form-group">
              <label>教师编号</label>
              <input name="teacher_no" value="<%= teacherNo %>" placeholder="如 T003">
            </div>
            <div class="form-group">
              <label>授课后台</label>
              <select name="status">
                <option value="active" <%= fv('status')==='active' || !fv('status') ? 'selected' : '' %>>启用</option>
                <option value="disabled" <%= fv('status')==='disabled' ? 'selected' : '' %>>停用</option>
              </select>
            </div>
          </div>
        </div>

        <div class="form-actions">
          <a href="/admin/teachers-manage" class="btn btn-outline">取消</a>
          <button type="submit" class="btn btn-primary">保存</button>
        </div>
      </form>
    </div>
  </div>
  <script>
    function showResetPw(){
      var set = document.getElementById('pwSetState');
      var wrap = document.getElementById('pwResetWrap');
      if (set) set.style.display = 'none';
      if (wrap) wrap.style.display = 'block';
    }
    function togglePw(btn){
      var wrap = btn.closest('.ctrl-wrap');
      var input = wrap ? wrap.querySelector('input[name="password"]') : null;
      if (!input) return;
      var isPw = input.type === 'password';
      input.type = isPw ? 'text' : 'password';
      btn.querySelector('.eye-on').style.display = isPw ? 'none' : 'block';
      btn.querySelector('.eye-off').style.display = isPw ? 'block' : 'none';
    }
    document.getElementById('menuToggle')?.addEventListener('click',()=>{document.getElementById('sidebar').classList.toggle('open')});
  </script>
<script>
(function(){
  var form = document.querySelector('form.staff-form');
  if (!form) return;
  var fileInput = form.querySelector('input[name="avatar"]');
  var submitBtn = form.querySelector('button[type="submit"]');
  form.addEventListener('submit', function(e){
    if (!fileInput || !fileInput.files || !fileInput.files.length) return;
    var file = fileInput.files[0];
    if (file.type.indexOf('image/') !== 0) return;
    e.preventDefault();
    var img = new Image();
    var url = URL.createObjectURL(file);
    img.onload = function(){
      var max = 512;
      var scale = Math.min(1, max / Math.max(img.width, img.height));
      var canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(img.width * scale));
      canvas.height = Math.max(1, Math.round(img.height * scale));
      var ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      URL.revokeObjectURL(url);
      canvas.toBlob(function(blob){
        var fd = new FormData(form);
        if (blob) fd.set('avatar', blob, 'avatar.jpg');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = '上传中...'; }
        fetch(form.action, { method: 'POST', body: fd }).then(function(r){
          location.href = r.redirected ? r.url : form.action;
        }).catch(function(){ location.reload(); });
      }, 'image/jpeg', 0.85);
    };
    img.onerror = function(){ form.submit(); };
    img.src = url;
  });
})();
</script>
</body>
</html>
