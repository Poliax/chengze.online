    async function switchCamera(deviceId) {
      if (!deviceId) {
        camOn = false;
        if (cameraStream && cameraStream.getVideoTracks().length) {
          cameraStream.getVideoTracks().forEach(function(t) { t.enabled = false; });
        }
        var camPh = document.getElementById('camPlaceholder');
        if (camPh) camPh.style.display = 'flex';
        if (publishing && camClient && cameraLocal) {
          try { await camClient.unpublish(cameraLocal); } catch(e) {}
          try { cameraLocal.close(); } catch(e) {}
          cameraLocal = null;
        }
        refreshCameraList();
        setMsg('摄像头已关闭', 'ok');
        return;
      }
      camOn = true;
      try {
        var micId = '';
        if (cameraStream && cameraStream.getAudioTracks().length) {
          try { micId = cameraStream.getAudioTracks()[0].getSettings().deviceId || ''; } catch(e) {}
        }
        var audioC = micId ? { deviceId: { exact: micId } } : true;
        var newStream = await navigator.mediaDevices.getUserMedia({ video: { deviceId: { exact: deviceId }, width: CW, height: CH }, audio: audioC });
        if (cameraStream) cameraStream.getTracks().forEach(function(t) { t.stop(); });
