    function stopScreenShare(options) {
      screenShareGeneration++;
      var oldStream = screenStream, oldVideo = screenVideo;
      sharing = false; screenTrack = null; screenStream = null; screenVideo = null;
      releaseScreenCapture(oldStream, oldVideo);
      initCanvasPreview();
