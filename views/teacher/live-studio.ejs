    function docInteraction(name) {
      var n = String(name || '').toLowerCase();
      if (/\.(ppt|pptx)$/.test(n)) return 'flip';
      if (/\.(png|jpg|jpeg|gif|bmp|webp)$/.test(n)) return 'flip';
      return 'scroll';
    }

    function recomputeScrollTops(doc) {
      var top = 0;
      for (var k = 0; k < doc.layout.length; k++) {
        if (doc.layout[k]) { doc.layout[k].top = top; top += doc.layout[k].height + 24; }
      }
    }

    function ensureScrollLayout(doc) {
      if (!doc) return;
      if (doc.layoutReady) { scrollLayout = doc.layout; return; }
      if (!doc.layout) doc.layout = new Array(doc.pages.length);
      var loaded = 0, total = doc.pages.length;
      setMsg('课件加载中，请稍候...', '');
      doc.pages.forEach(function(url, i) {
        var img = new Image();
        img.onload = function() {
          var h = Math.round(img.height * CW / img.width);
          doc.layout[i] = { img: img, height: h, top: 0 };
          loaded++;
          recomputeScrollTops(doc);
          scrollLayout = doc.layout;
          if (loaded === total) {
            doc.layoutReady = true;
            var sm = scrollMax();
            if (scrollY > sm) scrollY = sm;
            if (scrollY < 0) scrollY = 0;
            updatePageUI();
            setMsg('', '');
          } else {
            updatePageUI();
          }
        };
        img.onerror = function() { loaded++; if (loaded === total) { doc.layoutReady = true; scrollLayout = doc.layout; updatePageUI(); setMsg('', ''); } };
        img.src = url;
      });
    }

    function switchDoc(i) {
      if (i < 0 || i >= coursewareDocs.length) return;
      if (i === docIndex) {
        var same = coursewareDocs[i];
        if (same) {
          currentInteraction = same.interaction || 'flip';
          coursewarePages = same.pages;
          pageIndex = same.pageIndex || 0;
          annCanvases = same.annCanvases || [];
          scrollY = same.scrollY || 0;
          scrollLayout = null;
          activeAnnCanvas = null;
          activeAnnIndex = -1;
          if (currentInteraction === 'scroll') ensureScrollLayout(same); else loadPage(pageIndex);
        }
        setMode('courseware');
        return;
      }
      if (docIndex >= 0 && coursewareDocs[docIndex]) {
        coursewareDocs[docIndex].pageIndex = pageIndex;
        coursewareDocs[docIndex].annCanvases = annCanvases;
        coursewareDocs[docIndex].scrollY = scrollY;
      }
      docIndex = i;
      var doc = coursewareDocs[i];
      coursewarePages = doc.pages;
      pageIndex = doc.pageIndex || 0;
      annCanvases = doc.annCanvases || [];
      currentInteraction = doc.interaction || 'flip';
      scrollY = doc.scrollY || 0;
      scrollLayout = null;
      activeAnnCanvas = null;
      activeAnnIndex = -1;
      setMode('courseware');
      if (currentInteraction === 'scroll') {
        ensureScrollLayout(doc);
      } else {
        loadPage(pageIndex);
      }
      renderCwMenu();
      saveStudioState();
    }

    function uploadCourseware(file, onDone, onError) {
      var fd = new FormData();
      fd.append('file', file);
      fetch('/admin/live/studio/' + COURSE_ID + '/upload', { method: 'POST', body: fd })
        .then(parseJsonResponse)
        .then(function(data) {
          if (data.jobId) {
            setMsg('课件已上传，正在后台转换，请稍候...', '');
            pollCoursewareJob(data.jobId, file.name, 90, onDone, onError);
            return;
          }
          if (!data.pages || !data.pages.length) { onError(data.error || '转换失败'); return; }
          onDone(file.name, data.pages);
        })
        .catch(function(err) { onError(err.message); });
    }

    function pollCoursewareJob(jobId, fileName, tries, onDone, onError) {
      fetch('/admin/live/studio/' + COURSE_ID + '/upload-status/' + jobId)
        .then(parseJsonResponse)
        .then(function(d) {
          if (d.status === 'done' && d.pages && d.pages.length) {
            onDone(fileName, d.pages);
          } else if (d.status === 'error') {
            onError(d.error || '转换失败');
          } else if (tries > 0) {
            setTimeout(function() { pollCoursewareJob(jobId, fileName, tries - 1, onDone, onError); }, 2000);
          } else {
            onError('转换超时');
          }
        })
        .catch(function(err) { onError(err.message); });
    }

    document.getElementById('coursewareInput').addEventListener('change', function(e) {
      var files = Array.prototype.slice.call(e.target.files || []);
      if (!files.length) return;
      e.target.value = '';
      var results = files.map(function(file, idx) { return { name: file.name, pages: null, error: null, idx: idx }; });
      var remaining = files.length;
      setMsg('正在上传课件 0/' + files.length + ' ...', '');
      files.forEach(function(file, idx) {
        uploadCourseware(file, function(name, pages) {
          results[idx].pages = pages;
          remaining--;
          if (remaining === 0) {
            coursewareDocs = coursewareDocs.concat(results.filter(function(r) { return r.pages; }).map(function(r) { return { name: r.name, pages: r.pages, pageIndex: 0, annCanvases: [], interaction: docInteraction(r.name), scrollY: 0, layout: null, layoutReady: false }; }));
            renderCwMenu();
            if (coursewareDocs.length) switchDoc(coursewareDocs.length - 1);
            var failed = results.filter(function(r) { return r.error; }).length;
            setMsg('课件上传完成：共 ' + coursewareDocs.length + ' 份' + (failed ? ('，失败 ' + failed + ' 份') : ''), failed ? 'err' : 'ok');
          } else {
            setMsg('正在上传课件 ' + (files.length - remaining) + '/' + files.length + ' ...', '');
          }
        }, function(errMsg) {
          results[idx].error = errMsg;
          remaining--;
          if (remaining === 0) {
            coursewareDocs = coursewareDocs.concat(results.filter(function(r) { return r.pages; }).map(function(r) { return { name: r.name, pages: r.pages, pageIndex: 0, annCanvases: [], interaction: docInteraction(r.name), scrollY: 0, layout: null, layoutReady: false }; }));
            renderCwMenu();
            if (coursewareDocs.length) switchDoc(coursewareDocs.length - 1);
            var failed = results.filter(function(r) { return r.error; }).length;
            setMsg('课件上传完成：共 ' + coursewareDocs.length + ' 份' + (failed ? ('，失败 ' + failed + ' 份') : ''), failed ? 'err' : 'ok');
          }
        });
      });
    });
    var wheelLockAt = 0;
    document.querySelector('.stage').addEventListener('wheel', function(e) {
      if (mode !== 'courseware' || !coursewarePages.length) return;
      if (e.target && e.target.closest && e.target.closest('.pen-toolbar')) return;
      e.preventDefault();
      if (currentInteraction === 'scroll') {
        var sm = scrollMax();
        scrollY = Math.max(0, Math.min(sm, scrollY + e.deltaY));
        if (coursewareDocs[docIndex]) coursewareDocs[docIndex].scrollY = scrollY;
        updatePageUI();
        saveStudioState();
        return;
      }
      var now = Date.now();
      if (now - wheelLockAt < 300) return;
      if (Math.abs(e.deltaY) < 8) return;
      if (e.deltaY > 0) { if (pageIndex < coursewarePages.length - 1) { wheelLockAt = now; loadPage(pageIndex + 1); } }
      else if (e.deltaY < 0) { if (pageIndex > 0) { wheelLockAt = now; loadPage(pageIndex - 1); } }
    }, { passive: false });
    window.addEventListener('keydown', function(ev) {
      var tag = document.activeElement ? document.activeElement.tagName : '';
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      var k = ev.key;
      if (k !== 'ArrowLeft' && k !== 'ArrowRight' && k !== 'ArrowUp' && k !== 'ArrowDown') return;
      ev.preventDefault();
      if (mode === 'whiteboard') {
        if (k === 'ArrowLeft' && wbPageIndex > 0) { wbPageIndex--; updatePageUI(); drawFrame(); }
        else if (k === 'ArrowRight' && wbPageIndex < wbPages.length - 1) { wbPageIndex++; updatePageUI(); drawFrame(); }
      } else if (mode === 'courseware' && coursewarePages.length) {
        if (currentInteraction === 'scroll') {
          if (k === 'ArrowUp' || k === 'ArrowDown') {
            var step = (k === 'ArrowUp') ? -120 : 120;
            scrollY = Math.max(0, Math.min(scrollMax(), scrollY + step));
            if (coursewareDocs[docIndex]) coursewareDocs[docIndex].scrollY = scrollY;
            updatePageUI(); saveStudioState();
          }
        } else {
          if (k === 'ArrowLeft' && pageIndex > 0) loadPage(pageIndex - 1);
          else if (k === 'ArrowRight' && pageIndex < coursewarePages.length - 1) loadPage(pageIndex + 1);
        }
      }
    });
    mainBtn.addEventListener('click', function() { if (publishing) stop(); else start(); });

    window.addEventListener('beforeunload', function(){ try { if (client) client.leave(); } catch(e) {} try { if (camClient) camClient.leave(); } catch(e) {} });
    newWhiteboardPage();
    var stateLoaded = false;
    var stateSaveTimer = null;
    var activeLessonId = document.getElementById('lessonSelect').value;
    var pendingStudioState = null;
    var stateWriteChain = Promise.resolve();
    function studioStateURL(){return '/admin/live/studio/'+COURSE_ID+'/state?lesson='+encodeURIComponent(activeLessonId);}
    function flushStudioState(){
      if(stateSaveTimer){clearTimeout(stateSaveTimer);stateSaveTimer=null;}
      if(!pendingStudioState)return stateWriteChain;
      var payload=pendingStudioState,url=studioStateURL();pendingStudioState=null;
      stateWriteChain=stateWriteChain.catch(function(){}).then(async function(){
        var response=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
        if(!response.ok){pendingStudioState=pendingStudioState||payload;throw new Error('课次存档保存失败');}
      });
      stateWriteChain.catch(function(){setMsg('板书未保存，请检查网络后重试','err');});
      return stateWriteChain;
    }
    document.getElementById('lessonSelect').addEventListener('change',async function(){
      var selected=this.value;if(selected===activeLessonId)return;
      if(publishing||!stateLoaded||!selected){this.value=activeLessonId;setMsg(publishing?'请先结束本次直播再切换课次':'课次尚未加载完成','err');return;}
      this.disabled=true;
      try{saveStudioState();await flushStudioState();var url=new URL(location.href);url.searchParams.set('lesson',selected);location.assign(url.href);}
      catch(error){this.value=activeLessonId;this.disabled=false;setMsg('保存未成功，已保留当前课次，请重试','err');}
    });
    function saveStudioState() {
      if (!stateLoaded) return;
      try {
        var state = {
          lessonId: Number(activeLessonId),
          mode: mode,
          docIndex: docIndex,
          wbPageIndex: wbPageIndex,
          wbPages: wbPages.map(function(c) { return c.toDataURL(); }),
          wbTexts: wbTexts.map(function(a) { return a || []; }),
          coursewareDocs: coursewareDocs.map(function(doc) {
            return {
              name: doc.name,
              pages: doc.pages,
              interaction: doc.interaction,
              pageIndex: doc.pageIndex || 0,
              scrollY: doc.scrollY || 0,
              annCanvases: (doc.annCanvases || []).map(function(c) { return c ? c.toDataURL() : ''; }),
              texts: doc.texts || []
            };
          })
        };
        if (stateSaveTimer) clearTimeout(stateSaveTimer);
        pendingStudioState=state;
        stateSaveTimer=setTimeout(function(){flushStudioState().catch(function(){});},800);
      } catch(e) {}
    }
    function canvasFromDataURL(url) {
      return new Promise(function(resolve) {
        var img = new Image();
        img.onload = function() {
          var c = document.createElement('canvas'); c.width = img.width; c.height = img.height;
          c.getContext('2d').drawImage(img, 0, 0);
          resolve(c);
        };
        img.onerror = function() { resolve(null); };
        img.src = url;
      });
    }
    async function restoreStudioState(saved) {
      if (!saved || saved.empty) { stateLoaded = true; setMode('whiteboard'); return; }
      var wbs = [];
      for (var wi = 0; wi < (saved.wbPages || []).length; wi++) {
        var wc = await canvasFromDataURL(saved.wbPages[wi]);
        if (wc) {
          if (wc.width !== CW || wc.height !== CH) {
            var n = document.createElement('canvas'); n.width = CW; n.height = CH;
            var nx = n.getContext('2d'); nx.fillStyle = '#ffffff'; nx.fillRect(0, 0, CW, CH); nx.drawImage(wc, 0, 0, CW, CH);
            wc = n;
          }
          wbs.push(wc);
        }
      }
      if (!wbs.length) {
        var c0 = document.createElement('canvas'); c0.width = CW; c0.height = CH;
        var x0 = c0.getContext('2d'); x0.fillStyle = '#ffffff'; x0.fillRect(0, 0, CW, CH);
        wbs.push(c0);
      }
      wbPages = wbs;
      wbTexts = (saved.wbTexts || []).map(function(a) { return a || []; });
      while (wbTexts.length < wbPages.length) wbTexts.push([]);
      wbPageIndex = Math.max(0, Math.min(saved.wbPageIndex || 0, wbPages.length - 1));
      coursewareDocs = [];
      for (var di2 = 0; di2 < (saved.coursewareDocs || []).length; di2++) {
        var sd = saved.coursewareDocs[di2];
        var anns = [];
        for (var ai = 0; ai < (sd.annCanvases || []).length; ai++) {
          if (sd.annCanvases[ai]) {
            var ac = await canvasFromDataURL(sd.annCanvases[ai]);
            if (ac && (ac.width !== CW || ac.height !== CH)) {
              var an = document.createElement('canvas'); an.width = CW; an.height = CH;
              an.getContext('2d').drawImage(ac, 0, 0, CW, CH);
              ac = an;
            }
            anns.push(ac || null);
          }
          else anns.push(null);
        }
        coursewareDocs.push({
          name: sd.name,
          pages: sd.pages || [],
          interaction: sd.interaction || 'flip',
          pageIndex: sd.pageIndex || 0,
          scrollY: sd.scrollY || 0,
          annCanvases: anns,
          texts: sd.texts || [],
          layout: null,
          layoutReady: false
        });
      }
      stateLoaded = true;
      renderCwMenu();
      if (saved.mode === 'courseware' && coursewareDocs.length) {
        var di = Math.max(0, Math.min(saved.docIndex || 0, coursewareDocs.length - 1));
        switchDoc(di);
      } else {
        setMode('whiteboard');
        updatePageUI();
      }
      saveStudioState();
    }
    // Treat board, camera and chat as one proportional workspace.
    function fitStudioStage() {
      var wrap = document.querySelector('.wrap');
      var topbar = document.querySelector('.topbar');
      var status = document.querySelector('.msgbar');
      if (!wrap || !topbar) return;
      var viewportWidth = window.innerWidth || document.documentElement.clientWidth;
      var viewportHeight = window.innerHeight || document.documentElement.clientHeight;
      var headerBottom = topbar.getBoundingClientRect().bottom;
      var availableWidth = Math.max(1, viewportWidth - 24);
      var availableHeight = Math.max(1, viewportHeight - headerBottom - 48);
      // Base camera width is 200px; cap enlargement at 220px.
      var scale = Math.min(1.1, availableWidth / 1172, availableHeight / 540);
      var left = (viewportWidth - 1172 * scale) / 2;
      var top = headerBottom + 12 + Math.max(0, (availableHeight - 540 * scale) / 2);
      wrap.style.left = left + 'px';
      wrap.style.top = top + 'px';
      wrap.style.transform = 'scale(' + scale + ')';
      if (status) {
        status.style.left = left + 'px';
        status.style.top = (top + 540 * scale + 8) + 'px';
        status.style.width = (1172 * scale) + 'px';
      }
    }
    var studioResizeFrame = 0;
    function scheduleStudioLayout() {
      if (studioResizeFrame) return;
      studioResizeFrame = requestAnimationFrame(function() {
        studioResizeFrame = 0;
        fitStudioStage();
      });
    }
    window.addEventListener('resize', scheduleStudioLayout);
    window.addEventListener('orientationchange', scheduleStudioLayout);
    if (window.visualViewport) window.visualViewport.addEventListener('resize', scheduleStudioLayout);
    if (window.ResizeObserver) {
      var studioResizeObserver = new window.ResizeObserver(scheduleStudioLayout);
      studioResizeObserver.observe(document.querySelector('.stage-main'));
    }
    fitStudioStage();
    // Display the board before requesting camera/microphone permission.
    initCanvasPreview();
    setMode('whiteboard');
    (function loadStudioState() {
      fetch(studioStateURL(),{cache:'no-store'})
        .then(function(r) { if(!r.ok)throw new Error('读取失败');return r.json(); })
        .then(function(saved) { return restoreStudioState(saved); })
        .catch(function() { stateLoaded=false;setMsg('当前课次存档加载失败，请刷新重试，暂不保存以保护原板书','err'); });
    })();
    setupPen();
    var capChecks = [];
    if (!(window.HTMLCanvasElement && window.HTMLCanvasElement.prototype && window.HTMLCanvasElement.prototype.captureStream)) capChecks.push('canvas.captureStream');
    if (!window.PointerEvent) capChecks.push('PointerEvent');
    if (!window.RTCPeerConnection && !window.webkitRTCPeerConnection) capChecks.push('WebRTC');
    if (capChecks.length) {
      setMsg('当前浏览器缺少直播所需能力（' + capChecks.join('、') + '），请升级 Edge/Chrome 到最新版本，并确认未使用 IE 模式', 'err');
    }
    initCamera();
    var previewWarned = false;
    function checkPreviewSource() {
      try {
        var probe = document.createElement('video');
        probe.muted = true; probe.playsinline = true;
        probe.srcObject = publishCanvas.captureStream(30);
        probe.onloadeddata = function() {
          try {
            var c = document.createElement('canvas'); c.width = probe.videoWidth || publishCanvas.width; c.height = probe.videoHeight || publishCanvas.height;
            var x = c.getContext('2d'); x.drawImage(probe, 0, 0, c.width, c.height);
            var d = x.getImageData(0, 0, c.width, c.height).data;
            var bright = 0;
            for (var i = 0; i < d.length; i += 400) { if (d[i] > 120 || d[i+1] > 120 || d[i+2] > 120) bright++; }
            if (bright === 0 && !sharing && !previewWarned) { previewWarned = true; setMsg('推流画面源异常（全黑）：学生端可能看到黑屏，请在 Edge 设置中切换“使用硬件加速”后刷新重试', 'err'); }
          } catch(e) {}
        };
        probe.play().catch(function(){});
      } catch(e) {}
    }
    setTimeout(checkPreviewSource, 2500);
  </script>
</body>
</html>
