      }
    }
    async function switchAudio(deviceId) {
      if (!deviceId) {
        micOn = false;
        if (cameraStream && cameraStream.getAudioTracks().length) {
          cameraStream.getAudioTracks().forEach(function(t) { t.enabled = false; });
        }
        if (publishing && client && localStream) {
          var vTrack = getCanvasPublishTrack();
          var opts = { userId: USERID, videoSource: vTrack, videoProfile: '720p', videoBitrate: 3000, videoFps: 30 };
          try { await client.unpublish(localStream); } catch(e) {}
          try { localStream.close(); } catch(e) {}
          localStream = TRTC.createStream(opts);
          try { localStream.setVideoProfile({ width: 1280, height: 720, frameRate: 30, bitrate: 3000 }); } catch(e) {}
          await localStream.initialize();
          if (sharing) showScreenPreview(); else initCanvasPreview();
          await client.publish(localStream);
        }
        refreshCameraList();
        startAudioMeter();
        setMsg('麦克风已关闭', 'ok');
        return;
      }
      micOn = true;
      try {
        var audioOnly = await navigator.mediaDevices.getUserMedia({ audio: { deviceId: { exact: deviceId } } });
        var newAudioTrack = audioOnly.getAudioTracks()[0];
        if (cameraStream) {
          var oldAudio = cameraStream.getAudioTracks()[0];
          if (oldAudio) {
            try { cameraStream.removeTrack(oldAudio); oldAudio.stop(); } catch(e) {}
          }
          try { cameraStream.addTrack(newAudioTrack); } catch(e) {}
        }
        applyToggles();
        refreshCameraList();
        if (publishing && client && localStream) {
          try {
            if (newAudioTrack) await localStream.replaceTrack(newAudioTrack);
          } catch(e) {
            var vTrack = getCanvasPublishTrack();
            var opts = { userId: USERID, videoSource: vTrack, videoProfile: '720p', videoBitrate: 3000, videoFps: 30 };
