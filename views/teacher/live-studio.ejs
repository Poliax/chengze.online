          var nx = point.x - dragState.dx;
          var ny = point.y - dragState.dy;
          nx = Math.max(0, Math.min(box.clientWidth - 120, nx));
          ny = Math.max(0, Math.min(box.clientHeight - 70, ny));
          wrap.style.left = nx + 'px';
          wrap.style.top = ny + 'px';
        });
        wrap.addEventListener('pointerup', function() { dragState = null; });
        wrap.addEventListener('pointercancel', function() { dragState = null; });
      } catch (err) {
        setMsg('创建输入框失败：' + (err && err.message ? err.message : err), 'err');
      }
    }

    function commitTextInput() {
      var inp = existingTextInput;
      if (!inp) return;
      existingTextInput = null;
      var wrap0 = existingTextWrap;
      var textColor = (wrap0 && wrap0._color) || currentColor;
      var textSize = (wrap0 && wrap0._size) || 48;
      var text = inp.value.trim();
      var box = document.getElementById('localPreview');
      var ir = inp.getBoundingClientRect();
      var br = box.getBoundingClientRect();
      var x = (ir.left - br.left) / br.width * CW;
      var y = (ir.top - br.top) / br.height * CH;
      x = (x - viewX) / viewScale; y = (y - viewY) / viewScale;
      if (existingTextWrap) { existingTextWrap.remove(); existingTextWrap = null; }
      if (!text) return;
      var c, tx, ty;
      if (mode === 'courseware' && currentInteraction === 'scroll') {
        var hit = scrollPageAt(scrollY + y);
        if (!hit) return;
        if (!annCanvases[hit.idx]) { var cc = document.createElement('canvas'); cc.width = CW; cc.height = CH; annCanvases[hit.idx] = cc; }
        c = annCanvases[hit.idx].getContext('2d');
        tx = x;
        ty = (scrollY + y - hit.top) / hit.h * CH;
      } else {
        c = mode === 'whiteboard' ? currentWb().getContext('2d') : currentAnn().getContext('2d');
        tx = x; ty = y;
      }
      if (mode === 'whiteboard' || (mode === 'courseware' && currentInteraction !== 'scroll')) {
        var tArr = currentTextArr();
        if (editingText) {
          editingText.text = text;
          editingText.x = x;
          editingText.y = y;
          editingText.color = textColor;
          editingText.size = textSize;
        } else if (tArr) {
          tArr.push({ text: text, x: x, y: y, color: textColor, size: textSize });
        }
        editingText = null;
        saveStudioState();
        return;
      }
      c.save();
      c.globalCompositeOperation = 'source-over';
      c.fillStyle = textColor;
      c.font = 'bold ' + textSize + 'px -apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif';
      c.textBaseline = 'top';
      c.fillText(text, tx, ty);
      c.restore();
      saveStudioState();
    }

    function cancelTextInput() {
      if (existingTextWrap) { existingTextWrap.remove(); existingTextWrap = null; }
      existingTextInput = null;
      editingText = null;
    }

    var viewScale = 1, viewX = 0, viewY = 0, viewTool = null;
    var panStart = null;
    function zoomAt(cx, cy, factor) {
      var ns = Math.max(0.4, Math.min(3, viewScale * factor));
      var k = ns / viewScale;
