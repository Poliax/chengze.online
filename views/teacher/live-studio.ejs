        var camPrev = document.getElementById('cameraPreview');
        if (camPrev) { camPrev.srcObject = cameraStream; try { camPrev.play(); } catch(e) {} }
        applyToggles();
        refreshCameraList();
        var camPh = document.getElementById('camPlaceholder');
        if (camPh) camPh.style.display = 'none';
        if (publishing && camClient && cameraLocal) {
          var newVt = cameraStream.getVideoTracks()[0];
          try {
            await cameraLocal.replaceTrack(newVt);
          } catch(e) {
            try { await camClient.unpublish(cameraLocal); } catch(e) {}
            try { cameraLocal.close(); } catch(e) {}
            cameraLocal = null;
            cameraLocal = TRTC.createStream({ videoSource: newVt, videoProfile: '720p' });
            try { cameraLocal.setVideoProfile('720p'); } catch(e) {}
            await cameraLocal.initialize();
            await camClient.publish(cameraLocal);
          }
        }
        startAudioMeter();
        setMsg('已切换摄像头', 'ok');
      } catch(e) {
