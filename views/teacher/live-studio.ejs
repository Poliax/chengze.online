  <div class="msgbar"><div class="msg" id="msg"></div></div>
  <div id="confirmModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:100;align-items:center;justify-content:center;">
    <div style="background:#111a2e;border:1px solid rgba(255,255,255,.14);border-radius:12px;padding:20px 24px;max-width:360px;width:90%;box-shadow:0 20px 50px rgba(0,0,0,.5);">
      <div id="confirmText" style="font-size:14px;color:#fff;margin-bottom:16px;"></div>
      <div style="display:flex;justify-content:flex-end;gap:10px;">
        <button id="confirmCancel" class="btn btn-upload">取消</button>
        <button id="confirmOk" class="btn btn-main" style="background:#dc2626;">确认删除</button>
      </div>
    </div>
  </div>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/player/trtc.js"></script>
  <script>
    var SDKAPPID = <%= sdkAppId %>;
    var USERID = '<%= userId %>';
    var USERSIG = '<%= userSig %>';
    var PRIVATE_MAP_KEY = '<%= privateMapKey %>';
    var CAM_PRIVATE_MAP_KEY = '<%= camPrivateMapKey %>';
    var CAM_USERID = '<%= camUserId %>';
    var CAM_USERSIG = '<%= camUserSig %>';
    var ROOMID = <%= roomId %>;
    var STREAM_ID = <%= stream.id %>;
    var COURSE_ID = <%= course.id %>;
    (function() {
      var params = new URLSearchParams(location.search);
      var lid = params.get('lesson');
      var sel = document.getElementById('lessonSelect');
      if (lid) {
        if (sel) sel.value = lid;
      } else if (sel && sel.options.length > 0) {
        sel.selectedIndex = sel.options.length > 1 ? 1 : 0;
      }
    })();

    var socket = io();
    socket.emit('live:join', { courseId: COURSE_ID, role: 'teacher' });
    (function(){ var wt = document.getElementById('welcomeTime'); if (wt) wt.textContent = fmtChatTime(new Date()); })();
    socket.on('live:online', function(d) { var el = document.getElementById('onlineCount'); if (el) el.textContent = (d.count || 0) + ' 人'; });
    socket.on('live:onlineList', function(d) {
      var el = document.getElementById('onlineList');
      if (!el) return;
      var list = d.list || [];
      el.innerHTML = '';
      if (!list.length) { el.textContent = '暂无学员在线'; return; }
      list.forEach(function(item) {
        var row = document.createElement('div');
        row.className = 'online-row';
        var avatar = document.createElement('span');
        avatar.className = 'online-avatar';
        avatar.textContent = (item.name || '学').charAt(0);
        var nameSpan = document.createElement('span');
        nameSpan.className = 'online-name';
        nameSpan.textContent = item.name || '学生';
        var uidSpan = document.createElement('span');
        uidSpan.className = 'online-uid';
        uidSpan.textContent = item.uid || '';
        row.appendChild(avatar);
        row.appendChild(nameSpan);
        row.appendChild(uidSpan);
        el.appendChild(row);
      });
    });
    var chatMsgs = document.getElementById('chatMsgs');
    function fmtChatTime(t) {
      try {
        var d = t ? new Date(t) : new Date();
        function p(n) { return (n < 10 ? '0' + n : '' + n); }
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
      } catch(e) { return ''; }
    }
    socket.on('live:chat', function(data) {
      var div = document.createElement('div'); div.className = 'chat-msg';
      var head = document.createElement('div'); head.className = 'head';
      var who = document.createElement('span'); who.className = 'who'; who.textContent = data.sender || '学生';
      var tm = document.createElement('span'); tm.className = 'time'; tm.textContent = fmtChatTime(data.time);
      var txt = document.createElement('span'); txt.className = 'txt'; txt.textContent = data.content || '';
      head.appendChild(who); head.appendChild(tm);
      div.appendChild(head); div.appendChild(txt);
      chatMsgs.appendChild(div); chatMsgs.scrollTop = chatMsgs.scrollHeight;
    });
    document.getElementById('chatSend').addEventListener('click', function() {
      var input = document.getElementById('chatInput');
      if (!input.value.trim()) return;
      socket.emit('live:chat', { courseId: COURSE_ID, sender: '老师', content: input.value.trim() });
      input.value = '';
    });
    document.getElementById('chatInput').addEventListener('keydown', function(e) { if (e.key === 'Enter') document.getElementById('chatSend').click(); });

    var CW = 1920, CH = 1080;
    var canvas = document.createElement('canvas'); canvas.width = CW; canvas.height = CH;
    var ctx = canvas.getContext('2d');
    ctx.fillStyle='#fff';ctx.fillRect(0,0,CW,CH);
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
    var publishCanvas = document.createElement('canvas'); publishCanvas.width = 1280; publishCanvas.height = 720;
    var publishCtx = publishCanvas.getContext('2d');
    publishCtx.fillStyle='#fff';publishCtx.fillRect(0,0,publishCanvas.width,publishCanvas.height);
    publishCtx.lineCap = 'round'; publishCtx.lineJoin = 'round';
    publishCtx.imageSmoothingEnabled = true; publishCtx.imageSmoothingQuality = 'high';
    var mode = 'none';
    var coursewarePages = [];
    var coursewareDocs = [];
    var docIndex = -1;
    var pageIndex = 0;
    var loadToken = 0;
    var pageImages = [];
    var coursewareImage = null;
    var annCanvases = [];
    var currentInteraction = 'flip';
    var scrollY = 0;
    var scrollLayout = null;
    var activeAnnIndex = -1;
    var activeAnnCanvas = null;
    var activeAnnHeight = 0;
    var wbPages = [];
    var wbTexts = [];
    var editingText = null;
    var selectedText = null;
    var textDrag = null;
    var wbPageIndex = 0;
    var drawing = false;
    var currentTool = 'pen';
    var currentColor = '#e11d48';
    var penSize = 5;
    var startPoint = null;
    var undoStack = [], redoStack = [];
    var cameraStream = null;
    var cameraVideo = null;
    var client = null;
    var localStream = null;
    var cameraLocal = null;
    var camClient = null;
    var publishing = false;
    var rafId = null;
    var msgEl = document.getElementById('msg');
    var wbBtn = document.getElementById('modeWb');
    var cwBtn = document.getElementById('modeCw');
    var mainBtn = document.getElementById('mainBtn');
    var pageLabel = document.getElementById('pageLabel');
    var toolCursor = document.getElementById('toolCursor');
    var previewBase = null;
    var existingTextInput = null;
    var existingTextWrap = null;
    var laserCanvas = document.createElement('canvas'); laserCanvas.width = CW; laserCanvas.height = CH;
    var laserCtx = laserCanvas.getContext('2d');
    var laserSegments = [];
    var laserFadeMs = 1400;
    function addLaserSegment(a, b) {
      laserSegments.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y, t: Date.now() });
      if (laserSegments.length > 400) laserSegments.splice(0, laserSegments.length - 400);
    }
    function drawLaserFrame() {
      laserCtx.clearRect(0, 0, CW, CH);
      var now = Date.now();
      var kept = [];
      for (var i = 0; i < laserSegments.length; i++) {
        var seg = laserSegments[i];
        var age = now - seg.t;
        if (age >= laserFadeMs) continue;
        kept.push(seg);
        var alpha = 1 - age / laserFadeMs;
        laserCtx.save();
        laserCtx.globalCompositeOperation = 'source-over';
        laserCtx.globalAlpha = alpha;
        laserCtx.strokeStyle = currentColor;
        laserCtx.lineWidth = Math.max(3, penSize);
        laserCtx.lineCap = 'round';
        laserCtx.shadowColor = currentColor;
        laserCtx.shadowBlur = 4;
        laserCtx.beginPath(); laserCtx.moveTo(seg.x1, seg.y1); laserCtx.lineTo(seg.x2, seg.y2); laserCtx.stroke();
        laserCtx.restore();
      }
      laserSegments = kept;
    }
    var confirmModal = document.getElementById('confirmModal');
    var confirmTextEl = document.getElementById('confirmText');
    var confirmOkBtn = document.getElementById('confirmOk');
    var confirmCancelBtn = document.getElementById('confirmCancel');
    var confirmCb = null;
    function askConfirm(text, cb) {
      confirmTextEl.textContent = text;
      confirmCb = cb;
      confirmModal.style.display = 'flex';
    }
    confirmOkBtn.addEventListener('click', function() {
      var cb = confirmCb; confirmCb = null;
      confirmModal.style.display = 'none';
      if (cb) cb();
    });
    confirmCancelBtn.addEventListener('click', function() {
      confirmCb = null;
      confirmModal.style.display = 'none';
    });

    function setMsg(text, type) { msgEl.textContent = text; msgEl.className = 'msg ' + (type || ''); }


    function newWhiteboardPage() {
      var c = document.createElement('canvas'); c.width = CW; c.height = CH;
      var cx = c.getContext('2d'); cx.fillStyle = '#ffffff'; cx.fillRect(0, 0, CW, CH);
      wbPages.push(c); wbTexts.push([]); wbPageIndex = wbPages.length - 1; return c;
    }
    function currentWb() { return wbPages[wbPageIndex] || newWhiteboardPage(); }
    function currentAnn() { if (!annCanvases[pageIndex]) { var c = document.createElement('canvas'); c.width = CW; c.height = CH; annCanvases[pageIndex] = c; } return annCanvases[pageIndex]; }

    function setMode(m) {
      if (sharing || screenShareBusy) stopScreenShare();
      mode = m;
      wbBtn.classList.toggle('active', m === 'whiteboard');
      cwBtn.classList.toggle('active', m === 'courseware');
      updatePageUI();
      drawFrame();
      updateToolCursor(null);
      saveStudioState();
    }

    var stageBadge = document.getElementById('stagePageBadge');
    var wbPrevItem = document.getElementById('wbPrevItem');
    var wbNextItem = document.getElementById('wbNextItem');
    var cwPrevItem = document.getElementById('cwPrevItem');
    var cwNextItem = document.getElementById('cwNextItem');
    function updatePageUI() {
      var wbMode = mode === 'whiteboard';
      if (wbPrevItem) wbPrevItem.disabled = !wbMode || wbPageIndex <= 0;
      if (wbNextItem) wbNextItem.disabled = !wbMode || wbPageIndex >= wbPages.length - 1;
      var cwMode = mode === 'courseware' && coursewarePages.length;
      if (cwPrevItem) cwPrevItem.disabled = !cwMode || (currentInteraction === 'scroll' ? scrollY <= 0 : pageIndex <= 0);
      if (cwNextItem) cwNextItem.disabled = !cwMode || (currentInteraction === 'scroll' ? scrollY >= scrollMax() : pageIndex >= coursewarePages.length - 1);
      if (wbMode) {
        pageLabel.textContent = '白板 第 ' + (wbPageIndex + 1) + ' / ' + wbPages.length + ' 页';
      } else if (mode === 'courseware' && coursewarePages.length && currentInteraction === 'scroll') {
        pageLabel.textContent = '课件 · 滚动浏览';
      } else if (mode === 'courseware' && coursewarePages.length) {
        pageLabel.textContent = '课件 第 ' + (pageIndex + 1) + ' / ' + coursewarePages.length + ' 页';
      } else {
        pageLabel.textContent = '';
        stageBadge.style.display = 'none';
      }
      if (wbMode) { stageBadge.textContent = (wbPageIndex + 1) + '/' + wbPages.length; stageBadge.style.display = 'block'; }
      else if (mode === 'courseware' && coursewarePages.length && currentInteraction === 'scroll') {
        var sm2 = scrollMax();
        var pct = sm2 > 0 ? Math.min(100, Math.round(scrollY / sm2 * 100)) : 0;
        stageBadge.textContent = pct + '%';
        stageBadge.style.display = 'block';
      }
      else if (mode === 'courseware' && coursewarePages.length) { stageBadge.textContent = (pageIndex + 1) + '/' + coursewarePages.length; stageBadge.style.display = 'block'; }
      saveStudioState();
    }

    function loadPage(i) {
      if (!coursewarePages.length) return;
      var token = ++loadToken;
      var img = pageImages[i];
      if (img && img.complete && img.naturalWidth) {
        applyPage(i, img, token);
        return;
      }
      if (!img) {
        img = new Image();
        pageImages[i] = img;
        img.onload = function() { if (token === loadToken) applyPage(i, img, token); };
        img.onerror = function() { setMsg('课件图片加载失败：' + coursewarePages[i], 'err'); };
        img.src = coursewarePages[i];
        var next = i + 1;
        if (next < coursewarePages.length && !pageImages[next]) {
          var pre = new Image();
          pageImages[next] = pre;
          pre.src = coursewarePages[next];
        }
      }
    }
    function applyPage(i, img, token) {
      if (token !== loadToken) return;
      coursewareImage = img;
      pageIndex = i;
      updatePageUI();
      drawFrame();
      saveStudioState();
    }

    function drawTexts(arr) {
      if (!arr || !arr.length) return;
      ctx.save();
      ctx.textBaseline = 'top';
      for (var i = 0; i < arr.length; i++) {
        var t = arr[i];
        ctx.fillStyle = t.color || currentColor;
        ctx.font = 'bold ' + (t.size || 48) + 'px -apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif';
        ctx.fillText(t.text, t.x, t.y);
        if (selectedText && t === selectedText) {
          var w = String(t.text).length * (t.size || 48) * 0.62;
          var h = (t.size || 48) * 1.3;
          ctx.strokeStyle = '#2563eb';
          ctx.lineWidth = 2;
          ctx.setLineDash([8, 6]);
          ctx.strokeRect(t.x - 6, t.y - 6, w + 12, h + 12);
          ctx.setLineDash([]);
        }
      }
      ctx.restore();
    }

    function currentTextArr() {
      if (mode === 'whiteboard') { if (!wbTexts[wbPageIndex]) wbTexts[wbPageIndex] = []; return wbTexts[wbPageIndex]; }
      if (mode === 'courseware' && currentInteraction !== 'scroll' && coursewareDocs[docIndex]) {
        var doc = coursewareDocs[docIndex];
        if (!doc.texts) doc.texts = [];
        if (!doc.texts[pageIndex]) doc.texts[pageIndex] = [];
        return doc.texts[pageIndex];
      }
      return null;
    }

    function hitTextObject(p) {
      var arr = currentTextArr();
      if (!arr) return null;
      for (var i = arr.length - 1; i >= 0; i--) {
        var t = arr[i];
        var w = String(t.text).length * (t.size || 48) * 0.62;
        var h = (t.size || 48) * 1.3;
        if (p.x >= t.x - 10 && p.x <= t.x + w + 10 && p.y >= t.y - 10 && p.y <= t.y + h + 10) return t;
      }
      return null;
    }

    function drawFrame() {
      if (rafId) cancelAnimationFrame(rafId);
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(0, 0, CW, CH);
      ctx.save();
      if (!sharing) { ctx.translate(viewX, viewY); ctx.scale(viewScale, viewScale); }
      ctx.fillStyle = '#22262f';
      ctx.fillRect(0, 0, CW, CH);
      if (sharing) {
        renderSharedScreen(ctx, CW, CH);
      } else if (mode === 'whiteboard') {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, CW, CH);
        ctx.drawImage(currentWb(), 0, 0, CW, CH);
        if (wbTexts[wbPageIndex]) drawTexts(wbTexts[wbPageIndex]);
      } else if (mode === 'courseware' && currentInteraction === 'scroll' && scrollLayout) {
        for (var si = 0; si < scrollLayout.length; si++) {
          var pg = scrollLayout[si];
          if (!pg || !pg.img) continue;
          var pTop = pg.top, pBot = pg.top + pg.height;
          if (pBot < scrollY || pTop > scrollY + CH) continue;
          var vTop = Math.max(pTop, scrollY), vBot = Math.min(pBot, scrollY + CH);
          var srcY = (vTop - pTop) / pg.height * pg.img.height;
          var srcH = (vBot - vTop) / pg.height * pg.img.height;
          var dstY = vTop - scrollY, dstH = vBot - vTop;
          ctx.drawImage(pg.img, 0, srcY, pg.img.width, srcH, 0, dstY, CW, dstH);
          if (annCanvases[si]) {
            var aSrcY = (vTop - pTop) / pg.height * CH;
            var aSrcH = (vBot - vTop) / pg.height * CH;
            ctx.drawImage(annCanvases[si], 0, aSrcY, CW, aSrcH, 0, dstY, CW, dstH);
          }
        }
      } else if (mode === 'courseware' && coursewareImage) {
        var iw = coursewareImage.width, ih = coursewareImage.height;
        var scale = Math.max(CW / iw, CH / ih);
        var dw = iw * scale, dh = ih * scale;
        ctx.drawImage(coursewareImage, (CW - dw) / 2, (CH - dh) / 2, dw, dh);
        if (annCanvases[pageIndex]) ctx.drawImage(annCanvases[pageIndex], 0, 0, CW, CH);
        if (coursewareDocs[docIndex] && coursewareDocs[docIndex].texts) drawTexts(coursewareDocs[docIndex].texts[pageIndex]);
      }
      if (selection && selCanvas) {
        ctx.drawImage(selCanvas, Math.round(selX), Math.round(selY));
        ctx.strokeStyle = '#2563eb'; ctx.lineWidth = 2 / viewScale; ctx.setLineDash([8 / viewScale, 6 / viewScale]);
        ctx.strokeRect(selX, selY, selW, selH); ctx.setLineDash([]);
      }
      if (selStart && selCur) {
        ctx.strokeStyle = '#2563eb'; ctx.lineWidth = 1.5 / viewScale; ctx.setLineDash([6 / viewScale, 5 / viewScale]);
        ctx.strokeRect(Math.min(selStart.x, selCur.x), Math.min(selStart.y, selCur.y), Math.abs(selCur.x - selStart.x), Math.abs(selCur.y - selStart.y));
        ctx.setLineDash([]);
      }
      ctx.restore();
      if (!sharing) { drawLaserFrame(); ctx.drawImage(laserCanvas, 0, 0, CW, CH); }
      publishCtx.drawImage(canvas, 0, 0, 1280, 720);
      rafId = requestAnimationFrame(drawFrame);
    }

    function currentTarget() {
      if (mode === 'whiteboard') return { kind: 'wb', page: wbPageIndex, canvas: currentWb() };
      if (mode === 'courseware' && currentInteraction === 'scroll' && activeAnnCanvas) return { kind: 'ann', page: activeAnnIndex, canvas: activeAnnCanvas };
      return { kind: 'ann', page: pageIndex, canvas: currentAnn() };
    }
    function pushSnapshotCanvas(c) {
      undoStack.push({ kind: 'ann', page: activeAnnIndex, data: c.toDataURL() });
      if (undoStack.length > 80) undoStack.shift();
      redoStack = [];
    }
    function pushSnapshot() {
      var tgt = currentTarget();
      undoStack.push({ kind: tgt.kind, page: tgt.page, data: tgt.canvas.toDataURL() });
      if (undoStack.length > 80) undoStack.shift();
      redoStack = [];
    }
    function applyData(canvas, data) {
      var img = new Image();
      img.onload = function() { var c = canvas.getContext('2d'); c.clearRect(0, 0, CW, CH); c.drawImage(img, 0, 0, CW, CH); };
      img.src = data;
    }
    function undo() {
      if (!undoStack.length) return;
      var tgt = currentTarget();
      redoStack.push({ kind: tgt.kind, page: tgt.page, data: tgt.canvas.toDataURL() });
      var snap = undoStack.pop();
      applyData(tgt.canvas, snap.data);
      setTimeout(saveStudioState, 200);
      setMsg('已撤销', 'ok');
    }
    function redo() {
      if (!redoStack.length) return;
      var tgt = currentTarget();
      undoStack.push({ kind: tgt.kind, page: tgt.page, data: tgt.canvas.toDataURL() });
      var snap = redoStack.pop();
      applyData(tgt.canvas, snap.data);
      setTimeout(saveStudioState, 200);
      setMsg('已重做', 'ok');
    }
    function scrollMax() {
      if (!scrollLayout || !scrollLayout.length) return 0;
      var total = 0;
      for (var i = 0; i < scrollLayout.length; i++) { if (scrollLayout[i]) total = scrollLayout[i].top + scrollLayout[i].height; }
      return Math.max(0, total - CH);
    }

    function drawShapeTo(c, sx, sy, ex, ey) {
      c.lineWidth = penSize; c.lineCap = 'round'; c.lineJoin = 'round'; c.strokeStyle = currentColor; c.setLineDash([]);
      if (currentTool === 'line') {
        c.beginPath(); c.moveTo(sx, sy); c.lineTo(ex, ey); c.stroke();
      } else if (currentTool === 'dash') {
        c.beginPath(); c.moveTo(sx, sy); c.lineTo(ex, ey); c.setLineDash([14, 10]); c.stroke(); c.setLineDash([]);
      } else if (currentTool === 'arrow') {
        c.beginPath(); c.moveTo(sx, sy); c.lineTo(ex, ey); c.stroke();
        var ang = Math.atan2(ey - sy, ex - sx);
        var len = 16;
        c.beginPath();
        c.moveTo(ex, ey);
        c.lineTo(ex - len * Math.cos(ang - 0.45), ey - len * Math.sin(ang - 0.45));
        c.moveTo(ex, ey);
        c.lineTo(ex - len * Math.cos(ang + 0.45), ey - len * Math.sin(ang + 0.45));
        c.stroke();
      } else if (currentTool === 'rect') {
        c.strokeRect(Math.min(sx, ex), Math.min(sy, ey), Math.abs(ex - sx), Math.abs(ey - sy));
      } else if (currentTool === 'ellipse') {
        c.beginPath();
        c.ellipse((sx + ex) / 2, (sy + ey) / 2, Math.abs(ex - sx) / 2, Math.abs(ey - sy) / 2, 0, 0, Math.PI * 2);
        c.stroke();
      } else if (currentTool === 'triangle') {
        var mx = (sx + ex) / 2, my = (sy + ey) / 2;
        var dx = ex - sx, dy = ey - sy;
        var px = mx - dy * 0.8, py = my + dx * 0.8;
        c.beginPath(); c.moveTo(sx, sy); c.lineTo(ex, ey); c.lineTo(px, py); c.closePath(); c.stroke();
      } else if (currentTool === 'compass') {
        var rad = Math.sqrt((ex - sx) * (ex - sx) + (ey - sy) * (ey - sy));
        c.beginPath(); c.arc(sx, sy, rad, 0, Math.PI * 2); c.stroke();
        c.beginPath(); c.moveTo(sx, sy); c.lineTo(ex, ey); c.stroke();
        c.beginPath(); c.arc(sx, sy, 3, 0, Math.PI * 2); c.fillStyle = currentColor; c.fill();
      } else if (currentTool === 'ruler') {
        var dxr = ex - sx, dyr = ey - sy;
        var dist = Math.sqrt(dxr * dxr + dyr * dyr) || 1;
        var nxr = -dyr / dist, nyr = dxr / dist;
        c.beginPath(); c.moveTo(sx, sy); c.lineTo(ex, ey); c.lineWidth = penSize + 6; c.stroke();
        c.lineWidth = 1; c.strokeStyle = 'rgba(255,255,255,.75)';
        var ticks = Math.floor(dist / 24);
        for (var ti = 1; ti <= ticks; ti++) {
          var pxr = sx + dxr * ti / ticks, pyr = sy + dyr * ti / ticks;
          var hl = (ti % 2 === 0) ? 12 : 8;
          c.beginPath(); c.moveTo(pxr - nxr * hl, pyr - nyr * hl); c.lineTo(pxr + nxr * hl, pyr + nyr * hl); c.stroke();
        }
      } else if (currentTool === 'protractor') {
        var rp = Math.sqrt((ex - sx) * (ex - sx) + (ey - sy) * (ey - sy));
        c.beginPath(); c.arc(sx, sy, rp, Math.PI, Math.PI * 2); c.stroke();
        c.beginPath(); c.moveTo(sx - rp, sy); c.lineTo(sx + rp, sy); c.stroke();
        c.lineWidth = 1;
        for (var deg = 0; deg <= 180; deg += 30) {
          var a = Math.PI * deg / 180;
          var inner = Math.max(2, rp - 8), outer = rp;
          c.beginPath(); c.moveTo(sx + Math.cos(a) * inner, sy - Math.sin(a) * inner); c.lineTo(sx + Math.cos(a) * outer, sy - Math.sin(a) * outer); c.stroke();
        }
      }
    }

    function isShapeTool() {
      return currentTool === 'line' || currentTool === 'arrow' || currentTool === 'dash' || currentTool === 'rect' || currentTool === 'ellipse' || currentTool === 'triangle' || currentTool === 'ruler' || currentTool === 'compass' || currentTool === 'protractor';
    }

    function localCssPoint(box, clientX, clientY) {
      var rect = box.getBoundingClientRect();
      return { x: (clientX - rect.left) * box.clientWidth / rect.width,
        y: (clientY - rect.top) * box.clientHeight / rect.height };
    }

    function updateToolCursor(e) {
      if (!toolCursor) return;
      var drawMode = !sharing && (mode === 'whiteboard' || mode === 'courseware');
      if (!drawMode || !e) { toolCursor.style.display = 'none'; return; }
      var box = document.getElementById('localPreview');
      var r = box.getBoundingClientRect();
      if (!r.width) return;
      if (viewTool === 'move' || viewTool === 'pan') {
        toolCursor.style.display = 'block';
        toolCursor.style.width = '22px';
        toolCursor.style.height = '22px';
        toolCursor.style.left = localCssPoint(box, e.clientX, e.clientY).x + 'px';
        toolCursor.style.top = localCssPoint(box, e.clientX, e.clientY).y + 'px';
        toolCursor.style.borderRadius = '0';
        toolCursor.style.border = '2px dashed rgba(255,255,255,.85)';
        toolCursor.style.background = 'transparent';
        toolCursor.style.boxShadow = 'none';
        return;
      }
      var size = currentTool === 'eraser' ? 40 : (currentTool === 'marker' ? Math.max(8, penSize * 2.2) : penSize);
      var d = Math.max(4, size * (box.clientWidth / CW));
      var isErase = currentTool === 'eraser';
      toolCursor.style.display = 'block';
      toolCursor.style.width = d + 'px';
      toolCursor.style.height = d + 'px';
      toolCursor.style.left = localCssPoint(box, e.clientX, e.clientY).x + 'px';
      toolCursor.style.top = localCssPoint(box, e.clientX, e.clientY).y + 'px';
      toolCursor.style.borderRadius = '50%';
      toolCursor.style.border = isErase ? '2px solid rgba(255,255,255,.85)' : '1.5px solid rgba(59,130,246,.9)';
      toolCursor.style.background = isErase ? 'rgba(255,255,255,.12)' : (currentTool === 'highlighter' ? 'rgba(234,179,8,.25)' : 'rgba(59,130,246,.18)');
      toolCursor.style.boxShadow = '0 0 0 1px rgba(0,0,0,.25)';
    }

    function restorePreviewBase(c) {
      if (!previewBase) return;
      var cc = c.canvas;
      if (mode === 'whiteboard') { c.clearRect(0, 0, cc.width, cc.height); c.fillStyle = '#ffffff'; c.fillRect(0, 0, cc.width, cc.height); }
      else { c.clearRect(0, 0, cc.width, cc.height); }
      c.drawImage(previewBase, 0, 0);
    }

    function scrollPageAt(y) {
      if (!scrollLayout) return null;
      for (var i = 0; i < scrollLayout.length; i++) {
        var p = scrollLayout[i];
        if (p && y >= p.top && y <= p.top + p.height) return { idx: i, h: p.height, top: p.top };
      }
      return null;
    }

    function startTextInput(e, preset) {
      try {
        if (existingTextInput) commitTextInput();
        var box = document.getElementById('localPreview');
        var r = { width: box.clientWidth, height: box.clientHeight };
        var x, y;
        if (preset) {
          x = Math.max(2, Math.min(r.width - 260, preset.x / CW * r.width));
          y = Math.max(2, Math.min(r.height - 120, preset.y / CH * r.height));
        } else if (e && typeof e.clientX === 'number') {
          x = Math.max(2, Math.min(r.width - 260, localCssPoint(box, e.clientX, e.clientY).x));
          y = Math.max(2, Math.min(r.height - 120, localCssPoint(box, e.clientX, e.clientY).y));
        } else {
          x = Math.max(2, Math.round(r.width * 0.5 - 120));
          y = Math.max(2, Math.round(r.height * 0.5 - 60));
        }
        var wrap = document.createElement('div');
        wrap.style.cssText = 'position:absolute;left:' + x + 'px;top:' + y + 'px;z-index:99999;cursor:move;user-select:none;';
        var inp = document.createElement('input');
        inp.type = 'text';
        inp.placeholder = '输入文字';
        if (preset) inp.value = preset.text || '';
        inp.style.cssText = 'width:240px;padding:6px 8px;background:#ffffff;color:#111827;border:2px dashed #2563eb;border-radius:6px;font-size:26px;outline:none;box-shadow:0 8px 24px rgba(0,0,0,.35);user-select:text;';
        wrap.appendChild(inp);

        var pendingColor = preset ? (preset.color || currentColor) : currentColor;
        var pendingSize = preset ? (preset.size || 48) : 48;
        var controls = document.createElement('div');
        controls.style.cssText = 'display:flex;align-items:center;gap:6px;margin-top:6px;padding:6px 8px;background:rgba(15,23,42,.94);border-radius:8px;box-shadow:0 6px 18px rgba(0,0,0,.3);';
        var colors = ['#111827','#e11d48','#f97316','#eab308','#16a34a','#2563eb','#7c3aed','#ffffff'];
        colors.forEach(function(c) {
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.title = c;
          dot.className = 'tx-color';
          dot.setAttribute('data-c', c);
          dot.style.cssText = 'width:18px;height:18px;border-radius:50%;border:2px solid rgba(255,255,255,.35);background:' + c + ';cursor:pointer;padding:0;';
          if (c === '#ffffff') dot.style.borderColor = '#94a3b8';
          if (c === pendingColor) { dot.style.borderColor = '#2563eb'; dot.style.boxShadow = '0 0 0 2px rgba(59,130,246,.45)'; }
          dot.addEventListener('click', function(ev) {
            ev.stopPropagation();
            pendingColor = c;
            controls.querySelectorAll('.tx-color').forEach(function(b2) { b2.style.borderColor = (b2.getAttribute('data-c') === '#ffffff') ? '#94a3b8' : 'rgba(255,255,255,.35)'; b2.style.boxShadow = 'none'; });
            dot.style.borderColor = '#2563eb';
            dot.style.boxShadow = '0 0 0 2px rgba(59,130,246,.45)';
          });
          controls.appendChild(dot);
        });
        var sizes = [['小', 32], ['中', 48], ['大', 64]];
        sizes.forEach(function(sz) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = sz[0];
          b.className = 'tx-size';
          b.style.cssText = 'padding:3px 8px;border:none;border-radius:6px;background:rgba(255,255,255,.12);color:#fff;font-size:12px;cursor:pointer;';
          if (sz[1] === pendingSize) b.style.background = '#2563eb';
          b.addEventListener('click', function(ev) {
            ev.stopPropagation();
            pendingSize = sz[1];
            controls.querySelectorAll('.tx-size').forEach(function(x2) { x2.style.background = 'rgba(255,255,255,.12)'; });
            b.style.background = '#2563eb';
            inp.style.fontSize = Math.round(pendingSize * (r.width / CW)) + 'px';
          });
          controls.appendChild(b);
        });
        var okBtn = document.createElement('button');
        okBtn.type = 'button';
        okBtn.textContent = '确定';
        okBtn.style.cssText = 'padding:3px 10px;border:none;border-radius:6px;background:#2563eb;color:#fff;font-size:12px;cursor:pointer;';
        okBtn.addEventListener('click', function(ev) { ev.stopPropagation(); commitTextInput(); });
        controls.appendChild(okBtn);
        wrap.appendChild(controls);

        box.appendChild(wrap);
        existingTextWrap = wrap;
        existingTextInput = inp;
        wrap._color = pendingColor;
        wrap._size = pendingSize;
        setMsg('输入框已创建：可直接输入，拖动移动，选择颜色和大小', 'ok');
        requestAnimationFrame(function(){ inp.focus(); });

        inp.addEventListener('keydown', function(ev) {
          if (ev.key === 'Enter') { ev.preventDefault(); commitTextInput(); }
          else if (ev.key === 'Escape') { ev.preventDefault(); cancelTextInput(); }
        });

        var dragState = null;
        wrap.addEventListener('pointerdown', function(ev) {
          ev.stopPropagation();
          var wr = wrap.getBoundingClientRect();
          var br = box.getBoundingClientRect();
          dragState = { dx: (ev.clientX - wr.left) * box.clientWidth / br.width, dy: (ev.clientY - wr.top) * box.clientHeight / br.height };
          try { wrap.setPointerCapture(ev.pointerId); } catch(e) {}
        });
        wrap.addEventListener('pointermove', function(ev) {
          if (!dragState) return;
          var br = box.getBoundingClientRect();
