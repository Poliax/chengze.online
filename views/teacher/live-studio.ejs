<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <style>
    * { scrollbar-width: thin; scrollbar-color: rgba(148,163,184,.32) transparent; }
    *::-webkit-scrollbar { width:8px; height:8px; }
    *::-webkit-scrollbar-track { background:transparent; }
    *::-webkit-scrollbar-thumb { background:rgba(148,163,184,.32); border-radius:8px; border:2px solid transparent; background-clip:padding-box; }
    *::-webkit-scrollbar-thumb:hover { background:rgba(148,163,184,.55); border:2px solid transparent; background-clip:padding-box; }
    *::-webkit-scrollbar-corner { background:transparent; }
    * { margin:0; padding:0; box-sizing:border-box; }
    html, body { height:100%; overflow:hidden; }
    body { background:#2B2F36; color:#fff; font-family:'Noto Serif SC', '宋体', 'SimSun', 'Songti SC', Georgia, 'Times New Roman', serif; font-size:15px; }
    .topbar { position:relative; display:flex; align-items:center; gap:10px; height:64px; padding:0 20px; background:#2B2F36; border-bottom:1px solid rgba(255,255,255,.28); flex-wrap:nowrap; overflow:hidden; white-space:nowrap; }
    .lesson-select { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:6px; color:#cbd5e1; font-size:12px; padding:5px 8px; outline:none; }
    .live-clock { color:#60a5fa; font-size:13px; font-weight:600; font-variant-numeric:tabular-nums; }
    .lesson-select option { background:#0f172a; color:#e2e8f0; }
    .topbar-right { margin-left:auto; display:flex; align-items:center; gap:8px; flex-wrap:nowrap; }
    .course { font-size:14px; font-weight:500; color:rgba(255,255,255,.72); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .topbar-left .brand { padding-right:12px; border-right:1px solid rgba(255,255,255,.16); }
    .topbar-left .brand .brand-tag { font-size:11px; font-weight:400; color:rgba(255,255,255,.55); letter-spacing:1px; margin-left:2px; }
    .status { font-size:13px; color:rgba(255,255,255,.55); }
    .back { color:rgba(255,255,255,.65); text-decoration:none; font-size:13px; padding:5px 8px; border-radius:6px; }
    .back:hover { background:rgba(255,255,255,.08); color:#fff; }
    .wrap { max-width:none; width:100%; margin:0; padding:6px 12px; display:flex; gap:12px; height:calc(100vh - 64px); align-items:stretch; }
    .main-col { flex:1; min-width:0; min-height:0; display:flex; flex-direction:column; overflow:hidden; position:relative; background:#2B2F36; border:0; border-radius:0; }
    .stage-main { flex:1; min-height:0; padding:0; display:flex; align-items:center; justify-content:center; }
    .stage { position:relative; width:100%; height:100%; flex:none; background:#fff; border:0; border-radius:10px; overflow:hidden; box-shadow:none; }
    /* The whole workspace supplies explicit dimensions for Safari. */
    .stage::before { display:none; }
    .pen-toolbar { position:absolute; left:8px; top:50%; transform:translateY(-50%); width:40px; height:calc(100% - 24px); max-height:500px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; padding:8px 3px; background:rgba(15,23,42,.5); border:1px solid rgba(255,255,255,.08); border-radius:12px; box-shadow:0 8px 22px rgba(0,0,0,.25); z-index:10; backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); opacity:.85; transition:opacity .2s ease, background .2s ease; pointer-events:none; }
    .stage:hover .pen-toolbar { opacity:1; background:rgba(15,23,42,.94); }
    .cat-wrap { position:relative; flex:none; display:flex; }
    .pen-tool { position:relative; width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center; border:1px solid transparent; border-radius:9px; background:transparent; color:#cbd5e1; cursor:pointer; transition:all .15s ease; pointer-events:auto; }
    .pen-tool svg { display:block; }
    .pen-tool:hover { background:rgba(255,255,255,.12); color:#fff; }
    .pen-tool.active, .pen-tool.open { background:rgba(37,99,235,.32); border-color:#2563eb; color:#fff; box-shadow:0 0 0 1px rgba(59,130,246,.35); }
    .pen-tool .ind { position:absolute; right:2px; bottom:2px; width:5px; height:5px; border-radius:50%; background:#fff; box-shadow:0 0 0 1px rgba(0,0,0,.5); }
    .sep { width:22px; height:1px; background:rgba(255,255,255,.16); margin:2px 0; flex:none; }
    .tool-pop { position:absolute; top:0; left:calc(100% + 10px); transform:none; z-index:30; display:none; flex-direction:column; gap:2px; min-width:128px; padding:6px; background:#0d1526; border:1px solid rgba(255,255,255,.14); border-radius:10px; box-shadow:0 14px 30px rgba(0,0,0,.5); pointer-events:auto; }
    .tool-pop.show { display:flex; }
    .tool-pop.colors { display:none; flex-direction:row; flex-wrap:wrap; gap:7px; width:150px; padding:10px; }
    .tool-pop.colors.show { display:flex; }
    .pop-item { display:flex; align-items:center; gap:9px; padding:7px 9px; border:none; border-radius:7px; background:transparent; color:#cbd5e1; font-size:12px; cursor:pointer; text-align:left; white-space:nowrap; }
    .pop-item:hover { background:rgba(255,255,255,.1); color:#fff; }
    .pop-item.active { background:rgba(37,99,235,.3); color:#fff; }
    .menu-item { display:flex; align-items:center; gap:9px; padding:7px 9px; border:none; border-radius:7px; background:transparent; color:#cbd5e1; font-size:12px; cursor:pointer; text-align:left; white-space:nowrap; width:100%; }
    .menu-item:hover { background:rgba(255,255,255,.1); color:#fff; }
    .menu-item.active { background:rgba(37,99,235,.3); color:#fff; }
    .menu-item:disabled { opacity:.4; cursor:not-allowed; }
    #popCwDocs { max-height:260px; overflow-y:auto; }
    .menu-row { display:flex; align-items:center; gap:4px; }
    .menu-row .menu-item { flex:1; }
    .doc-del { flex:none; width:28px; height:28px; border:none; border-radius:7px; background:transparent; color:#f87171; cursor:pointer; font-size:16px; line-height:1; }
    .doc-del:hover { background:rgba(248,113,113,.15); color:#fff; }
    .pen-color { width:18px; height:18px; border-radius:50%; border:2px solid rgba(255,255,255,.28); cursor:pointer; transition:transform .15s ease; }
    .pen-color:hover { transform:scale(1.15); }
    .pen-color.active { border-color:#fff; box-shadow:0 0 0 2px rgba(255,255,255,.35); }
    #localPreview { position:absolute; left:0; top:0; width:100%; height:100%; background:#fff; }
    #localPreview video { width:100%; height:100%; object-fit:contain; transform:none !important; -webkit-transform:none !important; }
    .right-col { width:200px; flex:0 0 200px; min-height:0; display:flex; flex-direction:column; gap:10px; }
    .camera-box { flex:0 0 auto; position:relative; background:#0a0f1a; border:1px solid rgba(255,255,255,.12); border-radius:10px; overflow:hidden; }
    .camera-box video { width:100%; aspect-ratio:16/9; object-fit:cover; display:block; background:#000; }
    .camera-box .cam-placeholder { position:absolute; top:0; left:0; right:0; aspect-ratio:16/9; display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,.42); font-size:12px; letter-spacing:1px; background:#0a0f1a; z-index:2; }
    .audio-meter { position:absolute; right:8px; bottom:8px; display:none; flex-direction:column; align-items:center; gap:4px; background:rgba(2,6,23,.6); border:1px solid rgba(255,255,255,.14); border-radius:6px; padding:5px 4px; z-index:3; }
    .audio-meter .meter-dot { width:7px; height:7px; border-radius:50%; background:rgba(255,255,255,.35); }
    .audio-meter .meter-track { width:4px; height:18px; border-radius:2px; background:rgba(255,255,255,.16); overflow:hidden; display:flex; align-items:flex-end; }
    .audio-meter .meter-bar { display:block; width:100%; height:4%; background:#22c55e; border-radius:2px; }
    .cam-video-wrap { position:relative; background:#000; }
    .dev-fields { display:flex; gap:8px; padding:8px 10px; border-top:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.03); }
    .dev-field { flex:1; min-width:0; display:flex; align-items:center; gap:5px; }
    .dev-field .dev-icon { flex:0 0 auto; display:inline-flex; color:rgba(255,255,255,.55); }
    .dev-field select { flex:1; min-width:0; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:6px; color:#cbd5e1; font-size:11px; padding:6px; outline:none; }
    .dev-field select:focus { border-color:#2563eb; }
    .dev-field select option { background:#0f172a; color:#e2e8f0; }
    .cam-ctrl { width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center; border:1px solid rgba(255,255,255,.15); border-radius:8px; background:rgba(255,255,255,.06); color:#cbd5e1; cursor:pointer; }
    .cam-ctrl:hover { background:rgba(255,255,255,.14); }
    .cam-ctrl.active { background:#2563eb; border-color:#2563eb; color:#fff; }
    .chat-col { flex:1; min-height:0; display:flex; flex-direction:column; background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.08); border-radius:10px; overflow:hidden; }
    .chat-tabs { display:flex; border-bottom:1px solid rgba(255,255,255,.08); background:rgba(255,255,255,.03); }
    .chat-tab { flex:1; padding:8px 0; background:transparent; border:none; color:rgba(255,255,255,.55); font-size:12px; font-weight:600; cursor:pointer; border-bottom:2px solid transparent; }
    .chat-tab:hover { color:rgba(255,255,255,.8); }
    .chat-tab.active { color:#fff; border-bottom-color:#2563eb; background:rgba(255,255,255,.05); }
    .chat-panel { flex:1; min-height:0; display:flex; flex-direction:column; }
    .online-hd { padding:8px 12px; font-size:12px; font-weight:600; color:rgba(255,255,255,.8); display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid rgba(255,255,255,.06); }
    .online-list { flex:1; overflow-y:auto; padding:6px 10px; font-size:12px; color:rgba(255,255,255,.6); }
    .online-row { display:flex; align-items:center; gap:8px; padding:6px 2px; border-bottom:1px solid rgba(255,255,255,.05); }
    .online-avatar { width:18px; height:18px; border-radius:50%; background:rgba(255,255,255,.12); color:rgba(255,255,255,.78); font-size:10px; font-weight:600; display:inline-flex; align-items:center; justify-content:center; flex:0 0 auto; }
    .online-row .online-name { flex:1; min-width:0; color:rgba(255,255,255,.9); font-size:11px; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .online-row .online-uid { font-family:"SF Mono",Menlo,Consolas,monospace; color:rgba(255,255,255,.42); font-size:9px; flex:0 0 auto; }
    .chat-msgs { flex:1; overflow-y:auto; padding:10px; }
    .chat-msg { margin-bottom:9px; font-size:11px; line-height:1.55; }
    .chat-msg .head { display:flex; align-items:baseline; gap:8px; margin-bottom:2px; }
    .chat-msg .who { color:#7aa2ff; font-weight:600; font-size:11px; }
    .chat-msg .time { color:rgba(255,255,255,.38); font-size:9px; }
    .chat-msg .txt { display:block; color:rgba(255,255,255,.92); line-height:1.5; word-break:break-word; font-size:11px; }
    .chat-input-row { display:flex; gap:6px; align-items:center; padding:8px 10px; border-top:1px solid rgba(255,255,255,.08); }
    .chat-input-row input { flex:1; min-width:0; height:26px; background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12); border-radius:14px; padding:0 12px; color:#fff; font-size:12px; outline:none; }
    .chat-input-row button { flex:0 0 auto; height:26px; padding:0 14px; border:none; border-radius:14px; background:#2563eb; color:#fff; font-size:12px; font-weight:600; cursor:pointer; }
    .chat-input-row.online-footer { height:43px; min-height:43px; }
    .btn { padding:7px 12px; border:none; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; height:32px; display:inline-flex; align-items:center; }
    .btn-mode { background:rgba(255,255,255,.08); color:#cbd5e1; border:1px solid rgba(255,255,255,.15); }
    .btn-mode:hover { background:rgba(255,255,255,.15); }
    .btn-mode.active { background:#2563eb; color:#fff; border-color:#2563eb; }
    .btn-main { background:rgba(37,99,235,.14); color:#93c5fd; border:1px solid rgba(96,165,250,.45); min-width:96px; justify-content:center; }
    .btn-main:hover { background:rgba(37,99,235,.28); color:#fff; }
    .btn-main.live { background:rgba(220,38,38,.14); color:#fca5a5; border-color:rgba(248,113,113,.45); }
    .btn-main.live:hover { background:rgba(220,38,38,.3); color:#fff; }
    .btn-upload { background:rgba(255,255,255,.08); color:#cbd5e1; border:1px solid rgba(255,255,255,.15); font-size:12px; }
    .btn-upload:hover { background:rgba(255,255,255,.15); }
    .btn-upload:disabled { opacity:.4; cursor:not-allowed; }
    .page-label { font-size:12px; color:rgba(255,255,255,.5); }
    .msgbar { flex:0 0 24px; display:flex; align-items:center; padding:0 12px; border-top:1px solid rgba(255,255,255,.05); background:#252b34; }
    @media (max-width:820px) { .right-col { width:180px; flex-basis:180px; } .wrap { gap:8px; padding-left:8px; padding-right:8px; } }
    .msg { font-size:12px; color:rgba(255,255,255,.8); line-height:1; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .msg.err { color:#f87171; }
    .err { color:#f87171; }
    .ok { color:#4ade80; }
    @media (max-width:820px) {
      .brand-tag,.course { display:none; }
      .topbar { padding:0 12px; gap:8px; }
      .topbar-left .brand { font-size:18px!important; padding-right:0; border-right:0; }
      .lesson-select { max-width:120px; }
      .chat-tab { font-size:11px; }
      .chat-input-row { gap:4px; padding:6px; }
      .chat-input-row input { width:0; min-width:0; }
    }

    /* Fixed proportions, shared scale: the camera stays visually modest. */
    .wrap { position:absolute; width:1172px; height:540px; padding:0!important; margin:0; gap:12px!important; transform-origin:top left; }
    .main-col { width:960px; height:540px; flex:0 0 960px; }
    .stage-main { width:960px; height:540px; padding:0; }
    .stage { width:960px; height:540px; }
    .right-col { width:200px!important; height:540px; flex:0 0 200px!important; gap:10px; }
    .cam-video-wrap,.camera-box video,.camera-box .cam-placeholder { height:112.5px; }
    .msgbar { position:absolute; height:24px; border-top:0; padding:0; background:transparent; }
    #localPreview canvas { object-fit:contain!important; }
  .chat-col{background:#30353b;border-color:#42484e}.chat-tabs{background:#2d3238;border-bottom-color:#42484e}.chat-tab{color:#929ca4}.chat-tab:hover{color:#dbe2df}.chat-tab.active{color:#dce7e1;background:#343d3a;border-bottom-color:#8fac9b}.chat-msg .who{color:#b0c7bb}.chat-msg .time{color:#7f8a91}.chat-msg .txt{color:#dce1e4}.chat-input-row{border-top-color:#42484e;background:#2e3339}.chat-input-row input{background:#393f45;border-color:#505960;color:#e3e9e6;border-radius:6px}.chat-input-row input::placeholder{color:#8d989f}.chat-input-row input:focus{border-color:#87a593}.chat-input-row button{background:#577563;color:#f1f5f2;border:1px solid #65836f;border-radius:6px}.chat-input-row button:hover{background:#65836f}.online-avatar{background:#445650;color:#dce6e2}
.chat-tab.active{color:#f0f1f2;background:#3a3e43;border-bottom-color:#a1a6ad}.chat-tab:hover{color:#e1e3e6}.chat-msg .who{color:#c3c7cd}.chat-msg .txt{color:#dce0e5}.chat-input-row input{color:#e5e7eb}.chat-input-row input:focus{border-color:#9ba2ab}.chat-input-row button{background:#555c65;border-color:#68717b;color:#f4f5f6}.chat-input-row button:hover{background:#626b76}.online-avatar{background:#4a5058;color:#dce0e5}
</style>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body>
  <div class="topbar">
    <div class="topbar-left" style="display:flex;align-items:center;gap:10px">
      <span class="brand"><img src="/public/images/brand-green/app-rounded.svg?v=20261019-backend-icon1" alt="承泽在线" width="36" height="36" style="width:36px;height:36px;border-radius:8px;display:block"></span>
      <span class="course"><%= course.title %></span>
    <select id="lessonSelect" class="lesson-select" title="选择本次课次">
      <option value="">选择本次课次</option>
      <% (lessons||[]).forEach(function(l){ %>
      <option value="<%= l.id %>"><%= l.title %></option>
      <% }); %>
    </select>
    </div>
    
    <div class="topbar-right">
            <input type="file" id="coursewareInput" accept="image/*,.pdf,.ppt,.pptx,.doc,.docx" multiple style="display:none">
      <span class="page-label" id="pageLabel" style="display:none"></span>
      <span class="live-clock" id="liveClock"></span>
      <button class="btn btn-main" id="mainBtn">开始上课</button>
    </div>
  </div>
  <div class="wrap">
    <div class="main-col">
      <div class="stage-main">
        <div class="stage">
          <div id="localPreview"></div>
          <span id="stagePageBadge" style="position:absolute;top:8px;right:10px;background:rgba(0,0,0,.55);color:#fff;font-size:12px;padding:3px 8px;border-radius:5px;display:none;z-index:5"></span>
          <div id="toolCursor" style="display:none;position:absolute;pointer-events:none;z-index:20;transform:translate(-50%,-50%);"></div>
        <div class="pen-toolbar">
          <div class="cat-wrap">
            <button class="pen-tool cat mode-tool" id="modeWb" data-pop="popWb" title="白板"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="11" rx="2"/><path d="M7 15l-2 5"/><path d="M17 15l2 5"/></svg></button>
            <div class="tool-pop" id="popWb">
              <button class="menu-item" data-action="new">新建页面</button>
              <button class="menu-item" data-action="prev" id="wbPrevItem">上一页</button>
              <button class="menu-item" data-action="next" id="wbNextItem">下一页</button>
            </div>
          </div>
          <div class="cat-wrap">
            <button class="pen-tool cat mode-tool" id="modeCw" data-pop="popCw" title="课件"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></button>
            <div class="tool-pop" id="popCw">
              <button class="menu-item" id="cwUploadItem">上传课件</button>
              <button class="menu-item" data-cw-action="prev" id="cwPrevItem">上一页</button>
              <button class="menu-item" data-cw-action="next" id="cwNextItem">下一页</button>
              <div id="popCwDocs"></div>
            </div>
          </div>
          <button class="pen-tool mode-tool" id="modeShare" title="屏幕共享"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M12 19v2"/><path d="M8 21h8"/><path d="M12 13V7"/><path d="M8.5 10.5L12 7l3.5 3.5"/></svg></button>
          <span class="sep"></span>

<div class="cat-wrap">
            <button class="pen-tool cat" id="catPen" data-pop="popPen" title="笔的类型"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><span class="ind" style="display:none"></span></button>
            <div class="tool-pop" id="popPen">
              <button class="pop-item active" data-set="tool" data-value="laser"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19l9-9"/><path d="M14 10l4-4"/><path d="M13 5l6 6-3 3-6-6 3-3z"/><circle cx="4" cy="20" r="1.5" fill="currentColor" stroke="none"/></svg>激光笔</button>
              <button class="pop-item" data-set="tool" data-value="ballpoint"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>圆珠笔</button>
                            <button class="pop-item" data-set="tool" data-value="eraser"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h8"/><path d="M17 8L9 16l-3-3 8-8 3 3z"/></svg>黑板擦</button>
              <button class="pop-item" data-set="tool" data-value="text"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="12" y1="4" x2="12" y2="20"/><line x1="9" y1="20" x2="15" y2="20"/></svg>文本</button>
              <button class="pop-item" data-set="tool" data-value="selecttext"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/></svg>选择</button>
            </div>
          </div>
          <div class="cat-wrap">
