    async function startScreenShare() {
      if (screenShareBusy) return;
      if (sharing) { stopScreenShare(); return; }
      if (!navigator.mediaDevices || typeof navigator.mediaDevices.getDisplayMedia !== 'function') {
        setMsg('当前浏览器不支持发起屏幕共享。请使用电脑端 Chrome、Edge 或 Safari；iPad 需使用原生 App。', 'err');
        return;
      }
      var captured = null, video = null;
      var generation = ++screenShareGeneration;
      screenShareBusy = true; updateShareControls();
      try {
        // This call stays directly on the user's click; do not await anything before it.
        captured = await navigator.mediaDevices.getDisplayMedia({
          video: { width: { ideal: 1920 }, height: { ideal: 1080 }, frameRate: { ideal: 30, max: 30 } },
          audio: false
        });
        if (generation !== screenShareGeneration) throw Object.assign(new Error('共享已取消'), { name: 'AbortError' });
        var track = captured.getVideoTracks()[0];
        if (!track || track.readyState === 'ended') throw new Error('所选屏幕已停止共享');
        try { track.contentHint = 'detail'; } catch(e) {}
        video = document.createElement('video');
        video.autoplay = true; video.muted = true; video.playsInline = true;
        video.setAttribute('playsinline','');
        video.style.cssText = 'position:absolute;left:0;top:0;width:100%;height:100%;object-fit:contain;background:#000;';
        video.srcObject = captured;
        var preview = document.getElementById('localPreview');
        preview.innerHTML = ''; preview.appendChild(video);
        await video.play();
        if (generation !== screenShareGeneration) throw Object.assign(new Error('共享已取消'), { name: 'AbortError' });
        if (track.readyState === 'ended') throw new Error('所选屏幕已停止共享');
        screenStream = captured; screenTrack = track; screenVideo = video; sharing = true;
        track.onended = function() { if (screenStream === captured) stopScreenShare(); };
        if (typeof closePops === 'function') closePops();
        showScreenPreview();
        setMsg(publishing ? '正在共享屏幕，学生端已同步；麦克风保持原状态' : '屏幕已就绪，点击“开始上课”后学生可观看', 'ok');
      } catch(e) {
        releaseScreenCapture(captured, video);
        initCanvasPreview(); drawFrame();
        var name = e && e.name || '', message = e && e.message || String(e);
        if (name === 'NotAllowedError' || name === 'AbortError' || /cancel/i.test(message)) {
          setMsg('未开始共享：你可能取消了选择，或未授予屏幕录制权限', '');
        } else setMsg('屏幕共享失败：' + message, 'err');
      } finally {
        screenShareBusy = false; updateShareControls();
      }
    }
