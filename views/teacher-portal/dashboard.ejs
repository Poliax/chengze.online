<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head><body>
<%- include('partials/sidebar') %>
<div class="main"><%- include('partials/header') %>
<div class="content">


<% if (!rows || rows.length === 0) { %>
<div class="empty-box">暂无分配课程，请联系管理员在课程管理中分配给你</div>
<% } %>

<% courseSections.forEach(section => { %>
<section class="course-term-section"><h2 class="course-term-title"><%= section.title %></h2>
<% if(!section.groups.length){ %><div class="term-empty">暂无<%= section.title %></div><% } %>
<% section.groups.forEach(g => { %>

<div class="course-group-list">
<% (g.courses||[]).forEach(r => { %>
<div class="lesson-card" style="--course-hue:<%= Math.round(Number(r.course.id)*137.508)%360 %>" id="card-<%= r.course.id %>">
<div class="lesson-card-hd" data-course-toggle="<%= r.course.id %>">
<div>
<div class="lesson-card-title"><%= r.course.title %></div>
<div class="lesson-card-meta"><%= r.course.year||'--' %>年 · <%= r.course.province||'--' %> · <%= r.course.class_type||'--' %> · <%= r.lessons.length %>次课</div>
</div>
<span class="arrow">&#9660;</span>
</div>
<div class="lesson-body">
<table class="lesson-table">
<thead><tr><th>序号</th><th>年份/省份/考试</th><th>科目</th><th>阶段</th><th>课次</th><th>课程名称</th><th>上课时间</th><th>状态</th><th>直播入口</th></tr></thead>
<tbody>
<% (r.lessons||[]).forEach((l, i) => { %>
<tr>
<td><%= i + 1 %></td>
<td><%= r.course.year||'--' %> / <%= r.course.province||'--' %> / <%= r.course.exam_type||'专升本' %></td>
<td><%= r.course.category||'-' %></td>
<% const lessonTitle=String(l.title||'');const titleParts=lessonTitle.match(/^(.*?)[\s·—–-]*(第[0-9０-９一二三四五六七八九十百零两]+[讲节课次])\s*$/);const stageLabel=(titleParts&&titleParts[1].trim())||l.stage||'—';const lessonLabel=titleParts?titleParts[2]:lessonTitle||'—'; %>
<td><%= stageLabel %></td><td><%= lessonLabel %></td>
<td class="lesson-topic-cell"><form data-lesson-topic="<%= l.id %>"><input type="text" name="content" maxlength="2000" aria-label="<%= l.title %>的课程名称" value="<%= l.description || '' %>"><div class="topic-actions"><span class="topic-status" role="status" aria-live="polite"></span></div></form></td>
<td><%= l.schedule_time || '待排课' %></td>
<%
var st = l.schedule_time || '';
var stText = '未排课';
var stCls = 'badge-none';
if (l.has_live_session) { stText = '授课中'; stCls = 'badge-live'; }
else if (l.has_taught_session) { stText = '已授课'; stCls = 'badge-done'; }
else if (st) {
  var scheduledAt = new Date(st.replace(' ', 'T') + (/Z$|[+-]\d{2}:?\d{2}$/.test(st) ? '' : '+08:00'));
  if (!isNaN(scheduledAt.getTime()) && scheduledAt < new Date()) { stText = '待补课'; stCls = 'badge-makeup'; }
  else { stText = '待上课'; stCls = 'badge-wait'; }
}
%>
<td><span class="badge <%= stCls %>"><%= stText %></span></td>
<td><a class="lesson-live-entry" href="/teach/live/<%= r.course.id %>?lesson=<%= l.id %>" target="_blank" rel="noopener">进入直播间</a></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
<% }) %>
</div>
<% }) %>
</section>
<% }) %>
</div></div>


<script src="/js/teacher-navigation.js?v=20261019-nav24" defer></script></body></html>
