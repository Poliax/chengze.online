.course-group-list{background:#fff;border-color:#e0e2e5}.main .course-group-list .lesson-card{background:#f5f5f6;border-bottom-color:#e0e2e5}.course-group-list .lesson-card-hd:hover,.course-group-list .lesson-card.open .lesson-card-hd{background:#eeeff1}.group-name{color:#303943}.course-group-list .arrow{color:#91979e}.main .course-group-list .lesson-table thead th{background:#f2f3f4;color:#697078;border-color:#e0e2e5;box-shadow:0 1px 0 #e0e2e5}.course-group-list .lesson-table td{color:#454b52;border-color:#eceef0}
.course-term-section{margin-bottom:30px}.course-term-title{font-size:17px;font-weight:600;color:#303943;margin:0 0 14px}.course-term-section .group-hd{margin-top:12px}.term-empty{padding:22px 20px;border:1px solid #e3e5e8;border-radius:8px;background:#fff;color:#92989f;font-size:13px}
