<style id="teacherViewStyles">
html { overflow-y: scroll; }
.lesson-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); margin-bottom:16px; overflow:hidden; }
.lesson-card-hd { display:flex; align-items:center; gap:12px; padding:14px 18px; border-bottom:1px solid var(--border-light); }
