.btn-teach:hover { background:var(--primary-hover); }
.lesson-table { width:100%; border-collapse:collapse; }
.lesson-table th { background:#f8fafc; font-size:12px; color:var(--muted); text-align:left; padding:9px 18px; border-bottom:1px solid var(--border-light); font-weight:600; }
.lesson-table td { font-size:13px; padding:10px 18px; border-bottom:1px solid var(--border-light); color:#334155; }
.lesson-table tr:last-child td { border-bottom:none; }
.lesson-table { border-collapse:separate; border-spacing:0; table-layout:fixed; }
.lesson-table th, .lesson-table td { height:38px; padding:0 14px; box-sizing:border-box; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.lesson-table th:nth-child(1){width:64px}
.lesson-table th:nth-child(2){width:26%}
.lesson-table th:nth-child(3){width:15%}
.lesson-table th:nth-child(5){width:18%}
.lesson-table th:nth-child(6){width:88px}
.lesson-table thead th { position:sticky; top:0; z-index:2; background:#f8fafc; box-shadow:0 1px 0 rgba(148,163,184,.35); }
.empty-box { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:40px; text-align:center; color:var(--light); font-size:14px; }
.group-hd { display:flex; align-items:center; gap:10px; margin:18px 0 10px; }
.lesson-card-hd { cursor:pointer; user-select:none; }
.lesson-body { display:none; max-height:418px; overflow-y:auto; }
.lesson-body::-webkit-scrollbar { width:6px; }
