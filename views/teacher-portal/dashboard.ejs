.course-group-list .lesson-table{min-width:1080px}.course-group-list .lesson-table th:nth-child(1){width:50px}.course-group-list .lesson-table th:nth-child(2){width:140px}.course-group-list .lesson-table th:nth-child(3){width:65px}.course-group-list .lesson-table th:nth-child(4){width:170px}.course-group-list .lesson-table th:nth-child(5){width:240px}.course-group-list .lesson-table th:nth-child(6){width:145px}.course-group-list .lesson-table th:nth-child(7){width:90px}.course-group-list .lesson-table th:nth-child(8){width:110px}.course-group-list .lesson-table td{height:auto;padding-top:10px;padding-bottom:10px;vertical-align:middle}.lesson-topic-cell form{white-space:normal}.lesson-topic-cell textarea{display:block;width:100%;min-height:46px;resize:vertical;border:1px solid #dde1e5;border-radius:5px;padding:7px 8px;background:#fafafa;color:#454b52;font:inherit;font-size:12px;line-height:1.5}.lesson-topic-cell textarea:focus{outline:1px solid #a0abb6;background:#fff}.topic-actions{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-top:5px}.topic-status{font-size:10px;color:#8a929b;white-space:normal}.topic-actions button,.lesson-live-entry{display:inline-block;border:1px solid #dce0e4;border-radius:4px;background:#f7f8f9;color:#535d66;padding:4px 8px;font:inherit;font-size:11px;cursor:pointer;text-decoration:none}.topic-actions button:disabled{opacity:.5;cursor:default}.lesson-live-entry:hover,.topic-actions button:hover{background:#eceef0}
