.course-group-list .lesson-table th:nth-child(4){width:78px}.course-group-list .lesson-table th:nth-child(5){width:65px}.course-group-list .lesson-table th:nth-child(4),.course-group-list .lesson-table td:nth-child(4){padding-right:4px}.course-group-list .lesson-table th:nth-child(5),.course-group-list .lesson-table td:nth-child(5){padding-left:4px}
