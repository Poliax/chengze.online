<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/teach.css?v=6">
  <style>
    .lesson-card { background:#fff; border:1px solid #e2e8f0; border-radius:10px; margin-bottom:16px; overflow:hidden; }
    .lesson-card-hd { display:flex; align-items:center; gap:12px; padding:14px 18px; border-bottom:1px solid #eef2f7; }
    .lesson-card-title { font-size:15px; font-weight:700; color:#0f172a; }
    .lesson-card-meta { font-size:12px; color:#64748b; margin-top:3px; }
    .btn-teach { margin-left:auto; padding:8px 16px; background:#2563eb; color:#fff; border-radius:7px; text-decoration:none; font-size:13px; font-weight:600; white-space:nowrap; }
    .btn-teach:hover { background:#1d4ed8; }
    .lesson-table { width:100%; border-collapse:collapse; }
    .lesson-table th { background:#f8fafc; font-size:12px; color:#64748b; text-align:left; padding:9px 18px; border-bottom:1px solid #eef2f7; font-weight:600; }
    .lesson-table td { font-size:13px; padding:10px 18px; border-bottom:1px solid #f1f5f9; color:#334155; }
    .lesson-table tr:last-child td { border-bottom:none; }
    .empty-box { background:#fff; border:1px solid #e2e8f0; border-radius:10px; padding:40px; text-align:center; color:#94a3b8; font-size:14px; }
  </style>
<link rel="apple-touch-icon" href="/public/images/brand-green/app-rounded.png?v=20261017-brand1"><link rel="icon" type="image/svg+xml" href="/public/images/brand-green/app-rounded.svg?v=20261017-brand1"></head>
<body class="teacher-body">
  <aside class="teacher-sidebar" id="sidebar">
    <div class="sidebar-logo">
      <a href="/teach" class="logo-link" style="display:inline-flex;align-items:center;gap:10px;color:#fff;text-decoration:none;font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:22px;font-weight:400;line-height:1;letter-spacing:.5px;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale"><img class="chengze-wordmark" src="/public/images/brand-green/online-light.svg?v=20261017-brand1" alt="承泽在线" style="width:144px;max-width:100%;height:auto;display:block;flex:none"></a>
    </div>
    <nav class="sidebar-nav">
      <a href="/teach" class="sidebar-link active">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        我的课表
      </a>
    </nav>
    <div class="sidebar-footer">
      <a href="/teach/logout" class="sidebar-link sidebar-logout">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        退出登录
      </a>
      <a href="/" class="sidebar-link sidebar-site" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        查看官网
      </a>
    </div>
  </aside>
  <div class="teacher-main">
    <header class="teacher-topbar">
      <div class="topbar-left">
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="菜单"><span></span><span></span><span></span></button>
      </div>
      <div class="topbar-right">
        <div class="teacher-info">
          <div class="teacher-avatar"><%= teacherName ? teacherName[0] : '师' %></div>
          <span><%= teacherName %></span>
        </div>
      </div>
    </header>
    <div class="teacher-content">
      <div class="page-header">
        <h2>我的课表</h2>
      </div>
      <% if (!rows || rows.length === 0) { %>
        <div class="empty-box">暂无分配课程，请联系管理员在课程管理中分配给你</div>
      <% } %>
      <% (rows||[]).forEach(r => { %>
      <div class="lesson-card">
        <div class="lesson-card-hd">
          <div>
            <div class="lesson-card-title"><%= r.course.title %></div>
            <div class="lesson-card-meta"><%= r.course.year||'--' %>年 · <%= r.course.province||'--' %> · <%= r.course.class_type||'--' %> · <%= r.lessons.length %>次课</div>
          </div>
          <a class="btn-teach" href="/teach/live/studio/<%= r.course.id %>">进入直播台</a>
        </div>
        <table class="lesson-table">
          <thead><tr><th style="width:70px">序号</th><th>课次</th><th>上课时间</th><th>时长</th></tr></thead>
          <tbody>
            <% (r.lessons||[]).forEach((l, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= l.title %></td>
              <td><%= l.schedule_time || '待排课' %></td>
              <td><%= Math.floor((l.duration||0)/60) %>分钟</td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% }) %>
    </div>
  </div>
  <script>
    document.getElementById('sidebarToggle').addEventListener('click', function() {
      document.getElementById('sidebar').classList.toggle('open');
    });
  </script>
</body>
</html>
