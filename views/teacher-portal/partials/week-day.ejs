<div data-week-start="<%= day.date===today.date ? 'true' : 'false' %>" class="week-day <%= day.lessons.length ? 'has-lessons' : 'is-empty' %>"><div class="week-date"><%= day.date.slice(5).replace('-','月') %>日<small><%= day.weekday %></small></div><div><% if(!day.lessons.length){ %><div class="home-empty">暂无排课</div><% } %><% day.lessons.forEach(l=>{ %><div class="home-lesson" style="--course-hue:<%= Math.round(Number(l.course_id)*137.508)%360 %>"><time class="home-time"><%= l.schedule_time.slice(11,16) %></time><div class="home-info"><strong class="home-course-title"><%= l.course_title %></strong><small class="home-stage"><%= l.title %></small><span class="home-status <%= l.is_live?'status-live':l.is_taught?'status-taught':day.date<today.date?'status-makeup':'status-upcoming' %>"><%= l.is_live?'授课中':l.is_taught?'已授课':day.date<today.date?'待补课':'待上课' %></span></div><%- include('lesson-actions',{lesson:l,courseId:l.course_id}) %></div><% }) %></div></div>