<div data-week-start="<%= day.date===today.date ? 'true' : 'false' %>" class="week-day <%= day.lessons.length ? 'has-lessons' : 'is-empty' %>"><div class="week-date"><%= day.date.slice(5).replace('-','月') %>日<small><%= day.weekday %></small></div><div><% if(!day.lessons.length){ %><div class="home-empty">暂无排课</div><% } %><% day.lessons.forEach(l=>{ %><div class="home-lesson" style="--course-hue:<%= Math.round(Number(l.course_id)*137.508)%360 %>"><time class="home-time"><%= l.schedule_time.slice(11,16) %></time><div class="home-info"><small><%= l.course_title %></small><strong><%= l.title %></strong><span class="home-status <%= l.is_live?'status-live':l.is_taught?'status-taught':day.date<today.date?'status-makeup':'status-upcoming' %>"><%= l.is_live?'授课中':l.is_taught?'已授课':day.date<today.date?'待补课':'待上课' %></span></div><a class="home-enter" href="/teach/live/<%= l.course_id %>?lesson=<%= l.id %>" target="_blank" rel="noopener">进入直播间</a></div><% }) %></div></div>