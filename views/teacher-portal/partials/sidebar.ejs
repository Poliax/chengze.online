<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo" style="justify-content:flex-start"><a href="/teach" class="logo-link"><img class="backend-app-icon" src="/public/images/brand-green/app-rounded.svg?v=20261019-backend-icon1" alt="承泽在线" width="42" height="42" style="width:42px;height:42px;display:block;flex:none;border-radius:9px"><span style="font-size:16px;font-weight:600;letter-spacing:1px;color:#B9CCC5;white-space:nowrap">教师端</span></a></div>
  <nav class="sidebar-nav">
    <a href="/teach" class="sidebar-link <%= (path === '/teach' || path === '/teach/') ? 'active' : '' %>"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 10l9-7 9 7v10H3zM9 20v-7h6v7"/></svg>首页</a>
    <a href="/teach/courses" class="sidebar-link <%= path.startsWith('/teach/courses') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      课程目录
    </a>
    <a href="/teach/calendar" class="sidebar-link <%= path.startsWith('/teach/calendar') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      课程日历
    </a>
  </nav>
  <div class="sidebar-footer">
    <div class="teacher-account-menu">
      <div class="teacher-account-popover" id="teacherAccountMenu" hidden>
        <a href="/teach/profile"><span aria-hidden="true">⚙</span>个人信息</a>
        <a href="/teach/logout" data-confirm-logout><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>退出登录</a>
      </div>
      <button type="button" class="teacher-account-trigger" aria-expanded="false" aria-controls="teacherAccountMenu">
        <span class="teacher-sidebar-avatar"><%= teacherName ? teacherName[0] : '师' %></span>
        <span class="teacher-account-name"><%= teacherName || '教师' %></span>
        <span class="teacher-account-dots" aria-hidden="true">···</span>
      </button>
    </div>
  </div>
</aside>
