</style></head><body><%- include('partials/sidebar') %><div class="main"><%- include('partials/header') %><div class="content">
<section class="home-section"><div class="home-heading"><h2>今日课程</h2></div><div class="home-panel">
<% if(!today.lessons.length){ %><div class="home-empty">今天暂无排课，可在下方查看近期课程。</div><% } %>
<% today.lessons.forEach(l=>{ %><div class="home-lesson" style="--course-hue:<%= Math.round(Number(l.course_id)*137.508)%360 %>"><time class="home-time"><%= l.schedule_time.slice(11,16) %></time><div class="home-info"><strong><%= l.title %><% if(l.is_live){ %><span class="home-status status-live">授课中</span><% }else if(l.is_taught){ %><span class="home-status status-taught">已授课</span><% } %></strong><small><%= l.course_title %></small></div><a class="home-enter" href="/teach/live/<%= l.course_id %>?lesson=<%= l.id %>" target="_blank" rel="noopener">进入直播间</a></div><% }) %>
</div></section>
<section class="home-section"><div class="home-heading"><h2>近期课程</h2><div class="week-actions"><button type="button" data-week-step="-1" aria-label="上一周">‹</button><button type="button" data-week-today>今天</button><button type="button" data-week-step="1" aria-label="下一周">›</button></div></div><div class="home-panel week-scroll" tabindex="0" role="region" aria-label="近期课表，左右滑动查看">
<% const todayIndex=days.findIndex(d=>d.date===today.date);const windowStart=Math.max(0,todayIndex-3);const windowEnd=Math.min(days.length,windowStart+7); %>
<% days.slice(windowStart,windowEnd).forEach(day=>{ %><%- include('partials/week-day',{day,today}) %><% }) %>
</div>
<template id="weekBefore"><% days.slice(0,windowStart).forEach(day=>{ %><%- include('partials/week-day',{day,today}) %><% }) %></template>
<template id="weekAfter"><% days.slice(windowEnd).forEach(day=>{ %><%- include('partials/week-day',{day,today}) %><% }) %></template>
</section></div></div><script src="/js/teacher-navigation.js?v=20261019-nav24" defer></script></body></html>
