.week-scroll .week-date,.week-scroll .week-day.is-empty .week-date{padding:12px 10px;gap:4px}.week-scroll .week-day>div:last-child{padding:6px}.week-scroll .home-lesson{padding:10px 4px}.week-scroll .home-info strong{overflow-wrap:anywhere}.week-scroll .home-status{display:block;margin:6px 0 0;font-size:10px}.week-actions{display:flex;gap:5px;margin-left:auto}.week-actions button{background:var(--surface);border:1px solid var(--border);border-radius:5px;padding:4px 9px;color:#617368;font:inherit;font-size:12px;cursor:pointer}.week-actions button:hover{background:#edf1ee}
@media(max-width:900px){.week-scroll .week-day,.week-scroll .week-day.is-empty{flex-basis:calc(100% / 3);width:calc(100% / 3)}}
