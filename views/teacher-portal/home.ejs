.week-scroll .week-day{background:#f3f5f4}.week-scroll .week-day[data-week-start="true"]{background:#edf3ee}.week-scroll .home-lesson,.week-scroll .home-lesson:last-child{background:#fff;border:1px solid #dce3de;box-shadow:0 2px 5px rgba(35,53,42,.06);border-radius:7px;margin-bottom:10px}.week-scroll .home-lesson:last-child{margin-bottom:0}.week-scroll .home-lesson:hover{border-color:#b8cbbf;box-shadow:0 3px 9px rgba(35,53,42,.09)}
.week-scroll .week-day{background:#fff}.week-scroll .week-day[data-week-start="true"]{background:#f5f8f5}.week-scroll .home-lesson,.week-scroll .home-lesson:last-child{background:#f3f5f4}

.week-scroll .week-day{background:#fff}.week-scroll .week-date,.week-scroll .week-day.is-empty .week-date{background:#f5f5f6;color:#62676d}.week-scroll .week-date small{color:#454b52}.week-scroll .home-lesson,.week-scroll .home-lesson:last-child{background:#f5f5f6;border-color:#e0e2e5;box-shadow:0 2px 5px rgba(30,35,40,.04)}.week-scroll .home-lesson:hover{border-color:#c6cbd0;box-shadow:0 3px 8px rgba(30,35,40,.06)}.week-scroll .home-time,.home-time{color:#555f68}.week-scroll .home-info small{color:#92969b}.week-scroll .home-enter,.home-enter{background:#fafafa;color:#535d66;border-color:#dce0e4}.week-scroll .home-enter:hover,.home-enter:hover{background:#eceef0;border-color:#c7cdd2;color:#303943}.week-scroll .week-day[data-week-start="true"]{background:#f5f7f5}.week-actions button{color:#626971;border-color:#e0e2e5}.week-actions button:hover{background:#eceef0}
