/* Vertical agenda with compact empty days. */
.week-day{display:block;padding:14px 20px;border-bottom:1px solid var(--border-light)}
.week-date{display:flex;align-items:center;gap:10px;padding:0 0 8px;background:transparent;font-weight:500;color:#59655e}
