.week-scroll{max-height:440px;max-height:min(440px,60vh);overflow-y:auto;overscroll-behavior-y:auto;scrollbar-width:thin;scrollbar-color:#c7ceca transparent}.week-scroll::-webkit-scrollbar{width:6px}.week-scroll::-webkit-scrollbar-thumb{background:#c7ceca;border-radius:4px}.week-scroll:focus-visible{outline:2px solid #a5b9af;outline-offset:2px}
/* Horizontal week agenda: one column per day. */
