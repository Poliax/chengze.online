.week-scroll [data-week-start="true"] .week-date{background:#edf2ee}.week-scroll [data-week-start="true"] .week-date small{color:#426452}
.week-scroll [data-week-start="true"] .week-date{background:#dfeae3;box-shadow:inset 0 3px 0 #638573;color:#355342}.week-scroll [data-week-start="true"] .week-date small{color:#355342}
.week-scroll [data-week-start="true"]{background:#f0f5f1}.week-scroll [data-week-start="true"] .week-date{background:#445f52;color:#f4f7f5;box-shadow:none}.week-scroll [data-week-start="true"] .week-date small{color:#fff}
.week-scroll .week-day[data-week-start="true"] .week-date,.week-scroll .week-day.is-empty[data-week-start="true"] .week-date{background:#445f52;color:#f4f7f5;box-shadow:none}.week-scroll .week-day[data-week-start="true"] .week-date small{color:#fff}
.home-info .home-status,.week-scroll .home-info .home-status{display:inline-block;margin:8px 0 0;padding:3px 8px;border-radius:4px;font-size:11px;font-weight:600;line-height:1.5;border:1px solid transparent}.home-info .status-taught{background:#e4f1e8;color:#2f6d45;border-color:#cce2d3}.home-info .status-makeup{background:#fff0d5;color:#925b12;border-color:#eed3a3}.home-info .status-upcoming{background:#eaf0f5;color:#50657c;border-color:#d5dfe9}.home-info .status-live{background:#426453;color:#fff;border-color:#426453}
.week-scroll{cursor:grab;touch-action:pan-x pan-y pinch-zoom;-webkit-overflow-scrolling:touch;scroll-snap-type:none}.week-scroll.is-dragging{cursor:grabbing;user-select:none}.week-scroll.is-dragging *{cursor:grabbing!important;user-select:none}.week-scroll a{cursor:pointer}
.week-scroll{overscroll-behavior-y:auto;touch-action:pan-x pan-y pinch-zoom}
/* Compact course agenda: time/status, title, course, action. */
.week-scroll .week-day>div:last-child{padding:8px}
.week-scroll .home-lesson{position:relative;display:flex;flex-direction:column;align-items:stretch;gap:0;padding:12px 10px;margin-bottom:8px;background:#fefefd;border:1px solid #e8ece8;border-radius:6px}
.week-scroll .home-lesson:last-child{border-bottom:1px solid #e8ece8;margin-bottom:0}
.week-scroll .home-time{width:auto;padding-right:56px;font-size:14px;line-height:22px;font-weight:600;color:#52776b}
.week-scroll .home-info{width:100%;flex:none;margin-top:10px}
.week-scroll .home-info strong{font-size:13px;line-height:1.6;color:#303943;font-weight:600}
