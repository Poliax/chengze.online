.week-scroll .home-enter:hover{background:#e7eee8;border-color:#bdcfc2;color:#355844}
.week-scroll .week-day .week-date,.week-scroll .week-day.is-empty .week-date{align-items:center;text-align:center;justify-content:center}
.week-scroll .week-day.is-empty>div:last-child{flex:1;display:flex;align-items:center;justify-content:center}.week-scroll .week-day.is-empty .home-empty{width:100%;text-align:center}
