.week-scroll .home-time{width:100%;font-size:15px}.week-scroll .home-info{flex-basis:100%}.week-scroll .home-info strong{font-size:13px}.week-scroll .home-info small{font-size:11px;line-height:1.6}.week-scroll .home-enter{margin-top:4px;font-size:11px}.week-scroll .home-empty{padding:15px 6px}
.week-scroll::-webkit-scrollbar{height:6px;width:6px}
.week-scroll .week-day,.week-scroll .week-day.is-empty{align-items:stretch}
