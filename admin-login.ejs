<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>承泽教育 - 管理后台</title>
<link rel="shortcut icon" type="image/x-icon" href="/favicon-v18.ico?v=20260905"><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-v18.png?v=20260905"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v18.png?v=20260905"><link rel="icon" type="image/png" sizes="192x192" href="/favicon-192-v18.png?v=20260905"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v18.png?v=20260905"><link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-v18.png"><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v18.png"><link rel="icon" type="image/png" sizes="192x192" href="/favicon-192-v18.png"><link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v18.png">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Noto Sans SC', system-ui, sans-serif;
      background: #f7f7f7;
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh;
    }
    .login-box {
      background: #fff; padding: 40px; border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.06);
      width: 340px; text-align: center;
    }
    .login-logo { margin-bottom: 16px; }
    .login-logo .logo-mark { display: block; margin: 0 auto 12px; }
    h1 { font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 22px; font-weight: 400; line-height: 1; letter-spacing: .5px; margin-bottom: 8px; color: #1E1E1E; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
    p { font-size: 13px; color: #6b7280; margin-bottom: 24px; }
    input {
      width: 100%; padding: 12px 16px;
      border: 1px solid #d1d5db; border-radius: 6px;
      font-size: 14px; font-family: inherit;
      outline: none; margin-bottom: 16px;
    }
    input:focus { border-color: #A51C30; box-shadow: 0 0 0 3px rgba(165,28,48,.12); }
    button {
      width: 100%; padding: 12px; border: none; border-radius: 6px;
      background: #FFFFFF; color: #1E1E1E; border: 1px solid #E5E7EB; font-size: 14px; font-weight: 600;
      cursor: pointer; font-family: inherit;
    }
    button:hover { background: #F7F7F7; }
    .error { color: #dc2626; font-size: 13px; margin-bottom: 12px; }
  </style>
</head>
<body>
  <div class="login-box">
    <div class="login-logo"><svg class="logo-mark" width="28" height="28" viewBox="0 0 64 64"><rect width="64" height="64" rx="16" fill="#881538"/><path d="M32 16 47 22 32 28 17 22Z" fill="#C8A96A"/><path d="M22 28v8c0 3.3 4.7 6 10 6s10-2.7 10-6v-8l-10 5Z" fill="#C8A96A" opacity=".9"/><path d="M47 22v9" stroke="#C8A96A" stroke-width="2" stroke-linecap="round"/><circle cx="47" cy="33" r="2.2" fill="#C8A96A"/></svg></div>
    <h1>承泽教育</h1>
    <p>日程管理后台</p>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method="post" action="/admin/login">
      <input type="password" name="password" placeholder="管理员密码" required>
      <button type="submit">登录</button>
    </form>
  </div>
</body>
</html>
